@*
    //_AddBatchModal
*@

<div class="modal fade" id="addBatchModal" aria-hidden="true" aria-labelledby="exampleModalToggleLabel" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <!-- Modal Header -->
            <div class="modal-header bgcol-215ED6 text-white justify-content-between font-size-18px">
                <h5 class="fw-semibold modal-title" id="exampleModalToggleLabel">
                    Add Batch
                </h5>
                <button type="button" class="bg-transparent border-0" data-bs-dismiss="modal" aria-label="Close">
                    <img src="~/icons/closeicon.svg" />
                </button>
            </div>

            <!-- Modal Body -->
            <div class="modal-body px-4 pt-4 pb-3">

                <!-- Batch Code -->
                <div class="mb-3">
                    <label class="form-label font-size-14">Batch Code</label>
                    <input type="text" class="form-control bord-D2D2D2" id="batchCode">
                </div>

                <!-- Batch Quantity -->
                <div class="mb-3">
                    <label class="form-label font-size-14">Batch Quantity</label>
                    <input type="number" class="form-control bord-D2D2D2" id="batchQty" placeholder="Enter Batch Quantity">
                </div>

                <!-- Tablet Quantity -->
                <div class="mb-3">
                    <label class="form-label font-size-14">Tablet Quantity</label>
                    <select class="form-select bord-D2D2D2" id="tabletQty">
                        <option value="">Select Quantity</option>
                        <option value="100">100</option>
                        <option value="250">250</option>
                        <option value="500">500</option>
                    </select>
                </div>

            </div>

            <!-- Modal Footer -->
            <div class="modal-footer justify-content-end border-top-0 p-3 pt-0 gap-2">
                <button type="button"
                        class="btn col-215ED6 bord-215ED6 fw-semibold font-size-16px px-4"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button type="button"
                        class="btn bgcol-215ED6 text-white fw-semibold font-size-16px px-4"
                        onclick="saveBatch()">
                    Save
                </button>
            </div>

        </div>
    </div>
</div>