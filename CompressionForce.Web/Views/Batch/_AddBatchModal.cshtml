<div class="modal fade" id="addBatchModal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5>Add Batch</h5>
            </div>

            <div class="modal-body">
                <select id="addRecipeCode"></select>
                <input id="addBatchCode" placeholder="Batch Code" />
                <input id="addBatchQty" type="number" placeholder="Batch Qty" />
                <select id="addTabletQty"></select>
            </div>

            <div class="modal-footer">
                <button onclick="saveBatch()">Save</button>
                <button data-bs-dismiss="modal">Cancel</button>
            </div>
        </div>
    </div>
</div>