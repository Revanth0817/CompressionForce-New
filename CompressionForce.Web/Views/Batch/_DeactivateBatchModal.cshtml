@*
    //_DeactivateBatchModal
*@
<div class="modal fade" id="deactivateBatchModal" aria-hidden="true" aria-labelledby="deactivateBatchModalLabel" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <!-- Modal Header -->
            <div class="modal-header bgcol-215ED6 text-white justify-content-between font-size-18px">
                <h5 class="fw-semibold modal-title" id="deactivateBatchModalLabel">
                    Deactivate Batch
                </h5>
                <button type="button" class="bg-transparent border-0" data-bs-dismiss="modal" aria-label="Close">
                    <img src="~/icons/closeicon.svg" />
                </button>
            </div>

            <!-- Modal Body -->
            <div class="modal-body px-4 pt-4 pb-3">

                <!-- Batch Code Listbox -->
                <div class="mb-3">
                    <label class="form-label font-size-14">Batch Code</label>
                    <select class="form-select bord-D2D2D2" id="deactivateBatchCode">
                        <option value="">Select Batch</option>
                    </select>
                </div>

            </div>

            <!-- Modal Footer -->
            <div class="modal-footer justify-content-end border-top-0 p-3 pt-0 gap-2">
                <button type="button"
                        class="btn col-215ED6 bord-215ED6 fw-semibold font-size-16px px-4"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button type="button"
                        class="btn bg-danger text-white fw-semibold font-size-16px px-4"
                        onclick="deactivateBatch()">
                    Deactivate
                </button>
            </div>

        </div>
    </div>
</div>
