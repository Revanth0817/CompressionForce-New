@using Microsoft.AspNetCore.Html
@model CompressionForce.Web.Models.AutoTareVm

<div class="container-fluid border-d2d2d2 border-radius-4 p-4 m-3">
    <div class="card custom-card-height">

        <!-- HEADER -->
        <div class="card-header text-white font-size-18 fw-semibold text-center background-col-215ED6">
            Loadcell 'No Load' Offset Setting
        </div>

        <div class="card-body">
            <div class="p-4">

                <!-- TOP SECTION -->
                <div class="d-flex justify-content-center mb-4">
                    <div class="d-flex flex-wrap align-items-center gap-3">

                        <!-- Door Interlock (Display Only) -->
                        <button id="doorInterlockBtn" class="btn text-white font-size-14 fw-semibold custom-background-col-8434C6 border-radius-4"
                                disabled>
                            Door Interlock
                        </button>

                        <!-- Turret Start (Display Only) -->
                        <button id="turretStartBtn" class="btn text-white font-size-14 fw-semibold background-col-8434C6 border-radius-4"
                                disabled>
                            Turret Start
                        </button>

                        <!-- Motor Status -->
                        <div class="d-flex align-items-center">
                            <label class="font-size-14 fw-semibold col-242424 me-2">Motor Status</label>
                            <input id="motorStatus" class="form-control text-white font-size-12 fw-semibold text-center background-col-47494A border-radius-4 width-60 height-25"
                                   value="@Model.MotorStatus"
                                   readonly />
                        </div>

                        <!-- Motor Trip -->
                        <div class="d-flex align-items-center">
                            <label class="font-size-14 fw-semibold col-242424 me-2">Motor Trip</label>
                            <input id="motorTrip" class="form-control text-white font-size-12 fw-semibold text-center background-col-47494A border-radius-4 width-60 height-25"
                                   value="@Model.MotorTrip"
                                   readonly />
                        </div>

                        <!-- Revolutions -->
                        <div class="d-flex align-items-center">
                            <label class="font-size-14 fw-semibold col-242424 me-2">Revolutions</label>
                            <input id="revolutions" class="form-control font-size-12 fw-semibold text-center background-col-81D4FA col-242424 border-radius-4 width-60 height-25"
                                   value="@Model.Revolutions"
                                   readonly />
                        </div>

                    </div>
                </div>

                <!-- LOADCELL VALUES -->
                <div class="row justify-content-center mt-1 gx-5">

                    <!-- COLUMN 1 -->
                    <div class="col-md-4">
                        @LoadCell("S1 Main Compaction Loadcell", "S1Main", Model.S1Main)
                        @LoadCell("S2 Main Compaction Loadcell", "S2Main", Model.S2Main)
                        @LoadCell("S1 Pre Compaction Loadcell", "S1Pre", Model.S1Pre)
                        @LoadCell("S2 Pre Compaction Loadcell", "S2Pre", Model.S2Pre)
                        @LoadCell("S1 Ejection Loadcell", "S1Eject", Model.S1Eject)
                        @LoadCell("S2 Ejection Loadcell", "S2Eject", Model.S2Eject)
                    </div>

                    <!-- COLUMN 2 (Mirror / Redundancy) -->
                    <div class="col-md-4">
                        @LoadCell("S1 Main Compaction Loadcell", "", Model.S1Main)
                        @LoadCell("S2 Main Compaction Loadcell", "", Model.S2Main)
                        @LoadCell("S1 Pre Compaction Loadcell", "", Model.S1Pre)
                        @LoadCell("S2 Pre Compaction Loadcell", "", Model.S2Pre)
                        @LoadCell("S1 Ejection Loadcell", "", Model.S1Eject)
                        @LoadCell("S2 Ejection Loadcell", "", Model.S2Eject)
                    </div>

                </div>
            </div>

            <!-- PROGRESS BAR -->
            <div class="container-fluid mt-4 mb-3">
                <div class="progress" style="height:10px;">
                    <div class="progress-bar background-col-215ED6"
                         style="width:100%;"></div>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script> 
<script src="~/js/plc-signalr.js"></script>
@functions {
    private IHtmlContent LoadCell(string label, string id, decimal value)
    {
        return new HtmlString($@"
        <div class='d-flex justify-content-between align-items-center mb-3'>
            <div class='font-size-14 fw-semibold col-242424'>{label}</div>
            <div class='d-flex align-items-center gap-2'>
                <input id= '{id}' class='form-control col-242424 font-size-12 fw-semibold text-center border-d2d2d2 border-radius-4 width-60 height-25'
                       value='{value:F2}'
                       readonly />
                <span class='font-size-14 fw-semibold'>kN</span>
            </div>
        </div>");
    }
}
