@model CompressionForce.Web.Models.Recipes.AddEditRecipeVm

@{
    ViewData["Title"] = "Edit Recipe";
}

<div class="container mt-3">
    <h4>Edit Recipe</h4>

    <form asp-action="Edit" method="post" id="editRecipeForm" class="mb-3">

        <div class="mb-3">
            <label asp-for="Code" class="form-label"></label>
            <input asp-for="Code" class="form-control" readonly />
            <span asp-validation-for="Code" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        @Html.Partial("_RecipeParametersEdit", Model)

        <div class="mt-3">
            <button type="submit" class="btn btn-primary" id="btnSaveEdit">Save</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/recipe.js"></script>
    <script>
        $(function () {
            window.RecipeJs.attachClientValidation('#editRecipeForm');
        });
    </script>
}
