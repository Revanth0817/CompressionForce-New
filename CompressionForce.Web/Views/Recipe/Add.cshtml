@model CompressionForce.Web.Models.Recipes.AddEditRecipeVm

@{
    ViewData["Title"] = "Add Recipe";
}

<div class="container mt-3">
    <h4>Add Recipe</h4>
    <div asp-validation-summary="All" class="text-danger"></div>
    <form asp-action="Add" method="post" id="addRecipeForm" class="mb-3">

        <div class="mb-3">
            <label asp-for="Code" class="form-label"></label>
            <input asp-for="Code" class="form-control" readonly />
            <span asp-validation-for="Code" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control"/>
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        @Html.Partial("_RecipeParametersEditor", Model)

        <div class="mt-3">
            <button type="submit" class="btn btn-primary" id="btnSaveAdd">Save</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/recipe.js"></script>
    <script>
        $(function () {
            window.RecipeJs.attachClientValidation('#addRecipeForm');
        });
    </script>
}
