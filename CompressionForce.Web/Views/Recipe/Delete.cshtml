@model CompressionForce.Web.Models.Recipes.DeleteRecipeVm

@{
    ViewData["Title"] = "Delete Recipe";
}

<div class="container mt-3">
    <h4>Delete Recipe</h4>

    <form asp-action="DeleteIsConfirmed" method="post" class="mb-3">

        @Html.AntiForgeryToken()

        <input asp-for="Code" type="hidden" />
        <input asp-for="Name" type="hidden" />

        <div class="mb-3">
            <label class="form-label">Recipe Code</label>
            <input class="form-control" value="@Model.Code" readonly />
        </div>

        <div class="mb-3">
            <label class="form-label">Recipe Name</label>
            <input class="form-control" value="@Model.Name" readonly />
        </div>

        @Html.Partial(
        "_RecipeParametersReadOnly",
                new CompressionForce.Services.DTOs.RecipeDto
                {
                    Code = Model.Code,
                    Name = Model.Name,
                    Parameters = Model.Parameters
                })

        <div class="mt-3">
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>

    </form>
</div>
