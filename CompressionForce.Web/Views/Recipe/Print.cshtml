@model CompressionForce.Services.DTOs.RecipeDto
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Print Recipe - @Model.Code</title>

    <!-- same stylesheets (and order) as the main layout, otherwise the section headers print white-on-white -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="~/css/site1.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site2.css" asp-append-version="true" />
    <link href="~/css/batchPage.css" rel="stylesheet" />
    <link href="~/bootstrap/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        body {
            padding: 2rem;
            /* browsers drop background colours when printing unless asked to keep them */
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        @@media print {
            .no-print {
                display: none;
            }
        }
    </style>
</head>
<body>

    <h3>Recipe: @(string.Equals(Model.Name, Model.Code, StringComparison.OrdinalIgnoreCase) || string.IsNullOrWhiteSpace(Model.Name) ? Model.Code : $"{Model.Name} ({Model.Code})")</h3>

    <div class="mt-3">
        @Html.Partial("_RecipeParametersIndex", Model)
    </div>

    <div class="no-print mt-3">
        <button type="button" class="btn btn-secondary" onclick="window.print()">
            Print
        </button>
    </div>

</body>
</html>
