@model CompressionForce.Services.DTOs.RecipeDto
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Print Recipe - @Model.Code</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
        body {
            padding: 2rem;
        }

        @@media print {
            .no-print {
                display: none;
            }
        }
    </style>
</head>
<body>

    <h3>Recipe: @Model.Name (@Model.Code)</h3>

    <div class="mt-3">
        @await Html.PartialAsync("_RecipeParametersIndex", Model)
    </div>

    <div class="no-print mt-3">
        <button type="button" class="btn btn-secondary" onclick="window.print()">
            Print
        </button>
    </div>

</body>
</html>
