@model CompressionForce.Web.Models.Recipes.AddEditRecipeVm
@{
}
<div class="container-fluid">
    <form asp-action="EditRecipe" method="post">
    <div class="row">
        <!-- Left Column -->
        <div class="col-md-4">
            <!-- Recipe Code -->
            <div class="card mb-3">
                <div class="card-header bgcol-215ED6 text-white text-center font-size-18px fw-semibold">Recipe Code</div>
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="input-group input-group-sm bord-D2D2D2 bord-rad-4px overflow-hidden w-100 p-0">
                            <input type="text" id="awcAr" name="Code"
                                   class="form-control bg-white border-0 font-size-14px col-242424 fw-normal" value=@Model.Code readonly />
                            <button class="btn bgcol-215ED6 text-white border-0 dropdown-toggle font-size-14px" type="button"
                                    data-bs-toggle="dropdown" aria-expanded="false"></button>
                            <ul class="dropdown-menu dropdown-menu-end font-size-14px">
                                <li><a class="dropdown-item" href="#">4444</a></li>
                                <li><a class="dropdown-item" href="#">trial 2</a></li>
                            </ul>
                        </div>
                    </div>
                    <div class="d-flex justify-content-end gap-2">
                            <button type="button" onclick="location.href='@Url.Action("RecipeParameter")'" class="btn col-215ED6 bord-215ED6 fw-semibold font-size-16px">Cancel</button>
                            <button type="submit" class="btn bgcol-215ED6 text-white fw-semibold font-size-16px">Save</button>
                    </div>
                </div>
            </div>

            <!-- Parameter Table -->
            <div class="card">
                <div class="card-body p-0">
                    <table class="table table-bordered table-sm mb-0 font-size-12px">
                        <thead class="thead-light text-center">
                            <tr>
                                <th class="fw-semibold font-size-16px bgcol-215ED6 text-white">Parameter</th>
                                <th class="fw-semibold font-size-16px bgcol-215ED6 text-white">Min. Limit</th>
                                <th class="fw-semibold font-size-16px bgcol-215ED6 text-white">Max. Limit</th>
                                <th class="fw-semibold font-size-16px bgcol-215ED6 text-white">Units</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><td>Tablet Thickness</td><td>1</td><td>10</td><td>mm</td></tr>
                            <tr><td>Tablet Hardness</td><td>1</td><td>500</td><td>N</td></tr>
                            <tr><td>Tablet Weight</td><td>1</td><td>2000</td><td>mg</td></tr>
                            <tr><td>Turret RPM</td><td>10</td><td>35</td><td>rpm</td></tr>
                            <tr><td>Pre Fill Depth</td><td>1</td><td>20</td><td>mm</td></tr>
                            <tr><td>Main Fill Depth</td><td>1</td><td>20</td><td>mm</td></tr>
                            <tr><td>Main Thickness Position</td><td>3.5</td><td>16</td><td>mm</td></tr>
                            <tr><td>Pre Thickness Position</td><td>3.5</td><td>16</td><td>mm</td></tr>
                            <tr><td>Max Main Comp. Force</td><td>0.1</td><td>80</td><td>kN</td></tr>
                            <tr><td>Max Pre Comp. Force</td><td>0.1</td><td>80</td><td>kN</td></tr>
                            <tr><td>Max Rejection Comp. Force</td><td>0.01</td><td>1.8</td><td>kN</td></tr>
                            <tr><td>Rej Pre Comp. Limit Max</td><td>0.1</td><td>80</td><td>kN</td></tr>
                            <tr><td>AWC Pre Comp. Limit Max</td><td>0.1</td><td>80</td><td>kN</td></tr>
                            <tr><td>AWC Pre Comp. Set Point</td><td>0.1</td><td>80</td><td>kN</td></tr>
                            <tr><td>AWC Pre Comp. Limit Min</td><td>0.1</td><td>80</td><td>kN</td></tr>
                            <tr><td>Rej Pre Comp. Limit Max</td><td>0.1</td><td>80</td><td>kN</td></tr>
                            <tr><td>AWC Main Comp. Limit Max</td><td>0.1</td><td>80</td><td>kN</td></tr>
                            <tr><td>AWC Main Comp. Set Point</td><td>0.1</td><td>80</td><td>kN</td></tr>
                            <tr><td>AWC Main Comp. Limit Min</td><td>0.1</td><td>80</td><td>kN</td></tr>
                            <tr><td>Rej Main Comp. Limit Min</td><td>0.1</td><td>80</td><td>kN</td></tr>
                            <tr><td>Sample Interval Rev</td><td>1</td><td>100000</td><td>rev</td></tr>
                            <tr><td>Sample Rev Qty</td><td>1</td><td>10</td><td>rev</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Right Column -->
        @Html.Partial("_RecipeParametersEditIndex", Model)
    </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/recipeJS.js"></script>
}