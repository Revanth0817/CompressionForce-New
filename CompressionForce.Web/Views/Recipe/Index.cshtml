@model CompressionForce.Web.Models.Recipes.RecipeParameterPageVm
@{
    ViewData["Title"] = "Recipe Parameter Page";
}
<div class="container mt-3">
    @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
    @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }

    <div class="d-flex align-items-center mb-3">
        <label class="me-2">Recipe Code:</label>
        <select id="recipeCodeSelect" class="form-select w-auto">
            @if (Model.RecipeCodes.Any())
            {
                foreach (var code in Model.RecipeCodes)
                {
                    //<option value="@code" @(code == Model.SelectedCode ? "selected" : "")>@code</option>
                    <option value="@code" selected="@(code == Model.SelectedCode)">@code   </option>
                }
            }
            else
            {
                <option value="">-- No recipes --</option>
            }
        </select>
        <div class="ms-auto">
            <button id="btnAdd" class="btn btn-primary me-2">Add Recipe</button>
            <button id="btnEdit" class="btn btn-warning me-2">Edit Recipe</button>
            <button id="btnDelete" class="btn btn-danger me-2">Delete Recipe</button>
            <button id="btnPrint" class="btn btn-secondary">Print Recipe</button>
        </div>
    </div>

    <div id="recipeSection">
        @if (Model.Recipe != null)
        {
            @Html.Partial("_RecipeParametersReadOnly", Model.Recipe)
        }
        else
        {
            <div class="alert alert-info">No recipes available. Use "Add Recipe" to create one.</div>
        }
    </div>
</div>

<!-- Add Recipe: Enter Code Modal -->
<div class="modal fade" id="addCodeModal" tabindex="-1" aria-labelledby="addCodeModalLabel" aria-hidden="true">
  <div class="modal-dialog"><div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="addCodeModalLabel">New Recipe Code</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3">
            <label class="form-label">Recipe Code</label>
            <input type="text" id="newRecipeCode" class="form-control" maxlength="50" />
            <div id="codeAvailability" class="small mt-1"></div>
        </div>
      </div>
      <div class="modal-footer">
        <button id="btnCheckCode" type="button" class="btn btn-outline-primary">Check Availability</button>
        <button id="btnProceedAdd" type="button" class="btn btn-primary" disabled>Proceed</button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
      </div>
  </div></div>
</div>



@section Scripts {
    <!-- jQuery Validation (depends on jQuery in _Layout) -->
    <partial name="_ValidationScriptsPartial" />

    <!-- Page-specific script -->
    <script src="~/js/recipe.js"></script>
}




