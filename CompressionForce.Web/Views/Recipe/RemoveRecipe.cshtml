@model CompressionForce.Web.Models.Recipes.DeleteRecipeVm
@using System.Linq

<!-- Delete Recipe -->
<form id="deleteForm" asp-action="DeleteConfirmed" method="post">
    @Html.AntiForgeryToken()

    <input asp-for="Code" type="hidden" />
    <input asp-for="Name" type="hidden" />

    <div class="container-fluid px-lg-4 px-md-4 px-sm-3 pt-4 px-3">

        <!-- Recipe Code Card -->
        <div class="RecipeCodeContainer bord-rad-4px boxshadow">
            <div class="AddRecipeHeader headerRadius fw-semibold bgcol-215ED6 text-white text-center font-size-18px p-10px">
                Delete Recipe
            </div>

            <div class="AddRecipeCodeContent p-4">
                <div class="mb-4">
                    <input asp-for="Code"
                           type="text"
                           class="form-control boxshadow"
                           readonly />
                </div>

                <div class="d-flex gap-3 align-items-center justify-content-end">
                    <button type="button"
                            onclick="location.href='@Url.Action("RecipeParameter", new { code = Model.Code })'"
                            class="bg-white clr-215ED6 bord-215ED6 cancel-btn font-size-16px fw-semibold rounded-2 py-2 px-3">
                        Cancel
                    </button>

                    <button type="submit"
                            class="bord-215ED6 bgcol-215ED6 text-white save-btn font-size-16px fw-semibold rounded-2 py-2 px-3">
                        Delete
                    </button>
                </div>
            </div>
        </div>

        <!-- Read-only Parameters (Right section converted to below) -->
        <div class="card mt-4">
            @Html.Partial(
                        "_RecipeParametersIndex",
                        new CompressionForce.Services.DTOs.RecipeDto
                        {
                            Code = Model.Code,
                            Name = Model.Name,
                            Parameters = Model.Parameters
                        })
        </div>

        <!-- Static Reference Table -->
        <div class="table-responsive">
            <table class="table addRecipeTable table-bordered bord-D2D2D2 boxshadow bord-rad-4px mt-4">
                <thead>
                    <tr>
                        <th>Parameter Name</th>
                        <th>Min. Limit</th>
                        <th>Max. Limit</th>
                        <th>Units</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><td>Tablet Thickness</td><td>1</td><td>10</td><td>mm</td></tr>
                    <tr><td>Tablet Hardness</td><td>1</td><td>500</td><td>N</td></tr>
                    <tr><td>Tablet Weight</td><td>1</td><td>2000</td><td>mg</td></tr>
                    <tr><td>Turret RPM</td><td>10</td><td>35</td><td>RPM</td></tr>
                    <tr><td>Pre Fill Depth</td><td>1</td><td>20</td><td>mm</td></tr>
                    <tr><td>Main Fill Depth</td><td>1</td><td>20</td><td>mm</td></tr>
                    <tr><td>Main Thickness Position</td><td>3.5</td><td>16</td><td>mm</td></tr>
                    <tr><td>Pre Thickness Position</td><td>3.5</td><td>16</td><td>mm</td></tr>
                    <tr><td>Max Main Comp. Force</td><td>0.1</td><td>80</td><td>kN</td></tr>
                    <tr><td>Max Pre Comp. Force</td><td>0.1</td><td>80</td><td>kN</td></tr>
                    <tr><td>Max Rejection Comp. Force</td><td>0.01</td><td>1.8</td><td>kN</td></tr>
                    <tr><td>Rej Pre Comp. Limit Max</td><td>0.1</td><td>80</td><td>kN</td></tr>
                    <tr><td>AWC Pre Comp. Set Point</td><td>0.1</td><td>80</td><td>kN</td></tr>
                    <tr><td>AWC Pre Comp. Limit Min</td><td>0.1</td><td>80</td><td>kN</td></tr>
                    <tr><td>AWC Main Comp. Limit Max</td><td>0.1</td><td>80</td><td>kN</td></tr>
                    <tr><td>AWC Main Comp. Set Point</td><td>0.1</td><td>80</td><td>kN</td></tr>
                    <tr><td>AWC Main Comp. Limit Min</td><td>0.1</td><td>80</td><td>kN</td></tr>
                    <tr><td>Rej Main Comp. Limit Min</td><td>0.1</td><td>80</td><td>kN</td></tr>
                    <tr><td>Sample Interval Rev</td><td>1</td><td>100000</td><td>Rev</td></tr>
                    <tr><td>Sample Rev Qty</td><td>1</td><td>10</td><td>Qty</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</form>
