@{
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

@model CompressionForce.Models.RegisterViewModel

<div class="d-flex justify-content-center">
    <div class="container-fluid shadow border-d2d2d2 mt-5">
        <div class="row">

            <!-- LEFT SECTION -->
            <div class="col-md-6 background-col-E9EFFB p-5 text-center d-flex flex-column justify-content-center height-500">
                <h3 class="fw-bold font-size-20 col-242424">Create Account</h3>
                <p class="font-size-16 col-242424">
                    Sign up to monitor, control, and optimize compression force parameters with confidence.
                </p>

                <a asp-controller="Account" asp-action="Login"
                   class="btn shadow rounded-5 background-col-E9EFFB col-242424 font-size-16 mx-auto">
                    Already have an account? <span class="fw-semibold">Login</span>
                </a>
            </div>

            <!-- RIGHT SECTION -->
            <div class="col-md-6 login-section p-5 d-flex flex-column justify-content-center height-500">

                <form asp-controller="Account" asp-action="Register" method="post">

                    <div asp-validation-summary="ModelOnly" class="text-danger font-size-12"></div>

                    <!-- USER NAME -->
                    <div class="mb-3">
                        <label asp-for="UserName"
                               class="form-label font-size-14 fw-semibold col-242424">
                            User Name <span class="text-danger">*</span>
                        </label>
                        <input asp-for="UserName"
                               class="form-control font-size-14 col-242424"
                               placeholder="Enter User Name" />
                        <span asp-validation-for="UserName" class="text-danger font-size-12"></span>
                    </div>

                    <!-- EMAIL -->
                    <div class="mb-3">
                        <label asp-for="Email"
                               class="form-label font-size-14 fw-semibold col-242424">
                            Email Address <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Email"
                               class="form-control font-size-14 col-242424"
                               placeholder="Enter Email" />
                        <span asp-validation-for="Email" class="text-danger font-size-12"></span>
                    </div>

                    <!-- PASSWORD -->
                    <div class="mb-3">
                        <label asp-for="Password"
                               class="form-label font-size-14 fw-semibold col-242424">
                            Password <span class="text-danger">*</span>
                        </label>

                        <div class="position-relative">
                            <input asp-for="Password"
                                   type="password"
                                   class="form-control col-242424 font-size-14"
                                   id="Password"
                                   placeholder="Enter Password" />

                            <img src="~/icons/eyeicon.svg"
                                 alt="Toggle Password"
                                 class="position-absolute top-50 translate-middle-y cursor-pointer end-0 me-2"
                                 onclick="togglePassword('Password')" />
                        </div>

                        <span asp-validation-for="Password" class="text-danger font-size-12"></span>
                    </div>

                    <!-- CONFIRM PASSWORD -->
                    <div class="mb-3">
                        <label asp-for="ConfirmPassword"
                               class="form-label font-size-14 fw-semibold col-242424">
                            Confirm Password <span class="text-danger">*</span>
                        </label>

                        <div class="position-relative">
                            <input asp-for="ConfirmPassword"
                                   type="password"
                                   class="form-control col-242424 font-size-14"
                                   id="ConfirmPassword"
                                   placeholder="Confirm Password" />

                            <img src="~/icons/eyeicon.svg"
                                 alt="Toggle Password"
                                 class="position-absolute top-50 translate-middle-y cursor-pointer end-0 me-2"
                                 onclick="togglePassword('ConfirmPassword')" />
                        </div>

                        <span asp-validation-for="ConfirmPassword" class="text-danger font-size-12"></span>
                    </div>

                    <button type="submit"
                            class="btn background-col-215ED6 text-white font-size-16 fw-semibold ms-auto d-block">
                        Sign Up
                    </button>

                </form>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        function togglePassword(inputId) {
            var input = document.getElementById(inputId);
            input.type = input.type === "password" ? "text" : "password";
        }
    </script>
}
