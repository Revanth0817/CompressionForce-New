@model CompressionForce.Web.Models.ChangePasswordViewModel
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{ ViewData["Title"] = "Change Password"; }

@{
    var currentUserName = HttpContextAccessor.HttpContext.Session.GetString("UserName") ?? "User";
}

<div class="m-3 h-100">
    <div class="passwordChangeMainContainer p-4 h-100">
        <div class="passwordChangeContainer d-flex align-items-center h-100">
            <div class="rightsideContainer flex-grow-1 p-3">
                <h3 class="mb-3">Welcome @currentUserName</h3>

                <form asp-action="ChangePassword" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger font-size-14 mb-2"></div>
                    <div class="mb-3">
                        <label asp-for="OldPassword" class="form-label fw-semibold">Old Password<span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input asp-for="OldPassword" class="form-control" id="pwdOld" placeholder="Current password" autocomplete="current-password" autofocus>
                            <button type="button" class="btn btn-outline-secondary" aria-label="Show old password" aria-pressed="false"
                                    onclick="toggleVisibility('pwdOld', this)"><img src="~/icons/password_show.svg" alt="" /></button>
                        </div>
                        <span asp-validation-for="OldPassword" class="text-danger font-size-12"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label fw-semibold">New Password<span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input asp-for="NewPassword" class="form-control" id="pwdNew" placeholder="New password" autocomplete="new-password">
                            <button type="button" class="btn btn-outline-secondary" aria-label="Show new password" aria-pressed="false"
                                    onclick="toggleVisibility('pwdNew', this)"><img src="~/icons/password_show.svg" alt="" /></button>
                        </div>
                        <span asp-validation-for="NewPassword" class="text-danger font-size-12"></span>
                        <div class="font-size-12 text-muted mt-1">8-15 characters with upper and lower case letters, a number and a special character. It must be different from your current password.</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold">Confirm Password<span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input asp-for="ConfirmPassword" class="form-control" id="pwdConf" placeholder="Confirm password" autocomplete="new-password">
                            <button type="button" class="btn btn-outline-secondary" aria-label="Show confirm password" aria-pressed="false"
                                    onclick="toggleVisibility('pwdConf', this)"><img src="~/icons/password_show.svg" alt="" /></button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger font-size-12"></span>
                    </div>

                    <div class="d-flex justify-content-end mt-4">
                        <button type="submit" id="changePasswordButton" class="btn bgcol-215ED6 text-white px-4">Change Password</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @* Enable Client-Side Validation *@
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <script>
        function toggleVisibility(id, btn) {
            var x = document.getElementById(id);
            var show = x.type === "password";
            x.type = show ? "text" : "password";
            var label = btn.getAttribute("aria-label").replace(/^(Show|Hide) /, "");
            btn.setAttribute("aria-pressed", show);
            btn.setAttribute("aria-label", (show ? "Hide " : "Show ") + label);
        }

        // one click = one change request
        document.querySelector("form").addEventListener("submit", function () {
            var form = this;
            if (window.jQuery && window.jQuery.validator && !window.jQuery(form).valid()) return;
            var btn = document.getElementById("changePasswordButton");
            setTimeout(function () { btn.disabled = true; btn.textContent = "Changing..."; }, 0);
        });

        // coming back with the browser Back button must not leave the button disabled
        window.addEventListener("pageshow", function () {
            var btn = document.getElementById("changePasswordButton");
            btn.disabled = false;
            btn.textContent = "Change Password";
        });
    </script>
}