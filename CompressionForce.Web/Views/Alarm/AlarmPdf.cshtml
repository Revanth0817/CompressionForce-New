@{
    Layout = null;
}

@model List<CompressionForce.Models.AlarmReportVm>

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <style>
        body {
            font-family: Arial, Helvetica, sans-serif;
            font-size: 11px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            background-color: #215ED6;
            color: white;
            border: 1px solid #000;
            padding: 6px;
            font-size: 12px;
            text-align: center;
        }

        td {
            border: 1px solid #000;
            padding: 6px;
            font-size: 11px;
            text-align: center;
        }
    </style>
</head>
<body>

    <!-- ONLY TABLE (NO TITLE / NO HEADER) -->
    <table>
        <thead>
            <tr>
                <th>Alarm Code</th>
                <th>Alarm Created Time</th>
                <th>Alarm Description</th>
                <th>User Name</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.AlarmCode</td>
                    <td>@item.AlarmCreatedTime.ToString("dd-MM-yyyy HH:mm:ss")</td>
                    <td>@item.AlarmDescription</td>
                    <td>@item.UserName</td>
                </tr>
            }
        </tbody>
    </table>

</body>
</html>
