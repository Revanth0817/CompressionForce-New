@model List<CompressionForce.Domain.Entities.AuditTrail>

<div class="container-fluid p-4 d-flex flex-column min-vh-75">
    <div class="flex-grow-1">
        <!-- Header + Buttons -->
        <div class="row align-items-center mb-4 mb-md-4">
            <div class="col-md-4 col-12">
                <h5 class="font-size-20px col-215ED6 fw-semibold mb-3 mb-md-0">Audit Trial</h5>
            </div>
            <div class="col-md-8 col-12 d-flex flex-wrap justify-content-md-end gap-3">
                <div class="d-flex gap-3">
                    <<button type="button"
                             class="btn btn-primary btn-sm"
                             onclick="downloadPdf(false)">
                        Fetch Report
                    </button>
                    <button type="button"
                            class="btn btn-outline-primary btn-sm"
                            onclick="downloadPdf(true)">
                        Print Report
                    </button>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <label class="fw-semibold col-242424 font-size-14px mb-0">
                        Total Events
                    </label>

                    <input type="text"
                           class="form-control form-control-sm shadow-custom bg-white max-w-63px fw-semibold col-242424 font-size-14px"
                           value="@ViewBag.TotalCount"
                           readonly>
                </div>

            </div>
        </div>

        <!-- Filters Row -->
        <div class="row gy-3 mb-4 mb-md-4">
            <!-- From Date Time -->
            <div class="col-md-6 col-12 d-flex align-items-center gap-2">
                <label class="fw-semibold font-size-14px col-242424 mb-0 text-nowrap min-w-120px">
                    From Date Time
                </label>

                <div class="input-group w-100 position-relative">
                    <input type="datetime-local"
                           id="fromDate"
                           class="form-control form-control-sm fw-normal col-242424 font-size-13px datetime-input">

                    <span class="input-group-text calendar-btn bgcol-215ED6
              d-flex align-items-center justify-content-center p-0 w-26px h-32px"
                          onclick="openCalendar('fromDate')">
                        <img src="~/images/bx_calendar.png"
                             alt="calendar-icon"
                             class="w-16px h-16px">
                    </span>
                </div>
            </div>

            <!-- To Date Time -->
            <div class="col-md-6 col-12 d-flex align-items-center gap-2">
                <label class="fw-semibold font-size-14px col-242424 mb-0 text-nowrap min-w-120px">
                    To Date Time
                </label>

                <div class="input-group w-100 position-relative">
                    <input type="datetime-local"
                           id="toDate"
                           class="form-control form-control-sm fw-normal col-242424 font-size-13px datetime-input">

                    <span class="input-group-text calendar-btn bgcol-215ED6
              d-flex align-items-center justify-content-center p-0 w-26px h-32px"
                          onclick="openCalendar('toDate')">
                        <img src="~/images/bx_calendar.png"
                             alt="calendar-icon"
                             class="w-16px h-16px">
                    </span>
                </div>
            </div>


            <!-- User Name -->
            <div class="col-md-6 col-12 d-flex align-items-center gap-2">
                <label class="fw-semibold font-size-14px min-w-120px">
                    User Name
                </label>

                <div class="input-group input-group-sm w-100">

                    <!-- Display selected user -->
                    <input type="text"
                           id="UserName"
                           class="form-control bg-white fw-normal font-size-13px"
                           value="None"
                           readonly />

                    <!-- Dropdown button -->
                    <button class="btn bgcol-215ED6 text-white dropdown-toggle"
                            type="button"
                            data-bs-toggle="dropdown"
                            aria-expanded="false"
                            style="border-top-left-radius: 0; border-bottom-left-radius: 0;">
                    </button>

                    <!-- Dropdown menu -->
                    <ul class="dropdown-menu dropdown-menu-end w-100">

                        <li>
                            <button class="dropdown-item"
                                    type="button"
                                    onclick="setUserName('None')">
                                None
                            </button>
                        </li>

                        @if (ViewBag.Users != null && ViewBag.Users.Count > 0)
                        {
                            foreach (string user in ViewBag.Users)
                            {
                                <li>
                                    <button class="dropdown-item"
                                            type="button"
                                            onclick="setUserName('@user')">
                                        @user
                                    </button>
                                </li>
                            }
                        }
                        else
                        {
                            <li>
                                <span class="dropdown-item text-muted">
                                    No users found
                                </span>
                            </li>
                        }

                    </ul>
                </div>
            </div>






            <!-- Activity -->
            <div class="col-md-6 col-12 d-flex align-items-center gap-2">
                <label class="fw-semibold font-size-14px col-242424 mb-0 text-nowrap min-w-120px">
                    Activity
                </label>

                <div class="input-group input-group-sm w-100">

                    <input type="text"
                           id="Activity"
                           class="form-control bg-white fw-normal col-242424 font-size-13px"
                           value="None"
                           readonly />

                    <button class="btn bgcol-215ED6 text-white dropdown-toggle"
                            type="button"
                            data-bs-toggle="dropdown"
                            aria-expanded="false">
                    </button>

                    <ul class="dropdown-menu dropdown-menu-end font-size-14px w-100">
                        <li>
                            <button class="dropdown-item" type="button"
                                    onclick="setActivity('None')">
                                None
                            </button>
                        </li>

                        @if (ViewBag.Activities != null && ViewBag.Activities.Count > 0)
                        {
                            foreach (string act in ViewBag.Activities)
                            {
                                <li>
                                    <button class="dropdown-item" type="button"
                                            onclick="setActivity('@act')">
                                        @act
                                    </button>
                                </li>
                            }
                        }
                        else
                        {
                            <li>
                                <span class="dropdown-item text-muted">
                                    No activities found
                                </span>
                            </li>
                        }
                    </ul>

                </div>
            </div>

        <!-- Table Section -->
        <div class="table-responsive">
            <table class="table table-bordered table-sm mb-0 font-size-12px col-242424 fw-normal text-nowrap table-striped-blue min-w-800px">
                <thead class="text-center">
                    <tr>
                        <th class="fw-semibold font-size-14px bgcol-215ED6 text-white">
                            Date & Time
                        </th>
                        <th class="fw-semibold font-size-14px bgcol-215ED6 text-white">
                            User Name
                        </th>
                        <th class="fw-semibold font-size-14px bgcol-215ED6 text-white">
                            Event Description
                        </th>
                        <th class="fw-semibold font-size-14px bgcol-215ED6 text-white">
                            Activity
                        </th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var item in Model)
                        {
                            <tr class="text-center fw-normal col-242424 font-size-13px">
                                <td>
                                    @item.DateTime.ToString("dd/MM/yyyy HH:mm:ss")


                                </td>
                                <td>
                                    @item.UserName
                                </td>
                                <td>
                                    @item.EventDescription
                                </td>
                                <td>
                                    @item.Activity
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4"
                                class="text-center text-muted fw-semibold py-3">
                                No audit records found
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

            <script>
                // ===============================
                // Calendar Open
                // ===============================
                function openCalendar(inputId) {
                    const input = document.getElementById(inputId);
                    if (!input) return;

                    if (input.showPicker) {
                        input.showPicker(); // Chrome / Edge
                    } else {
                        input.focus(); // fallback
                    }
                }

                // ===============================
                // Dropdown handlers
                // ===============================
                function setUserName(name) {
                    document.getElementById("UserName").value = name;
                    applyFilters();
                }

                function setActivity(activity) {
                    document.getElementById("Activity").value = activity;
                    applyFilters();
                }

                // ===============================
                // Apply Filters (SAFE)
                // ===============================
                function applyFilters() {
                    const userName = document.getElementById("UserName")?.value || "None";
                    const activity = document.getElementById("Activity")?.value || "None";
                    const fromDate = document.getElementById("fromDate")?.value || "";
                    const toDate = document.getElementById("toDate")?.value || "";

                    const params = new URLSearchParams();

                    if (userName !== "None") params.append("userName", userName);
                    if (activity !== "None") params.append("activity", activity);
                    if (fromDate) params.append("fromDate", fromDate);
                    if (toDate) params.append("toDate", toDate);

                    window.location.href = `?${params.toString()}`;
                }

                // ===============================
                // Restore filters after reload
                // ===============================
                document.addEventListener("DOMContentLoaded", function () {
                    const params = new URLSearchParams(window.location.search);

                    if (params.get("userName"))
                        document.getElementById("UserName").value = params.get("userName");

                    if (params.get("activity"))
                        document.getElementById("Activity").value = params.get("activity");

                    if (params.get("fromDate"))
                        document.getElementById("fromDate").value = params.get("fromDate");

                    if (params.get("toDate"))
                        document.getElementById("toDate").value = params.get("toDate");
                });
            </script>


            <script>
                function downloadPdf(print) {
                    const params = new URLSearchParams(window.location.search);
                    params.append("print", print);

                    window.location.href =
                        "/AuditTrail/DownloadPdf?" + params.toString();
                }
            </script>
