@model CompressionForce.Services.DTOs.PlcStatusVm

<div class="container-fluid pt-3">
    <div class="card">

        <!-- HEADER -->
        <div class="card-header fw-semibold font-size-18 text-white text-center background-col-215ED6">
            PLC PC Communication @(Model.PlcConnected ? "Connected" : "Disconnected")
        </div>

        <!-- BODY -->
        <div class="card-body background-col-E9EFFB">
            <div class="row g-3">

                <!-- Date / Time: a live clock (these used to be a snapshot taken when the page loaded) -->
                <div class="col-12 col-sm-6 col-md-4 col-xxl">
                    <label for="plc-date" class="font-size-14 fw-semibold mb-1 col-242424">Date</label>
                    <input type="text" id="plc-date" class="form-control height-35 col-242424 font-size-14 border-radius-4" value="@Model.Date" readonly data-live="date" />
                </div>

                <div class="col-12 col-sm-6 col-md-4 col-xxl">
                    <label for="plc-time" class="font-size-14 fw-semibold mb-1 col-242424">Time</label>
                    <input type="text" id="plc-time" class="form-control height-35 col-242424 font-size-14 border-radius-4" value="@Model.Time" readonly data-live="time" />
                </div>

                <!-- User Login On -->
                <div class="col-12 col-sm-6 col-md-4 col-xxl">
                    <label for="plc-login" class="font-size-14 fw-semibold mb-1 col-242424">User Login On</label>
                    <input type="text" id="plc-login" class="form-control height-35 col-242424 font-size-14 border-radius-4" value="@Model.UserLoginOn" readonly />
                </div>

                <!-- App Run Time: ticks up from the login instant -->
                <div class="col-12 col-sm-6 col-md-4 col-xxl">
                    <label for="plc-runtime" class="font-size-14 fw-semibold mb-1 col-242424">App Run Time</label>
                    <input type="text" id="plc-runtime" class="form-control height-35 col-242424 font-size-14 border-radius-4" value="@Model.AppRunTime" readonly data-login="@Model.LoginTimeIso" />
                </div>

                <!-- User Name -->
                <div class="col-12 col-sm-6 col-md-4 col-xxl">
                    <label for="plc-user" class="font-size-14 fw-semibold mb-1 col-242424">User Name</label>
                    <input type="text" id="plc-user" class="form-control height-35 col-242424 font-size-14 border-radius-4" value="@Model.UserName" readonly />
                </div>

                <!-- User Level -->
                <div class="col-12 col-sm-6 col-md-4 col-xxl">
                    <label for="plc-level" class="font-size-14 fw-semibold mb-1 col-242424">User Level</label>
                    <input type="text" id="plc-level" class="form-control height-35 col-242424 font-size-14 border-radius-4" value="@Model.UserLevel" readonly />
                </div>

                <!-- PLC IP -->
                <div class="col-12 col-sm-6 col-md-4 col-xxl">
                    <label for="plc-ip" class="font-size-14 fw-semibold mb-1 col-242424">PLC IP</label>
                    <input type="text" id="plc-ip" class="form-control height-35 col-242424 font-size-14 border-radius-4" value="@(string.IsNullOrWhiteSpace(Model.PlcIp) ? "--" : Model.PlcIp)" readonly />
                </div>

                <!-- Local DB -->
                <div class="col-12 col-sm-6 col-md-4 col-xxl text-start">
                    <label class="font-size-14 fw-semibold mb-1 d-block col-242424">Local DB</label>
                    <div class="mt-2">
                        <img src="~/icons/@(Model.LocalDbConnected ? "local db.svg" : "db_error.svg")"
                             class="width-18 height-18"
                             alt="@(Model.LocalDbConnected ? "Local database connected" : "Local database not reachable")"
                             title="@(Model.LocalDbConnected ? "Local database connected" : "Local database not reachable")" />
                    </div>
                </div>

                <!-- PLC Comm -->
                <div class="col-12 col-sm-6 col-md-4 col-xxl text-start">
                    <label class="font-size-14 fw-semibold mb-1 d-block col-242424">PLC Comm</label>
                    <div class="mt-2">
                        <img src="~/icons/@(Model.PlcConnected ? "plc comm.svg" : "plc_error.svg")"
                             class="width-18 height-18"
                             alt="@(Model.PlcConnected ? "PLC connected" : "PLC not connected")"
                             title="@(Model.PlcConnected ? "PLC connected" : "PLC not connected")" />
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<script>
    // Date, Time and App Run Time keep up with the clock instead of showing the moment the page was built
    (function () {
        var p2 = function (v) { return String(v).padStart(2, "0"); };
        var months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
        var date = document.querySelector('[data-live="date"]');
        var time = document.querySelector('[data-live="time"]');
        var run = document.getElementById("plc-runtime");
        var login = run && run.dataset.login ? new Date(run.dataset.login) : null;
        if (login && isNaN(login)) login = null;

        function tick() {
            var now = new Date();
            if (date) date.value = p2(now.getDate()) + " " + months[now.getMonth()] + " " + now.getFullYear();
            if (time) {
                var h = now.getHours() % 12 || 12;
                time.value = p2(h) + ":" + p2(now.getMinutes()) + " " + (now.getHours() < 12 ? "AM" : "PM");
            }
            if (run && login) {
                var mins = Math.max(0, Math.floor((now - login) / 60000));
                run.value = Math.floor(mins / 60) + "H:" + (mins % 60) + "M";
            }
        }
        tick();
        setInterval(tick, 1000);
    })();
</script>
