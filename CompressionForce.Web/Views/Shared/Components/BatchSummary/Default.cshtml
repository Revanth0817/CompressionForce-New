@model CompressionForce.Web.Models.Batch.BatchSummaryVM

@if (Model == null)
{
    <div>No batch selected</div>
}
else
{
    <div class="batch-summary">
        <div><strong>Batch Code:</strong> @Model.BatchCode</div>
        <div><strong>Batch Qty:</strong> @Model.BatchQty</div>
        <div><strong>Status:</strong> @Model.Status</div>
    </div>
}
