@model CompressionForce.Web.Models.ErrorViewModel
@{
    Layout = null;
    var title = Model.StatusCode switch
    {
        404 => "Page not found",
        403 => "Access denied",
        401 => "Please log in",
        _ => "Something went wrong"
    };
    var text = Model.StatusCode switch
    {
        404 => "The page you asked for does not exist.",
        403 => "You do not have permission to open this.",
        401 => "Your session has ended. Please log in again.",
        _ => "The request could not be completed. Please try again; if it keeps happening, contact your administrator."
    };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title - Compression_Force</title>
    <link href="~/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body { background: #eef2fb; }
        .error-bar { background: linear-gradient(90deg, #215ED6, #8434C6); color: #fff; padding: 14px 24px; font-weight: 600; }
        .error-card { max-width: 560px; margin: 64px auto; background: #fff; border-radius: 6px; box-shadow: 0 2px 10px rgba(0,0,0,.12); }
        .error-card h1 { font-size: 22px; color: #215ED6; }
    </style>
</head>
<body>
    <div class="error-bar">SRC-51 Compression Force Control System</div>

    <div class="error-card p-4">
        <h1 class="fw-semibold mb-3">@title</h1>
        <p class="mb-2">@text</p>

        @if (Model.ShowRequestId)
        {
            <p class="text-muted small mb-4">Reference: <code>@Model.RequestId</code></p>
        }

        <a class="btn text-white fw-semibold px-4" style="background:#215ED6" href="/">Back to Home</a>
    </div>
</body>
</html>
