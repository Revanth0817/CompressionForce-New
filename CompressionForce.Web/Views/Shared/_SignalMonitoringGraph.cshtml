@* Signal Monitoring Graph — Live PLC Data from TwinCAT Ladder *@
<ul class="nav nav-tabs mb-3 signal-header-tabs" role="tablist">

    <button class="nav-link active"
            data-bs-toggle="tab"
            data-key="GRAPH_VALUE"
            data-bs-target="#graph-live"
            type="button">
        PLC Graph
    </button>

    <button class="nav-link"
            data-bs-toggle="tab"
            data-key="S1_MAIN"
            data-bs-target="#s1-main"
            type="button">
        S1 Main Comp.
    </button>

    <button class="nav-link"
            data-bs-toggle="tab"
            data-key="S1_PRE"
            data-bs-target="#s1-pre"
            type="button">
        S1 Pre Comp.
    </button>

    <button class="nav-link"
            data-bs-toggle="tab"
            data-key="S1_EJECT"
            data-bs-target="#s1-eject"
            type="button">
        S1 Ejection
    </button>

    <button class="nav-link"
            data-bs-toggle="tab"
            data-key="S2_MAIN"
            data-bs-target="#s2-main"
            type="button">
        S2 Main Comp.
    </button>

    <button class="nav-link"
            data-bs-toggle="tab"
            data-key="S2_PRE"
            data-bs-target="#s2-pre"
            type="button">
        S2 Pre Comp.
    </button>

    <button class="nav-link"
            data-bs-toggle="tab"
            data-key="S2_EJECT"
            data-bs-target="#s2-eject"
            type="button">
        S2 Ejection
    </button>

</ul>

<div class="plot-area" style="height:400px; width:100%;">
    <canvas id="forceChart"></canvas>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.0/dist/browser/signalr.min.js"></script>

<script>
    /* ============================================================
       CONFIG
    ============================================================ */
    const MAX_POINTS = 52;

    // Ladder mapping:
    // GVL.GraphValue (REAL)  → tag key: GRAPH_VALUE → type: RealInput
    // GVL.index      (INT)   → tag key: GRAPH_INDEX → type: InputRegister

    const forceHistory = {
        GRAPH_VALUE: [],    // ✅ PLC ladder graph data
        S1_MAIN:     [],
        S1_PRE:      [],
        S1_EJECT:    [],
        S2_MAIN:     [],
        S2_PRE:      [],
        S2_EJECT:    []
    };

    let activeKey = "GRAPH_VALUE";

    /* ============================================================
       CHART
    ============================================================ */
    const ctx = document.getElementById('forceChart').getContext('2d');
    const punchLabels = Array.from({ length: MAX_POINTS }, (_, i) => "" + (i + 1));

    const chart = new Chart(ctx, {
        type: 'line',
        data: {
            labels: punchLabels,
            datasets: [{
                label: 'Force (kN)',
                data: [],
                borderColor: '#215ED6',
                borderWidth: 2,
                fill: true,
                backgroundColor: 'rgba(33, 94, 214, 0.1)',
                tension: 0.3,
                pointRadius: 1
            }]
        },
        options: {
            animation: false,
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                x: { title: { display: true, text: 'Punches' } },
                y: {
                    title: { display: true, text: 'Force (kN)' },
                    beginAtZero: true
                }
            }
        }
    });

    /* ============================================================
       TAB SWITCHING
    ============================================================ */
    document.querySelectorAll('.signal-header-tabs .nav-link').forEach(tab => {
        tab.addEventListener('click', () => {
            activeKey = tab.dataset.key;
            refreshChart();
        });
    });

    function refreshChart() {
        const data = forceHistory[activeKey] || [];
        chart.data.datasets[0].data = [...data];
        chart.update();
    }

    /* ============================================================
       SIGNALR — PLC live values
    ============================================================ */
    const graphHub = new signalR.HubConnectionBuilder()
        .withUrl("/servoHub")
        .withAutomaticReconnect()
        .build();

    // AnalogInputUpdated(key, raw, force)
    // key = "GRAPH_VALUE" for ladder graph, or load cell codes
    graphHub.on("AnalogInputUpdated", (key, raw, force) => {

        if (!(key in forceHistory)) return;

        const history = forceHistory[key];

        history.push(Number(force));
        if (history.length > MAX_POINTS) {
            history.shift();
        }

        if (key === activeKey) {
            refreshChart();
        }
    });

    graphHub.start()
        .then(() => console.log("✅ Graph SignalR connected"))
        .catch(err => console.error("❌ Graph SignalR failed:", err));
</script>