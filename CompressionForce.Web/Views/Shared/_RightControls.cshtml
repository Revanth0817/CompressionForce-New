<!-- COMMON RIGHT SIDE SECTION FOR AUTO MODE MODULE -->
<section class="d-flex d-xxl-block mt-3 order-xxl-last order-first ms-lg-0 ms-3 justify-content-center flex-wrap gap-3 auto-right-controls">

    <!-- Card 1 -->
    <section class="card text-bg-light mb-3 box-shadow-1 w-288px">
        <h5 class="card-title col-FFFFFF bord-top-rad-4px mb-0">Turret Control</h5>

        <div class="card-body p-3">
            <div class="d-flex gap-2 mb-2 w-100">
                <button class="btn btn-primary bgcol-8434C6 w-50 fw-semibold">Turret Start</button>
                <button class="btn btn-primary bgcol-8434C6 w-50 fw-semibold">Turret Jog</button>
            </div>

            <div class="row justify-content-start w-100 position-relative counter-comp">
                <div class="d-flex flex-column px-0">

                    <div class="d-flex align-items-center mb-2">
                        <label class="col-form-label me-auto fw-semibold">Set</label>
                        <div class="d-flex align-items-center bord-col-215ED6 rounded px-2 w-70px h-29px">
                            <div class="d-flex flex-column me-2">
                                <button class="btn btn-sm arrow-btns p-0"><img src="/images/up arrow.svg"></button>
                                <button class="btn btn-sm arrow-btns p-0"><img src="/images/down arrow.svg"></button>
                            </div>
                            <input class="form-control arrows-text bgcol-transparent h-16px border-0 p-0 fw-semibold" value="10">
                        </div>
                        <span class="ms-2 fw-semibold">rpm</span>
                    </div>

                    <div class="d-flex align-items-center mb-2">
                        <label class="col-form-label me-auto fw-semibold">Actual</label>
                        <div class="d-flex align-items-center bord-col-215ED6 rounded px-2 w-70px h-29px">
                            <div class="d-flex flex-column me-2">
                                <button class="btn btn-sm arrow-btns p-0"><img src="/images/up arrow.svg"></button>
                                <button class="btn btn-sm arrow-btns p-0"><img src="/images/down arrow.svg"></button>
                            </div>
                            <input class="form-control arrows-text bgcol-transparent h-16px border-0 p-0 fw-semibold" value="0">
                        </div>
                        <span class="ms-2 fw-semibold">rpm</span>
                    </div>

                </div>
            </div>
        </div>
    </section>

    <!-- Card 2 -->
