                    <input class="form-control w-70px text-center" value="10">
                    <span class="ms-2 fw-semibold">rpm</span>
                </div>
                <div class="d-flex align-items-center mb-2">
                    <label class="me-auto fw-semibold">Set Ratio</label>
                    <input class="form-control w-70px text-center" value="10">
                    <span class="ms-2 fw-semibold">rpm</span>
                </div>
            </div>
        </div>
    </section>

    <!-- Card 3 -->
