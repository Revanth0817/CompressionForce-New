@{ ViewData["Title"] = "Help Menu"; }

<div class="container my-4">
    <h4 class="fw-semibold clr-215ED6 mb-3">Help Menu</h4>

    <div class="bord-rad-4px shadow-custom mb-4">
        <div class="bgcol-215ED6 text-white fw-semibold font-size-18px py-2 px-3 rounded-top">Screens</div>
        <div class="p-3 text-body font-size-14px col-242424">
            <ul class="mb-0">
                <li><b>Diagnostics</b> - machine and I/O diagnostics</li>
                <li><b>Recipe</b> - add, edit, print and delete recipes</li>
                <li><b>Batch</b> - batch records and the running batch</li>
                <li><b>Auto Mode</b> - automatic production monitoring</li>
                <li><b>Report</b> - production reports and graphs</li>
                <li><b>Calibration</b> - load cell and servo calibration</li>
                <li><b>Alarm</b> - alarm history and PDF export</li>
                <li><b>Auto Tare Mode</b> - auto tare status</li>
                <li><b>Access Management</b> - users, groups, privileges and security settings (administrators)</li>
                <li><b>Audit Trail</b> - who did what, with PDF export</li>
                <li><b>Change Password</b> - passwords must be 8-15 characters with upper and lower case letters, a number and a special character</li>
            </ul>
        </div>
    </div>

    <div class="bord-rad-4px shadow-custom">
        <div class="bgcol-215ED6 text-white fw-semibold font-size-18px py-2 px-3 rounded-top">Support</div>
        <div class="p-3 text-body font-size-14px col-242424">
            <p class="mb-1">Unit 1 (Mumbai): +91-9145000862</p>
            <p class="mb-0">Unit 2 / Unit 3 (Chennai): +91-44-27660534/35, Fax: 91-44-42608332</p>
        </div>
    </div>
</div>
