    <div class="bord-rad-4px shadow-custom mb-4">
        <div class="bgcol-215ED6 text-white fw-semibold font-size-18px py-2 px-3 rounded-top">Screens</div>
        <div class="p-3 text-body font-size-14px col-242424">
            <ul class="mb-0 help-screens">
                <li><a class="fw-bold text-decoration-none" href="@Url.Action("Diagnostics", "Home")">Diagnostics</a> - machine and I/O diagnostics</li>
