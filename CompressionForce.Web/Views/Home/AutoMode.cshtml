@model CompressionForce.Web.Models.AutoModeVM
@{
    ViewData["Title"] = "Auto Mode";
}

<div class="card border-0 mx-4 ps-0 pt-4">
    <ul class="nav nav-tabs row-gap-3" id="myTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active col-242424 fw-semibold" id="" data-bs-toggle="tab" data-bs-target="#forceGraphData" type="button" role="tab" aria-controls="forceGraphData" aria-selected="true">Force Graph and Data</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link col-242424 fw-semibold" id="" data-bs-toggle="tab" data-bs-target="#viewParameters" type="button" role="tab" aria-controls="viewParameters" aria-selected="false">View Parameters</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link col-242424 fw-semibold" id="contact-tab" data-bs-toggle="tab" data-bs-target="#fillCamGuide" type="button" role="tab" aria-controls="fillCamGuide" aria-selected="false">Fill Cam Guide</button>
        </li>
    </ul>
    <div class="tab-content" id="">

        <!--Force Parameters-->
        <div class="tab-pane pt-3 fade show active" id="forceGraphData" role="tabpanel" aria-labelledby="home-tab" tabindex="0">

            <!-- Table 1 -->
            <div class="table-responsive bord-top-rad-4px mb-3">
                <table class="table table-bordered mb-1">
                    <thead class="table-primary">
                        <tr>
                            <th class="text-center text-nowrap fw-semibold">Product Name</th>
                            <th class="text-center text-nowrap fw-semibold">Batch Number</th>
                            <th class="text-center text-nowrap fw-semibold">Batch Qty</th>
                            <th class="text-center text-nowrap fw-semibold">Good-S1</th>
                            <th class="text-center text-nowrap fw-semibold">Rejected-S1</th>
                            <th class="text-center text-nowrap fw-semibold">Total-S1</th>
                            <th class="text-center text-nowrap fw-semibold">Good-S2</th>
                            <th class="text-center text-nowrap fw-semibold">Rejected-S2</th>
                            <th class="text-center text-nowrap fw-semibold">Total-S2</th>
                        </tr>
                    </thead>

                    <tbody>
                        <tr>
                            <!-- Product Name -->
                            <td class="text-center fw-normal" id="am-product">@Model?.ProductName</td>

                            <!-- Batch Number -->
                            <td class="text-center fw-normal" id="am-batch">@Model?.BatchNumber</td>

                            <!-- Batch Quantity -->
                            <td class="text-center fw-normal" id="am-batchqty">@Model?.BatchQty</td>

                            <!-- Station 1 -->
                            <td class="bgcol-34C639 text-center fw-normal" id="am-good-s1">@Model?.GoodS1</td>
                            <td class="bgcol-FF441F text-center fw-normal" id="am-rej-s1">@Model?.RejectedS1</td>
                            <td class="bgcol-81D4FA text-center fw-normal" id="am-total-s1">@Model?.TotalS1</td>

                            <!-- Station 2 -->
                            <td class="bgcol-34C639 text-center fw-normal" id="am-good-s2">@Model?.GoodS2</td>
                            <td class="bgcol-FF441F text-center fw-normal" id="am-rej-s2">@Model?.RejectedS2</td>
                            <td class="bgcol-81D4FA text-center fw-normal" id="am-total-s2">@Model?.TotalS2</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Table 2 (add ids to cells we will update from PLC) -->
            <section class="d-flex flex-lg-nowrap flex-wrap">
                <div class="table-responsive w-100 bord-top-rad-4px">
                    <table class="table table-bordered">
                        <thead class="table-primary ">
                            <tr>
                                <th scope="col" class="text-center text-nowrap table-width fw-semibold">Avg. Main-1</th>
                                <th scope="col" class="text-center text-nowrap table-width fw-semibold">Avg. Pre-1</th>
                                <th scope="col" class="text-center text-nowrap table-width fw-semibold">Avg. Eject-1</th>
                                <th scope="col" class="text-center text-nowrap table-width fw-semibold">Avg. Main-2</th>
                                <th scope="col" class="text-center text-nowrap table-width fw-semibold ">Avg. Pre-2</th>
                                <th scope="col" class="text-center text-nowrap table-width fw-semibold">Avg. Eject-2</th>
                                <th scope="col" class="text-center text-nowrap table-width fw-semibold">Dwell Time</th>

                                <th scope="col" class="text-center text-nowrap table-width fw-semibold">Total Qty</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <th scope="row" class="invisible">Product</th>
                                <td class="text-center fw-normal" id="am-avg-main1">@Model?.AvgMain1</td>
                                <td class="text-center fw-normal" id="am-avg-pre1">@Model?.AvgPre1</td>
                                <td class="bgcol-34C639 text-center fw-normal" id="am-avg-eject1">@Model?.AvgEject1</td>
                                <td class="bgcol-FF441F text-center fw-normal" id="am-avg-main2">@Model?.AvgMain2</td>
                                <td class="bgcol-81D4FA text-center fw-normal" id="am-avg-pre2">@Model?.AvgPre2</td>
                                <td class="bgcol-34C639 text-center fw-normal" id="am-dwell">@Model?.DwellTime</td>

                                <td class="bgcol-81D4FA text-center fw-normal" id="am-totalqty">@Model?.TotalQty</td>

                            </tr>
                        </tbody>
                    </table>
                </div>



                <!--Buttons-->
                <div class="d-block ms-lg-4 ms-0 mt-lg-0 mt-3">
                    <div class="d-flex gap-2 mb-3">
                        <button class="btn btn-primary bgcol-81D4FA me-auto fw-semibold col-242424 w-132px h-30px" type="button" id="btn-awc-value"><p class="mb-0 position-relative bottom-4px">AWC Value</p></button>
                        <button class="btn btn-primary bgcol-FFA29A fw-semibold col-242424 w-132px h-30px" type="button" id="btn-door-interlock"><p class="mb-0 position-relative bottom-4px">Door Interlock</p></button>
                        <button class="btn btn-primary bgcol-FFAB36 fw-semibold col-242424 w-132px h-30px" type="button" id="btn-counter"><p class="mb-0 position-relative bottom-4px">Counter</p></button>
                    </div>

                    <div class="d-flex gap-2 mb-3">
                        <button class="btn btn-primary bgcol-34C639 me-auto fw-semibold w-132px col-242424 h-30px" type="button" id="btn-run-status"><p class="mb-0 position-relative bottom-4px">Run</p></button>
                        <button class="btn btn-primary bgcol-F38B46 fw-semibold w-132px col-242424 h-30px" type="button" id="btn-ready-status"><p class="mb-0 position-relative bottom-4px">Ready</p></button>
                        <button class="btn btn-primary bgcol-F597F2 fw-semibold w-132px col-242424 h-30px" type="button" id="btn-alarm-status"><p class="mb-0 position-relative bottom-4px">Alarm</p></button>
                    </div>
                </div>

            </section>


            <!--Main body-->
            <div class="d-flex flex-wrap flex-xxl-nowrap justify-content-center align-items-start">

                <div class="d-flex w-100">


                    <!--vertical tabs beside the cards-->
                    <ul class="nav flex-column nav-tabs position-relative vertical-tabs" id="" role="tablist">
                        <li class="nav-item vertical-item" role="presentation">
                            <button class="nav-link vertical-nav col-242424 fw-semibold" id="" data-bs-toggle="tab" data-bs-target="#control1" type="button" role="tab" aria-controls="control1" aria-selected="false">Control-1</button>
                        </li>
                        <li class="nav-item vertical-item" role="presentation">
                            <button class="nav-link active vertical-nav col-242424 fw-semibold" id="" data-bs-toggle="tab" data-bs-target="#control2" type="button" role="tab" aria-controls="control2" aria-selected="true">Control-2</button>
                        </li>
                        <li class="nav-item vertical-item" role="presentation">
                            <button class="nav-link vertical-nav col-242424 fw-semibold" id="" data-bs-toggle="tab" data-bs-target="#forceGraph" type="button" role="tab" aria-controls="forceGraph" aria-selected="false">Force Graph</button>
                        </li>
                        <li class="nav-item vertical-item" role="presentation">
                            <button class="nav-link vertical-nav col-242424 fw-semibold" id="" data-bs-toggle="tab" data-bs-target="#alarm" type="button" role="tab" aria-controls="alarm" aria-selected="false">Alarm</button>
                        </li>
                    </ul>

                    <div class="d-flex flex-wrap flex-lg-nowrap w-100">
                        <div class="tab-content w-100">
                            <!--Control-1-->
                            <div class="tab-pane pt-3 fade me-3" id="control1" role="tabpanel" aria-labelledby="control1" tabindex="0">
                                <section class="d-flex">
                                    <!--Left side section-->
                                    <div class="">
                                        <div class="p-3 bgcol-E9EFFB w-100">
                                            <!--horizontal tabs inside the card-->
                                            <ul class="nav nav-tabs row-gap-3 position-relative ms-1" id="control1Tabs" role="tablist">
                                                <li class="nav-item" role="presentation">
                                                    <button class="nav-link active col-242424 fw-semibold" data-bs-toggle="tab" data-bs-target="#s1ControlPane" type="button" role="tab" aria-selected="true">S1 Control</button>
                                                </li>
                                                <li class="nav-item" role="presentation">
                                                    <button class="nav-link col-242424 fw-semibold" data-bs-toggle="tab" data-bs-target="#s2ControlPane" type="button" role="tab" aria-selected="false">S2 Control</button>
                                                </li>
                                                <li class="nav-item" role="presentation">
                                                    <button class="nav-link col-242424 fw-semibold" data-bs-toggle="tab" data-bs-target="#torquePane" type="button" role="tab" aria-selected="false">Torque</button>
                                                </li>
                                            </ul>

                                            <div class="tab-content">
                                                <!--S1 Control Pane-->
                                                <div class="tab-pane pt-3 fade show active" id="s1ControlPane" role="tabpanel" tabindex="0">
                                                    <div class="row s1-card-container g-3">

                                                        <!--========== Card 1: S1 Fill Depth ==========-->
                                                        <div class="col-md-12 col-xl-4 d-flex">
                                                            <div class="card box-shadow-1 card-filldepth d-flex flex-column w-100">
                                                                <h5 class="card-title col-FFFFFF bord-top-rad-4px mb-0">S1 Fill Depth</h5>
                                                                <div class="card-body d-flex flex-column p-3 bord-rad-4px">

                                                                    <!--Die Fill + Recipe Value-->
                                                                    <div class="d-flex gap-2 align-items-end mb-2">
                                                                        <button class="btn btn-primary bgcol-8434C6 fw-semibold h-30px me-auto" type="button">
                                                                            <p class="mb-0 bottom-4px position-relative">Die Fill</p>
                                                                        </button>
                                                                        <div>
                                                                            <label class="font-size-12px d-block fw-semibold text-end">Recipe Value</label>
                                                                            <div class="d-flex align-items-center bord-col-215ED6 rounded px-2 py-1 h-29px min-width-70 w-70px">
                                                                                <div class="d-flex flex-column me-1 row-gap-1">
                                                                                    <button class="btn btn-sm arrow-btns p-0" onclick="adjustRecipeValue('c1-die-fill-recipe',0.10)"><img src="/images/up arrow.svg"></button>
                                                                                    <button class="btn btn-sm arrow-btns p-0" onclick="adjustRecipeValue('c1-die-fill-recipe',-0.10)"><img src="/images/down arrow.svg"></button>
                                                                                </div>
                                                                                <input type="text" id="c1-die-fill-recipe"
                                                                                       class="form-control arrows-text bgcol-transparent font-size-12px h-16px border-0 p-0 ps-1 fw-semibold"
                                                                                       value="0.00"
                                                                                       onchange="writeControl1Register('S1_DIE_FILL_RECIPE',this.value)">
                                                                            </div>
                                                                        </div>
                                                                    </div>

                                                                    <!--En + Fill Depth actual-->
                                                                    <div class="d-flex align-items-center gap-2 mb-2">
                                                                        <button class="btn btn-primary rounded-0 bgcol-149550 fw-semibold h-30px"
                                                                                id="c1-die-fill-en" data-active="false"
                                                                                onclick="toggleCoil('S1_DIE_FILL_EN',this)">
                                                                            <p class="mb-0 position-relative bottom-4px">En</p>
                                                                        </button>
                                                                        <span class="fw-semibold font-size-12px ms-1">Fill Depth</span>
                                                                        <span class="fw-semibold font-size-12px bgcol-81D4FA col-215ED6 px-2 py-1 rounded" id="c1-s1-fill-depth-pos">0.000</span>
                                                                        <span class="fw-semibold font-size-12px">mm</span>
                                                                    </div>

                                                                    <!--Vertical Scale-->
                                                                    <div class="d-flex c1-vscale-wrapper my-1">
                                                                        <div class="c1-vscale">
                                                                            <div class="c1-vscale-row"><span class="c1-vscale-label">1</span></div>
                                                                            <div class="c1-vscale-row"><span class="c1-vscale-label">2.5</span></div>
                                                                            <div class="c1-vscale-row"><span class="c1-vscale-label">5</span></div>
                                                                            <div class="c1-vscale-row"><span class="c1-vscale-label">7.5</span></div>
                                                                            <div class="c1-vscale-row"><span class="c1-vscale-label">10</span></div>
                                                                            <div class="c1-vscale-row"><span class="c1-vscale-label">12.5</span></div>
                                                                            <div class="c1-vscale-row"><span class="c1-vscale-label">15</span></div>
                                                                            <div class="c1-vscale-row"><span class="c1-vscale-label">17.5</span></div>
                                                                            <div class="c1-vscale-row"><span class="c1-vscale-label">20</span></div>
                                                                        </div>
                                                                        <div class="c1-vscale-track">
                                                                            <div class="c1-vscale-bar" id="c1-bar-fill" style="height:0%;"></div>
                                                                        </div>
                                                                    </div>

                                                                    <!--S1 Select Fill Cam-->
                                                                    <div class="d-flex mt-auto align-items-center pt-2">
                                                                        <p class="mb-0 me-auto fw-semibold font-size-12px">S1 Select Fill Cam</p>
                                                                        <div class="d-flex h-30px toolTypeDropdown batchDropdown position-relative">
                                                                            <input type="text" class="form-control bg-white flex-grow-1 dropdownInput bord-D2D2D2 font-size-12px" value="15" readonly>
                                                                            <button type="button" class="border-0 bgcol-215ED6 flex-shrink-0 text-white dropdown-toggle dropdown-toggle-split dropdown-btn"
                                                                                    data-bs-toggle="dropdown">
                                                                                <span class="visually-hidden">Toggle</span>
                                                                            </button>
                                                                            <ul class="dropdown-menu dropdown-menu-end">
                                                                                <li><a class="dropdown-item" href="#">10</a></li>
                                                                                <li><a class="dropdown-item" href="#">15</a></li>
                                                                                <li><a class="dropdown-item" href="#">20</a></li>
                                                                            </ul>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <!--========== Card 2: S1 Pre Thickness ==========-->
                                                        <div class="col-md-12 col-xl-4 d-flex">
                                                            <div class="card box-shadow-1 card-filldepth d-flex flex-column w-100">
                                                                <h5 class="card-title col-FFFFFF bord-top-rad-4px mb-0">S1 Pre Thickness</h5>
                                                                <div class="card-body d-flex flex-column p-3 bord-rad-4px">

                                                                    <!--Pre Penetration + Recipe Value-->
                                                                    <div class="d-flex gap-2 align-items-end mb-2">
                                                                        <button class="btn btn-primary bgcol-8434C6 fw-semibold h-30px me-auto" type="button">
                                                                            <p class="mb-0 bottom-4px position-relative">Pre Penetration</p>
                                                                        </button>
                                                                        <div>
                                                                            <label class="font-size-12px d-block fw-semibold text-end">Recipe Value</label>
                                                                            <div class="d-flex align-items-center bord-col-215ED6 rounded px-2 py-1 h-29px min-width-70 w-70px">
                                                                                <div class="d-flex flex-column me-1 row-gap-1">
                                                                                    <button class="btn btn-sm arrow-btns p-0" onclick="adjustRecipeValue('c1-pre-pen-recipe',0.10)"><img src="/images/up arrow.svg"></button>
                                                                                    <button class="btn btn-sm arrow-btns p-0" onclick="adjustRecipeValue('c1-pre-pen-recipe',-0.10)"><img src="/images/down arrow.svg"></button>
                                                                                </div>
                                                                                <input type="text" id="c1-pre-pen-recipe"
                                                                                       class="form-control arrows-text bgcol-transparent font-size-12px h-16px border-0 p-0 ps-1 fw-semibold"
                                                                                       value="0.00"
                                                                                       onchange="writeControl1Register('S1_PRE_PEN_RECIPE',this.value)">
                                                                            </div>
                                                                        </div>
                                                                    </div>

                                                                    <!--En + Pre Penetration actual-->
                                                                    <div class="d-flex align-items-center gap-2 mb-2">
                                                                        <button class="btn btn-primary rounded-0 bgcol-FF4636 fw-semibold h-30px"
                                                                                id="c1-pre-pen-en" data-active="false"
                                                                                onclick="toggleCoil('S1_PRE_PEN_EN',this)">
                                                                            <p class="mb-0 position-relative bottom-4px">En</p>
                                                                        </button>
                                                                        <span class="fw-semibold font-size-12px ms-1">Pre Penetration</span>
                                                                        <span class="fw-semibold font-size-12px bgcol-81D4FA col-215ED6 px-2 py-1 rounded" id="c1-s1-pre-pen-pos">0.000</span>
                                                                        <span class="fw-semibold font-size-12px">mm</span>
                                                                    </div>

                                                                    <!--Vertical Scale-->
                                                                    <div class="d-flex c1-vscale-wrapper my-1">
                                                                        <div class="c1-vscale">
                                                                            <div class="c1-vscale-row"><span class="c1-vscale-label">2</span></div>
                                                                            <div class="c1-vscale-row"><span class="c1-vscale-label">4</span></div>
                                                                            <div class="c1-vscale-row"><span class="c1-vscale-label">6</span></div>
                                                                            <div class="c1-vscale-row"><span class="c1-vscale-label">8</span></div>
                                                                            <div class="c1-vscale-row"><span class="c1-vscale-label">10</span></div>
                                                                            <div class="c1-vscale-row"><span class="c1-vscale-label">12</span></div>
                                                                            <div class="c1-vscale-row"><span class="c1-vscale-label">15</span></div>
                                                                            <div class="c1-vscale-row"><span class="c1-vscale-label">20</span></div>
                                                                        </div>
                                                                        <div class="c1-vscale-track">
                                                                            <div class="c1-vscale-bar" id="c1-bar-pre" style="height:0%;"></div>
                                                                        </div>
                                                                    </div>

                                                                    <!--Pre Lower actual value-->
                                                                    <div class="d-flex align-items-center justify-content-end gap-1 mb-2">
                                                                        <span class="fw-semibold font-size-12px">Pre Lower</span>
                                                                        <span class="fw-semibold font-size-12px bgcol-81D4FA col-215ED6 px-2 py-1 rounded" id="c1-s1-pre-lower-pos">0.000</span>
                                                                        <span class="fw-semibold font-size-12px">mm</span>
                                                                    </div>

                                                                    <!--En + Pre Thickness + Recipe-->
                                                                    <div class="d-flex align-items-end gap-2 mt-auto">
                                                                        <div class="d-flex flex-column me-auto gap-1">
                                                                            <button class="btn btn-primary rounded-0 bgcol-FF4636 fw-semibold h-30px"
                                                                                    id="c1-pre-thickness-en" data-active="false"
                                                                                    onclick="toggleCoil('S1_PRE_THICKNESS_EN',this)">
                                                                                <p class="mb-0 position-relative bottom-4px">En</p>
                                                                            </button>
                                                                            <button class="btn btn-primary bgcol-8434C6 fw-semibold h-30px" type="button">
                                                                                <p class="mb-0 bottom-4px position-relative">Pre Thickness</p>
                                                                            </button>
                                                                        </div>
                                                                        <div>
                                                                            <label class="font-size-12px d-block fw-semibold text-end">Recipe Value</label>
                                                                            <div class="d-flex align-items-center bord-col-215ED6 rounded px-2 py-1 h-29px min-width-70 w-70px">
                                                                                <div class="d-flex flex-column me-1 row-gap-1">
                                                                                    <button class="btn btn-sm arrow-btns p-0" onclick="adjustRecipeValue('c1-pre-thickness-recipe',0.10)"><img src="/images/up arrow.svg"></button>
                                                                                    <button class="btn btn-sm arrow-btns p-0" onclick="adjustRecipeValue('c1-pre-thickness-recipe',-0.10)"><img src="/images/down arrow.svg"></button>
                                                                                </div>
                                                                                <input type="text" id="c1-pre-thickness-recipe"
                                                                                       class="form-control arrows-text bgcol-transparent font-size-12px h-16px border-0 p-0 ps-1 fw-semibold"
                                                                                       value="0.00"
                                                                                       onchange="writeControl1Register('S1_PRE_THICKNESS_RECIPE',this.value)">
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <!--========== Card 3: S1 Pre Thickness (Main) ==========-->
                                                        <div class="col-md-12 col-xl-4 d-flex">
                                                            <div class="card box-shadow-1 card-filldepth d-flex flex-column w-100">
                                                                <h5 class="card-title col-FFFFFF bord-top-rad-4px mb-0">S1 Pre Thickness</h5>
                                                                <div class="card-body d-flex flex-column p-3 bord-rad-4px">

                                                                    <!--Main Penetration + Recipe Value-->
                                                                    <div class="d-flex gap-2 align-items-end mb-2">
                                                                        <button class="btn btn-primary bgcol-8434C6 fw-semibold h-30px me-auto" type="button">
                                                                            <p class="mb-0 bottom-4px position-relative">Main Penetration</p>
                                                                        </button>
                                                                        <div>
                                                                            <label class="font-size-12px d-block fw-semibold text-end">Recipe Value</label>
                                                                            <div class="d-flex align-items-center bord-col-215ED6 rounded px-2 py-1 h-29px min-width-70 w-70px">
                                                                                <div class="d-flex flex-column me-1 row-gap-1">
                                                                                    <button class="btn btn-sm arrow-btns p-0" onclick="adjustRecipeValue('c1-main-pen-recipe',0.10)"><img src="/images/up arrow.svg"></button>
                                                                                    <button class="btn btn-sm arrow-btns p-0" onclick="adjustRecipeValue('c1-main-pen-recipe',-0.10)"><img src="/images/down arrow.svg"></button>
                                                                                </div>
                                                                                <input type="text" id="c1-main-pen-recipe"
                                                                                       class="form-control arrows-text bgcol-transparent font-size-12px h-16px border-0 p-0 ps-1 fw-semibold"
                                                                                       value="0.00"
                                                                                       onchange="writeControl1Register('S1_MAIN_PEN_RECIPE',this.value)">
                                                                            </div>
                                                                        </div>
                                                                    </div>

                                                                    <!--En + Main Pen actual-->
                                                                    <div class="d-flex align-items-center gap-2 mb-2">
                                                                        <button class="btn btn-primary rounded-0 bgcol-FF4636 fw-semibold h-30px"
                                                                                id="c1-main-pen-en" data-active="false"
                                                                                onclick="toggleCoil('S1_MAIN_PEN_EN',this)">
                                                                            <p class="mb-0 position-relative bottom-4px">En</p>
                                                                        </button>
                                                                        <span class="fw-semibold font-size-12px ms-1">Pre Penetration</span>
                                                                        <span class="fw-semibold font-size-12px bgcol-81D4FA col-215ED6 px-2 py-1 rounded" id="c1-s1-main-pen-pos">0.000</span>
