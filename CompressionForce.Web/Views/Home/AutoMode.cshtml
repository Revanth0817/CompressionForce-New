<!-- ADD THIS AT THE TOP, BEFORE OTHER SCRIPTS -->
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.0/dist/browser/signalr.min.js"></script>


    <!-- ===== 1. PLC Write Helpers — MUST be defined first ===== -->
    <script>
        async function writeCoil(tagKey, value) {
            try {
                await fetch('/api/PlcWrite/coil', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ tagKey: tagKey, value: value })
                });
            } catch (e) { console.error('❌ writeCoil:', e); }
        }

        async function writeRegister(tagKey, value) {
            try {
                await fetch('/api/PlcWrite/register', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ tagKey: tagKey, value: parseInt(value) || 0 })
                });
            } catch (e) { console.error('❌ writeRegister:', e); }
        }

        async function writeControl2Register(tagKey, value) {
            await writeRegister(tagKey, parseInt(value) || 0);
        }

        async function writeControl1Register(tagKey, value) {
            const intValue = Math.round((parseFloat(value) || 0) * 1000);
            await writeRegister(tagKey, intValue);
        }

        async function jogButtonClick(tagKey) {
            await writeCoil(tagKey, true);
            setTimeout(() => writeCoil(tagKey, false), 500);
        }

        async function toggleCoil(tagKey, btnElement) {
            const isActive = btnElement.dataset.active === "true";
            const newValue = !isActive;
            await writeCoil(tagKey, newValue);
            btnElement.dataset.active = newValue.toString();
            if (newValue) {
                btnElement.style.setProperty("background-color", "#149550", "important");
                btnElement.style.setProperty("opacity", "1", "important");
            } else {
                btnElement.style.setProperty("background-color", "#FF4636", "important");
                btnElement.style.setProperty("opacity", "0.6", "important");
            }
        }

        function adjustRecipeValue(inputId, step) {
            const input = document.getElementById(inputId);
            if (!input) return;
            let val = parseFloat(input.value) || 0;
            val = Math.max(0, val + step);
            input.value = val.toFixed(2);
            input.dispatchEvent(new Event('change'));
        }

        function updateBar(barId, posValue, maxScale) {
            const bar = document.getElementById(barId);
            if (bar) bar.style.height = Math.min(100, Math.max(0, (posValue / maxScale) * 100)) + "%";
        }
    </script>

    <!-- ===== 2. CDN Libraries ===== -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.0/dist/browser/signalr.min.js"></script>

    <!-- ===== 3. Force Chart ===== -->
    <script>
        const ctx = document.getElementById('forceGraphCanvas').getContext('2d');
        const forceChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: Array.from({ length: 52 }, (_, i) => i + 1),
                datasets: [
                    {
                        label: 'Compression Force',
                        data: Array(52).fill(0),
                        borderColor: '#4DA3FF',
                        borderWidth: 2,
                        tension: 0.3,
                        pointRadius: 0
                    },
                    {
                        label: 'Upper Limit',
                        data: Array(52).fill(6),
                        borderColor: '#FF4D4F',
                        borderWidth: 1,
                        borderDash: [6, 6],
                        pointRadius: 0
                    },
                    {
                        label: 'Lower Limit',
                        data: Array(52).fill(4),
                        borderColor: '#52C41A',
                        borderWidth: 1,
                        borderDash: [6, 6],
                        pointRadius: 0
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                animation: false,
                plugins: { legend: { display: false } },
                scales: {
                    x: {
                        title: { display: true, text: 'Punch Tool', color: '#FFFFFF' },
                        ticks: { color: '#FFFFFF' },
                        grid: { color: 'rgba(255,255,255,0.1)' }
                    },
                    y: {
                        min: 0, max: 50,
                        title: { display: true, text: 'Load Force', color: '#FFFFFF' },
                        ticks: { color: '#FFFFFF' },
                        grid: { color: 'rgba(255,255,255,0.1)' }
                    }
                }
            }
        });
    </script>

    <!-- ===== 4. SignalR Connection + All Handlers ===== -->
    <script>
        let connection;

        if (typeof signalR === 'undefined') {
            console.error("❌ SignalR library not loaded!");
        } else {
            connection = new signalR.HubConnectionBuilder()
                .withUrl("/servoHub")
                .withAutomaticReconnect()
                .build();

            // ── TagUpdated ──────────────────────────────────────────
            connection.on("TagUpdated", function (key, value) {

                // Tables (top section)
                const tableMap = {
                    GOOD_S1: "am-good-s1", REJECTED_S1: "am-rej-s1", TOTAL_S1: "am-total-s1",
                    GOOD_S2: "am-good-s2", REJECTED_S2: "am-rej-s2", TOTAL_S2: "am-total-s2",
                    AVG_MAIN_S1: "am-avg-main1", AVG_PRE_S1: "am-avg-pre1", AVG_EJECT_S1: "am-avg-eject1",
                    AVG_MAIN_S2: "am-avg-main2", AVG_PRE_S2: "am-avg-pre2", AVG_EJECT_S2: "am-avg-eject2",
                    DWELL_TIME: "am-dwell", TOTAL_QTY: "am-totalqty", AWC_VALUE: "am-awc-value"
                };
                if (tableMap[key]) {
                    const el = document.getElementById(tableMap[key]);
                    if (el) el.innerText = value;
                }

                // Control-1 recipe/limit inputs (stored as int * 1000)
                const c1Map = {
                    S1_REJ_UPPER_LIMIT: "c1-s1-rej-upper",
                    S1_AWC_UPPER_LIMIT: "c1-s1-awc-upper",
                    S1_AWC_SET_POINT:   "c1-s1-awc-setpoint",
                    S1_AWC_LOWER_LIMIT: "c1-s1-awc-lower",
                    S1_REJ_LOWER_LIMIT: "c1-s1-rej-lower",
                    S2_REJ_UPPER_LIMIT: "c1-s2-rej-upper",
                    S2_AWC_UPPER_LIMIT: "c1-s2-awc-upper",
                    S2_AWC_SET_POINT:   "c1-s2-awc-setpoint",
                    S2_AWC_LOWER_LIMIT: "c1-s2-awc-lower",
                    S2_REJ_LOWER_LIMIT: "c1-s2-rej-lower",
                    S1_DIE_FILL_RECIPE:      "c1-die-fill-recipe",
                    S1_PRE_PEN_RECIPE:       "c1-pre-pen-recipe",
                    S1_PRE_THICKNESS_RECIPE: "c1-pre-thickness-recipe",
                    S1_MAIN_PEN_RECIPE:      "c1-main-pen-recipe",
                    S1_MAIN_THICKNESS_RECIPE:"c1-main-thickness-recipe"
                };
                if (c1Map[key]) {
                    const el = document.getElementById(c1Map[key]);
                    if (el) el.value = (parseInt(value) / 1000).toFixed(2);
                }
            });

            // ── DigitalInputUpdated ─────────────────────────────────
            connection.on("DigitalInputUpdated", function (key, value) {

                const opacityMap = {
                    DOOR_INTERLOCK: "btn-door-interlock",
                    RUN_STATUS:     "btn-run-status",
                    READY_STATUS:   "btn-ready-status",
                    ALARM_STATUS:   "btn-alarm-status"
                };
                if (opacityMap[key]) {
                    const el = document.getElementById(opacityMap[key]);
                    if (el) el.style.opacity = value ? "1" : "0.5";
                    return;
                }

                const statusMap = {
                    S1_SAMPLE_VALVE_STATUS: "s1-sample-valve-status",
                    S1_MOTOR_LUBE_STATUS:   "s1-motor-lube-status",
                    S2_SAMPLE_VALVE_STATUS: "s2-sample-valve-status",
                    S2_MOTOR_LUBE_STATUS:   "s2-motor-lube-status"
                };
                if (statusMap[key]) {
                    const btn = document.getElementById(statusMap[key]);
                    if (btn) {
                        btn.innerText = value ? "On" : "Off";
                        btn.style.setProperty("background-color", value ? "#34C639" : "#47494A", "important");
                        btn.style.setProperty("color", "white", "important");
                    }
                    return;
                }

                handleAlarmUpdate(key, value);
            });

            // ── AnalogInputUpdated ──────────────────────────────────
            connection.on("AnalogInputUpdated", function (key, v1, v2) {
                // Reserved for future analog display
            });

            // ── ServoStatusUpdated ──────────────────────────────────
            connection.on("ServoStatusUpdated", function (servoCode, ready, alarm, torque, actPos) {
                const pos = actPos / 1000;

                // S1 Fill Depth
                if (servoCode === "S1_Fill_Depth_Servo-1") {
                    const el = document.getElementById("c1-s1-fill-depth-pos");
                    if (el) el.innerText = pos.toFixed(3);
                    updateBar("c1-bar-fill", pos, 20);
                }
                // S1 Pre Penetration
                if (servoCode === "S1_Pre_Penetration_Servo-6") {
                    const el = document.getElementById("c1-s1-pre-pen-pos");
                    if (el) el.innerText = pos.toFixed(3);
                    updateBar("c1-bar-pre", pos, 20);
                }
                // S1 Pre Lower
                if (servoCode === "S1_Pre_Lower_Servo-5") {
                    const el = document.getElementById("c1-s1-pre-lower-pos");
                    if (el) el.innerText = pos.toFixed(3);
                }
                // S1 Main Penetration
                if (servoCode === "S1_Main_Penetration_Servo-4") {
                    const el = document.getElementById("c1-s1-main-pen-pos");
                    if (el) el.innerText = pos.toFixed(3);
                    updateBar("c1-bar-main", pos, 20);
                }
                // S1 Main Lower
                if (servoCode === "S1_Main_Lower_Servo-3") {
                    const el = document.getElementById("c1-s1-main-lower-pos");
                    if (el) el.innerText = pos.toFixed(3);
                }
            });

            // ── Start connection ────────────────────────────────────
            connection.start()
                .then(() => console.log("✅ SignalR connected"))
                .catch(err => console.error("❌ SignalR error:", err));

            connection.onreconnecting(() => console.warn("⚠️ Reconnecting..."));
            connection.onreconnected(() => console.log("✅ Reconnected"));
            connection.onclose(() => console.warn("⚠️ Connection closed"));
        }

        // ── Alarm Handler ───────────────────────────────────────────
        function handleAlarmUpdate(key, value) {
            const alarmMap = {
                EMERGENCY_PB:                  "alarm-EMERGENCY_PB",
                S1_MAIN_PENETRATION_ROLLER:    "alarm-S1_MAIN_PENETRATION_ROLLER",
                SAFETY_DOOR:                   "alarm-SAFETY_DOOR",
                S1_PRE_PENETRATION_ROLLER:     "alarm-S1_PRE_PENETRATION_ROLLER",
                TURRET_MOTOR:                  "alarm-TURRET_MOTOR",
                S2_MAIN_PENETRATION_ROLLER:    "alarm-S2_MAIN_PENETRATION_ROLLER",
                S1_FEEDER_MOTOR:               "alarm-S1_FEEDER_MOTOR",
                S2_PRE_PENETRATION_ROLLER:     "alarm-S2_PRE_PENETRATION_ROLLER",
                LUBE_MOTOR:                    "alarm-LUBE_MOTOR",
                TURRET_IN_POSITION:            "alarm-TURRET_IN_POSITION",
                S1_UPPER_CAM_IN_POSITION:      "alarm-S1_UPPER_CAM_IN_POSITION",
                S1_SCRAPPER_IN_POSITION:       "alarm-S1_SCRAPPER_IN_POSITION",
                S1_LOWER_CAM_IN_POSITION:      "alarm-S1_LOWER_CAM_IN_POSITION",
                S2_SCRAPPER_IN_POSITION:       "alarm-S2_SCRAPPER_IN_POSITION",
                S2_UPPER_CAM_IN_POSITION:      "alarm-S2_UPPER_CAM_IN_POSITION",
                LUBE_OIL_LOW_LEVEL:            "alarm-LUBE_OIL_LOW_LEVEL",
                S2_LOWER_CAM_IN_POSITION:      "alarm-S2_LOWER_CAM_IN_POSITION",
                S1_POWDER_LEVEL_SENSOR:        "alarm-S1_POWDER_LEVEL_SENSOR",
                S1_FILL_DEPTH_SERVO:           "alarm-S1_FILL_DEPTH_SERVO",
                S2_POWDER_LEVEL_SENSOR:        "alarm-S2_POWDER_LEVEL_SENSOR",
                S1_MAIN_LOWER_SERVO:           "alarm-S1_MAIN_LOWER_SERVO",
                S2_FILL_DEPTH_SERVO:           "alarm-S2_FILL_DEPTH_SERVO",
                S1_MAIN_PENETRATION_SERVO:     "alarm-S1_MAIN_PENETRATION_SERVO",
                S2_MAIN_PENETRATION_SERVO:     "alarm-S2_MAIN_PENETRATION_SERVO",
                S1_PRE_LOWER_SERVO:            "alarm-S1_PRE_LOWER_SERVO",
                S1_PRE_PENETRATION_SERVO:      "alarm-S1_PRE_PENETRATION_SERVO",
                BATCH_COMPLETED:               "alarm-BATCH_COMPLETED"
            };

            const btnId = alarmMap[key];
            if (!btnId) return;
            const btn = document.getElementById(btnId);
            if (!btn) return;

            const healthy = (value === true || value === 1);
            btn.style.setProperty("background-color", healthy ? "#34C639" : "#FF441F", "important");
            btn.style.setProperty("color", "white", "important");
        }
    </script>

}