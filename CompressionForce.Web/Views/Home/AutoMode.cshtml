<script>
    const ctx = document.getElementById('forceGraphCanvas').getContext('2d');

    const forceChart = new Chart(ctx, {
        type: 'line',
        data: {
            labels: Array.from({ length: 52 }, (_, i) => i + 1), // Punch Tool
            datasets: [
                // Actual Force (main curve)
                {
                    label: 'Compression Force',
                    data: Array(52).fill(0),
                    borderColor: '#4DA3FF',
                    borderWidth: 2,
                    tension: 0.3,
                    pointRadius: 0
                },

                // Upper Limit
                {
                    label: 'Upper Limit',
                    data: Array(52).fill(6),
                    borderColor: '#FF4D4F',
                    borderWidth: 1,
                    borderDash: [6, 6],
                    pointRadius: 0
                },

                // Lower Limit
                {
                    label: 'Lower Limit',
                    data: Array(52).fill(4),
                    borderColor: '#52C41A',
                    borderWidth: 1,
                    borderDash: [6, 6],
                    pointRadius: 0
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            animation: false,

            plugins: {
                legend: {
                    display: false
                }
            },

            scales: {
                x: {
                    title: {
                        display: true,
                        text: 'Punch Tool',
                        color: '#FFFFFF'
                    },
                    ticks: {
                        color: '#FFFFFF'
                    },
                    grid: {
                        color: 'rgba(255,255,255,0.1)'
                    }
                },
                y: {
                    min: 0,
                    max: 50,
                    title: {
                        display: true,
                        text: 'Load Force',
                        color: '#FFFFFF'
                    },
                    ticks: {
                        color: '#FFFFFF'
                    },
                    grid: {
                        color: 'rgba(255,255,255,0.1)'
                    }
                }
            }
        }
    });
</script>
