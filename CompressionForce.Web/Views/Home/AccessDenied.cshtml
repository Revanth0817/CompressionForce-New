@{ ViewData["Title"] = "Access Denied"; }

<div class="container my-5">
    <div class="bord-rad-4px shadow-custom mx-auto" style="max-width: 560px;">
        <div class="bgcol-215ED6 text-white fw-semibold font-size-18px py-2 px-3 rounded-top">Access Denied</div>
        <div class="p-4 text-body font-size-14px col-242424">
