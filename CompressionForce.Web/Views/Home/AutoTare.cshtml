@using Microsoft.AspNetCore.Html
@model CompressionForce.Services.DTOs.AutoTareVm
@{
    ViewData["Title"] = "Auto Tare";

    // nothing is shown as a measurement until the PLC has written a reading
    string Text(string value) => Model.HasData ? value : "--";
}

<div class="container-fluid border-d2d2d2 border-radius-4 p-4 m-3">
    <div class="card custom-card-height">

        <!-- HEADER -->
        <div class="card-header text-white font-size-18 fw-semibold text-center background-col-215ED6">
            Loadcell 'No Load' Offset Setting
        </div>

        <div class="card-body">
            <div id="tareStatus" class="alert d-none mx-4 mt-3 mb-0" role="alert"></div>

            <div class="p-4">

                <!-- TOP SECTION -->
                <div class="d-flex justify-content-center mb-4">
                    <div class="d-flex flex-wrap align-items-center gap-3">

                        <!-- Door Interlock (Display Only) -->
                        <button class="btn text-white font-size-14 fw-semibold custom-background-col-8434C6 border-radius-4"
                                disabled>
                            Door Interlock
                        </button>

                        <!-- Turret Start (Display Only) -->
                        <button class="btn text-white font-size-14 fw-semibold background-col-8434C6 border-radius-4"
                                disabled>
                            Turret Start
                        </button>

                        <!-- Motor Status -->
                        <div class="d-flex align-items-center">
                            <label class="font-size-14 fw-semibold col-242424 me-2">Motor Status</label>
                            <input class="form-control text-white font-size-12 fw-semibold text-center background-col-47494A border-radius-4 width-60 height-25"
                                   data-tare="motorStatus"
                                   value="@Text(Model.MotorStatus)"
                                   readonly />
                        </div>

                        <!-- Motor Trip -->
                        <div class="d-flex align-items-center">
                            <label class="font-size-14 fw-semibold col-242424 me-2">Motor Trip</label>
                            <input class="form-control text-white font-size-12 fw-semibold text-center background-col-47494A border-radius-4 width-60 height-25"
                                   data-tare="motorTrip"
                                   value="@Text(Model.MotorTrip)"
                                   readonly />
                        </div>

                        <!-- Revolutions -->
                        <div class="d-flex align-items-center">
                            <label class="font-size-14 fw-semibold col-242424 me-2">Revolutions</label>
                            <input class="form-control font-size-12 fw-semibold text-center background-col-81D4FA col-242424 border-radius-4 width-60 height-25"
                                   data-tare="revolutions"
                                   value="@Text(Model.Revolutions.ToString())"
                                   readonly />
                        </div>

                    </div>
                </div>

                <!-- LOADCELL VALUES -->
                <div class="row justify-content-center mt-1 gx-5">

                    <!-- COLUMN 1 -->
                    <div class="col-md-4">
                        @LoadCell("S1 Main Compaction Loadcell", "s1Main", Model.S1Main)
                        @LoadCell("S2 Main Compaction Loadcell", "s2Main", Model.S2Main)
                        @LoadCell("S1 Pre Compaction Loadcell", "s1Pre", Model.S1Pre)
                        @LoadCell("S2 Pre Compaction Loadcell", "s2Pre", Model.S2Pre)
                        @LoadCell("S1 Ejection Loadcell", "s1Eject", Model.S1Eject)
                        @LoadCell("S2 Ejection Loadcell", "s2Eject", Model.S2Eject)
                    </div>

                    <!-- COLUMN 2 (Mirror / Redundancy) -->
                    <div class="col-md-4">
                        @LoadCell("S1 Main Compaction Loadcell", "s1Main", Model.S1Main)
                        @LoadCell("S2 Main Compaction Loadcell", "s2Main", Model.S2Main)
                        @LoadCell("S1 Pre Compaction Loadcell", "s1Pre", Model.S1Pre)
                        @LoadCell("S2 Pre Compaction Loadcell", "s2Pre", Model.S2Pre)
                        @LoadCell("S1 Ejection Loadcell", "s1Eject", Model.S1Eject)
                        @LoadCell("S2 Ejection Loadcell", "s2Eject", Model.S2Eject)
                    </div>

                </div>
            </div>

            <!-- LAST READING -->
            <div class="container-fluid mt-4 mb-3 text-center font-size-14 col-242424" id="tareUpdated"></div>
        </div>
    </div>
</div>

@functions {
    private IHtmlContent LoadCell(string label, string key, decimal value)
    {
        var shown = Model.HasData ? value.ToString("F2") : "--";
        return new HtmlString($@"
        <div class='d-flex justify-content-between align-items-center mb-3'>
            <div class='font-size-14 fw-semibold col-242424'>{label}</div>
            <div class='d-flex align-items-center gap-2'>
                <input class='form-control col-242424 font-size-12 fw-semibold text-center border-d2d2d2 border-radius-4 width-60 height-25'
                       data-tare='{key}'
                       value='{shown}'
                       readonly />
                <span class='font-size-14 fw-semibold'>kN</span>
            </div>
        </div>");
    }
}

@section Scripts {
    <script>
    (function () {
        const STALE_AFTER_SECONDS = 10;     // the PLC normally writes every couple of seconds
        const banner = document.getElementById("tareStatus");
        const updated = document.getElementById("tareUpdated");

        function setAll(key, text) {
            document.querySelectorAll('[data-tare="' + key + '"]').forEach(i => i.value = text);
        }

        function show(message, kind) {
            if (!message) { banner.classList.add("d-none"); return; }
            banner.className = "alert alert-" + kind + " mx-4 mt-3 mb-0";
            banner.textContent = message;
        }

        function age(seconds) {
            if (seconds < 90) return Math.round(seconds) + " seconds";
            if (seconds < 5400) return Math.round(seconds / 60) + " minutes";
            return Math.round(seconds / 3600) + " hours";
        }

        function render(s) {
            if (!s.hasData) {
                ["motorStatus", "motorTrip", "revolutions", "s1Main", "s2Main", "s1Pre", "s2Pre", "s1Eject", "s2Eject"]
                    .forEach(k => setAll(k, "--"));
                show("No auto tare data has been received from the PLC yet.", "info");
                updated.textContent = "";
                return;
            }

            setAll("motorStatus", s.motorStatus);
            setAll("motorTrip", s.motorTrip);
            setAll("revolutions", s.revolutions);
            ["s1Main", "s2Main", "s1Pre", "s2Pre", "s1Eject", "s2Eject"].forEach(k => setAll(k, Number(s[k]).toFixed(2)));

            updated.textContent = "Last reading: " + new Date(s.lastUpdated).toLocaleString();
            if (s.ageSeconds > STALE_AFTER_SECONDS)
                show("These values are " + age(s.ageSeconds) + " old. The PLC may have stopped updating.", "warning");
            else
                show("", "");
        }

        async function refresh() {
            if (document.hidden) return;
            try {
                const res = await fetch("/Home/AutoTareStatus", { headers: { "Accept": "application/json" } });
                if (!res.ok) throw new Error(res.status === 403 ? "You no longer have access to this screen." : "HTTP " + res.status);
                render(await res.json());
            } catch (e) {
                show("Could not refresh the readings: " + e.message, "danger");
            }
        }

        refresh();
        setInterval(refresh, 2000);
    })();
    </script>
}
