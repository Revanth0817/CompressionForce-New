<script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.0/dist/browser/signalr.min.js"></script>

<script>
    /* ============================================================
       GLOBAL VARIABLES
    ============================================================ */
    let hub;
    let servoWriteTimers = {};


    /* ============================================================
       INITIALIZE EVERYTHING
    ============================================================ */
    document.addEventListener("DOMContentLoaded", function () {

        initializeSignalR();
        initializeServoAutoWrite();
    });


    /* ============================================================
       SIGNALR CONNECTION (SINGLE CONNECTION)
    ============================================================ */
    function initializeSignalR() {

        hub = new signalR.HubConnectionBuilder()
            .withUrl("/servoHub")
            .withAutomaticReconnect()
            .build();


        /* ---------------- DIGITAL INPUT ---------------- */
        hub.on("DigitalInputUpdated", (tagKey, value) => {

            const li = document.querySelector(
                `.diagnostics-list1[data-di='${tagKey}']`
            );

            if (!li) return;

            li.classList.remove("di-true", "di-false");
            li.classList.add(value ? "di-true" : "di-false");
        });


            hub.on("DigitalInputUpdated", (tagKey, value) => {


              const li = document.querySelector(
            `.diagnostics-list1[data-di='${tagKey}']`
        );

        if (!li) return;

        li.classList.remove("di-true", "di-false");
        li.classList.add(value ? "di-true" : "di-false");
    });

        /* ---------------- ANALOG INPUT ---------------- */
        hub.on("AnalogInputUpdated", (key, voltage, force) => {

            const v = document.querySelector(`[data-ai-voltage='${key}']`);
            const f = document.querySelector(`[data-ai-force='${key}']`);

            if (v) v.value = Number(voltage).toFixed(3);
            if (f) f.value = Number(force).toFixed(3);

            if (key === "REVOLUTION_COUNT") {
                document.getElementById("revCount").value =
                    Number(voltage).toFixed(0);
            }

            if (key === "ENCODER_ACT_COUNT") {
                document.getElementById("encoderCount").value =
                    Number(voltage).toFixed(0);
            }
        });


          hub.on("ServoStatusUpdated",
        (servoCode, ready, alarm, torque, actPos) => {

            /* ===============================
               1️⃣ SERVO MANAGEMENT PAGE
            =============================== */

            document.querySelectorAll(".servo-card").forEach(card => {

                const title = card.querySelector(".card-title");
                if (!title || title.dataset.servo !== servoCode) return;

                const torqueInput = card.querySelector(".act-torque");
                const posInput = card.querySelector(".act-pos");
                const readyRadio = card.querySelector(".ready-radio");
                const alarmRadio = card.querySelector(".alarm-radio");

                if (torqueInput) torqueInput.value = torque ?? 0;
                if (posInput) posInput.value = actPos ?? 0;
                if (readyRadio) readyRadio.checked = ready ?? false;
                if (alarmRadio) alarmRadio.checked = alarm ?? false;
            });


