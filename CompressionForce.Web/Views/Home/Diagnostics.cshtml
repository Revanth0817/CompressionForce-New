@*sample function for changing the value of counter elemant. Test for the first counter in Servo managament inside Diagnostics*@
<script>
    function changeValue(step) {
      const input = document.querySelector(".arrows-text");
      let currentValue = parseInt(input.value || 0);

      if(currentValue + step >= 0){
          input.value = currentValue + step;
      }
    }


</script>

