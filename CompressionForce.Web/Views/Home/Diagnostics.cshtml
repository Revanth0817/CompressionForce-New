<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

<script>
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/diagnosticsHub")
        .withAutomaticReconnect()
        .build();

    connection.on("DiagnosticsUpdate", function (data) {
        console.log("LIVE PLC DATA", data);

        /* =========================
           DIGITAL INPUTS (DOTS)
        ========================= */

            /* =========================
       DIGITAL INPUTS – LEFT COLUMN
    ========================= */

    setStatus("emergencyControl", data.emergencyControl);
    setStatus("doorSafety", data.doorSafety);
    setStatus("turretDriveTrip", data.turretDriveTrip);
    setStatus("lhsFeederDriveTrip", data.lhsFeederDriveTrip);
    setStatus("rhsFeederDriveTrip", data.rhsFeederDriveTrip);
    setStatus("lubeMotorTrip", data.lubeMotorTrip);

    setStatus("s1UpperCam", data.s1UpperCam);
    setStatus("s1LowerCam", data.s1LowerCam);
    setStatus("s2UpperCam", data.s2UpperCam);
    setStatus("s2LowerCam", data.s2LowerCam);

        setStatus("s1MainPenRollerPos", data.s1MainPenRollerPos);
    setStatus("s1PrePenRollerPos", data.s1PrePenRollerPos);
    setStatus("s2MainPenRollerPos", data.s2MainPenRollerPos);
    setStatus("s2PrePenRollerPos", data.s2PrePenRollerPos);

    setStatus("turretInPosition", data.turretInPosition);

    setStatus("s1ScrapperPos", data.s1ScrapperPos);
    setStatus("s2ScrapperPos", data.s2ScrapperPos);

    setStatus("rhsPowderLevel", data.rhsPowderLevel);
    setStatus("lhsPowderLevel", data.lhsPowderLevel);

    setStatus("lubeOilLow", data.lubeOilLow);


        /* =========================
           COUNTERS
        ========================= */

        setInputValue("revolutionCount", data.revolutionCount);
        setInputValue("encoderActCount", data.encoderActCount);

        /* =========================
           DIGITAL OUTPUT TOGGLES
        ========================= */

        setToggle("doS1InitialRej", data.s1InitialRej);
        setToggle("doS2InitialRej", data.s2InitialRej);
        setToggle("doS1Sample", data.s1Sample);
        setToggle("doS2Sample", data.s2Sample);
        setToggle("doS1Reject", data.s1Reject);
        setToggle("doS2Reject", data.s2Reject);
        setToggle("doLubrication", data.lubrication);
        setToggle("doRedLamp", data.redLamp);
        setToggle("doYellowLamp", data.yellowLamp);
        setToggle("doGreenLamp", data.greenLamp);
    });

    /* =========================
       HELPER FUNCTIONS
    ========================= */

    function setStatus(id, value) {
        const el = document.getElementById(id);
        if (!el) return;

        el.classList.remove("di-true", "di-false");
        el.classList.add(value ? "di-true" : "di-false");
    }

    function setInputValue(id, value) {
        const el = document.getElementById(id);
        if (el) el.value = value ?? 0;
    }
        function setToggle(id, value) {

        // Do NOT override user click while writing
        if (plcWriteLock) return;

        const el = document.getElementById(id);
        if (!el) return;

        el.checked = value === true;
    }


    connection.start()
        .then(() => console.log("✅ SignalR connected"))
        .catch(err => console.error("❌ SignalR error", err));
</script>


<script>
    function onToggleChanged(el, plcKey) {

        const value = el.checked;
        console.log("UI → PLC:", plcKey, value);

        fetch("/Diagnostics/SetOutput", {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({
                key: plcKey,
                value: value
            })
        })
        .then(res => {
            if (!res.ok) throw new Error("PLC write failed");
            console.log("✅ PLC updated");
        })
        .catch(err => {
            console.error(err);
            // rollback UI if failed
            el.checked = !value;
        });
    }
</script>
<script>
    /* =========================
       ANALOG INPUTS – FINAL
    ========================= */

    function refreshAnalogInputs() {

        fetch("/Diagnostics/GetAnalogInputs")
            .then(res => res.json())
            .then(data => {

                data.forEach(item => {

                    const vEl  = document.getElementById(`${item.key}_v`);
                    const knEl = document.getElementById(`${item.key}_kn`);

                    if (vEl) {
                        vEl.value = Number(item.voltage).toFixed(3);
                    }

                    if (knEl) {
                        knEl.value = Number(item.kn).toFixed(3);
                    }
                });
            })
            .catch(err => console.error("Analog refresh failed", err));
    }

    // ▶ Run once
    refreshAnalogInputs();

    // 🔁 Run every second
    setInterval(refreshAnalogInputs, 1000);
</script>

<script>
    function setInputValue(id, value) {
        const el = document.getElementById(id);
        if (!el) return;
        el.value = value ?? 0;
    }

    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/diagnosticsHub")
        .withAutomaticReconnect()
        .build();

    connection.on("DiagnosticsUpdate", function (data) {

        // 🔄 COUNTERS (FROM PLC)
        setInputValue("revolutionCount", data.revolutionCount);
        setInputValue("encoderActCount", data.encoderActCount);

    });

    connection.start()
        .then(() => console.log("✅ SignalR connected"))
        .catch(err => console.error("❌ SignalR error", err));
</script>




