@{
    ViewData["Title"] = "Diagnostics";
}

<div class="card border-0 mx-4 ps-0 pt-4">
    <ul class="nav nav-tabs row-gap-3" id="myTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active col-242424 fw-semibold" id="" data-bs-toggle="tab" data-bs-target="#home-tab-pane" type="button" role="tab" aria-controls="home-tab-pane" aria-selected="true">Input & Output</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link col-242424 fw-semibold" id="" data-bs-toggle="tab" data-bs-target="#profile-tab-pane" type="button" role="tab" aria-controls="profile-tab-pane" aria-selected="false">Servo Management</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link col-242424 fw-semibold" id="" data-bs-toggle="tab" data-bs-target="#contact-tab-pane" type="button" role="tab" aria-controls="contact-tab-pane" aria-selected="false">Signal Monitoring</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link col-242424 fw-semibold" id="" data-bs-toggle="tab" data-bs-target="#disabled-tab-pane" type="button" role="tab" aria-controls="disabled-tab-pane" aria-selected="false">Servo Home & Retrieve Setting</button>
        </li>
    </ul>


    <div class="tab-content" id="">

        <!--Input & Output-->
        <div class="tab-pane pt-3 fade show active" id="home-tab-pane" role="tabpanel" aria-labelledby="home-tab" tabindex="0">
            <div class="row row-cols-1 row-cols-lg-2 g-4">

                <!--Card 1-->
                <div class="col-lg-7">
                    <div class="card box-shadow-1">

                        <div class="card-body p-0 bord-rad-4px">
                            <h5 class="card-title col-FFFFFF bord-top-rad-4px">Digital Inputs</h5>
                            <div class="d-sm-flex px-4 pt-3">
                                <ul class="list-group list-group-flush row-gap-16px mb-3 w-50 media-w-50">
                                    <li data-di="DI_EMERGENCY" class="diagnostics-list1 fw-semibold d-flex align-items-center di-false">
                                        
                                        Emergency Control
                                    </li>

                                    <li data-di="DI_DOOR_SAFETY" class="diagnostics-list1 fw-semibold d-flex align-items-center di-false">Door Safety</li>
                                    <li data-di="DI_TURRET_DRIVE_TRIP" class="diagnostics-list1 fw-semibold d-flex align-items-center di-false">Turret Drive Trip</li>
                                    <li data-di="DI_LHS_FEEDER_DRIVE_TRIP" class="diagnostics-list1 fw-semibold d-flex align-items-center di-false">LHS Feeder Drive Trip</li>
                                    <li data-di="DI_RHS_FEEDER_DRIVE_TRIP" class="diagnostics-list1 fw-semibold d-flex align-items-center di-false">RHS Feeder Drive Trip</li>
                                    <li data-di="DI_LUBE_MOTOR_TRIP" class="diagnostics-list1 fw-semibold d-flex align-items-center di-false">Lube Motor Trip</li>
                                    <li data-di="DI_S1UPPER_CAM" class="diagnostics-list1 fw-semibold d-flex align-items-center di-false">S1 Upper Cam in Position</li>
                                    <li data-di="DI_S1LOWER_CAM" class="diagnostics-list1 fw-semibold d-flex align-items-center di-false">S1 Lower Cam in Position</li>
                                    <li data-di="DI_S2UPPER_CAM" class="diagnostics-list1 fw-semibold d-flex align-items-center di-false">S2 Upper Cam in Position</li>
                                    <li data-di="DI_S2LOWER_CAM" class="diagnostics-list1 fw-semibold d-flex align-items-center di-false">S2 Lower Cam in Position</li>

                                </ul>

                                <ul class="list-group list-group-flush row-gap-16px mb-3 w-50 media-w-50">
                                    <li data-di="DI_S1MAINPEN" class="diagnostics-list1 fw-semibold d-flex align-items-center di-false">S1 Main Penetration Roller in Position</li>
                                    <li data-di="DI_S1PREPEN" class="diagnostics-list1 fw-semibold d-flex align-items-center di-false">S1 Pre Penetration Roller in Position</li>
                                    <li data-di="DI_S2MAINPEN" class="diagnostics-list1 fw-semibold d-flex align-items-center di-false">S2 Main Penetration Roller in Position</li>
                                    <li data-di="DI_S2PREPEN" class="diagnostics-list1 fw-semibold d-flex align-items-center di-false">S2 Pre Penetration Roller in Position</li>
                                    <li data-di="DI_TURRETINPOSITION" class="diagnostics-list1 fw-semibold d-flex align-items-center di-false">Turret in Position</li>
                                    <li data-di="DI_S1SCRAPPER" class="diagnostics-list1 fw-semibold d-flex align-items-center di-false">S1 Scrapper in Position</li>
                                    <li data-di="DI_S2SCRAPPER" class="diagnostics-list1 fw-semibold d-flex align-items-center di-false">S2 Scrapper in Position</li>
                                    <li data-di="DI_RHSPOWDER" class="diagnostics-list1 fw-semibold d-flex align-items-center di-false">RHS Powder Level Sensor</li>
                                    <li data-di="DI_LHSPOWDER" class="diagnostics-list1 fw-semibold d-flex align-items-center di-false">LHS Powder Level Sensor</li>
                                    <li data-di="DI_LUBEOIL" class="diagnostics-list1 fw-semibold d-flex align-items-center di-false">Lube Oil Low</li>

                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <!--Card 2-->
                <div class="col-lg-5">
                    <div class="card box-shadow-1 h-100">

                        <div class="card-body  p-0 bord-rad-4px">
                            <h5 class="card-title col-FFFFFF bord-top-rad-4px">Digital Outputs</h5>
                            <ul class="list-group list-group-flush row-gap-16px px-4 py-3">

                                @{
                                    var digitalOutputs = new Dictionary<string, string>
                                                                {
                                                                { "DO_S1_INIT_REJ", "S1 Initial Rej. Valve" },
                                                                { "DO_S2_INIT_REJ", "S2 Initial Rej. Valve" },
                                                                { "DO_S1_SAMPLE",  "S1 Sample Valve" },
                                                                { "DO_S2_SAMPLE",  "S2 Sample Valve" },
                                                                { "DO_S1_REJ",     "S1 Rejection Valve" },
                                                                { "DO_S2_REJ",     "S2 Rejection Valve" },
                                                                { "DO_LUBE",       "Lubrication" },
                                                                { "DO_RED_LAMP",   "Red Lamp" },
                                                                { "DO_YEL_LAMP",   "Yellow Lamp" },
                                                                { "DO_GRN_LAMP",   "Green Lamp" }
                                                                };
                                }

                                @foreach (var item in digitalOutputs)
                                {
                                    <li class="diagnostics-list-before">
                                        <div class="form-check form-switch diagnostics-list text-start form-check-reverse mb-0">
                                            <input class="form-check-input do-switch"
                                                   type="checkbox"
                                                   data-do="@item.Key"
                                                   onchange="writeDigitalOutput(this)">
                                            <label class="form-check-label fw-semibold">
                                                @item.Value
                                            </label>
                                        </div>
                                    </li>
                                }


                            </ul>
                        </div>
                    </div>
                </div>

                <!--Card 3-->
                <div class="col-lg-7">
                    <div class="card box-shadow-1">

                        <div class="card-body  p-0 bord-rad-4px">
                            <h5 class="card-title col-FFFFFF bord-top-rad-4px">Analog Inputs</h5>
                            <div class="card-body overflow-x-auto p-0 bord-rad-4px">


                                <div class="container analog-container px-4 py-3">
                                    <div class="row">
                                        <!-- LEFT COLUMN -->
                                        <div class="col-md-6">
                                            <!-- Header Row -->
                                            <div class="row g-2 mb-2">
                                                <div class="col-6"></div>
                                                <div class="col-3 text-center fw-semibold">kN</div>
                                                <div class="col-3 text-center fw-semibold">Volt</div>
                                            </div>

                                            <div class="row g-3 align-items-center">

                                                <div class="col-6 fw-semibold">S1 Main Loadcell</div>
                                                <div class="col-3">
                                                    <input type="text"
                                                           class="form-control form-control-sm text-center bord-col-215ED6"
                                                           data-ai-force="S1_MAIN"
                                                           value="0.000"
                                                           readonly />
                                                </div>
                                                <div class="col-3">
                                                    <input type="text"
                                                           class="form-control form-control-sm text-center bord-col-8434C6"
                                                           data-ai-voltage="S1_MAIN"
                                                           value="0.000"
                                                           readonly />
                                                </div>


                                                <div class="col-6 fw-semibold">S1 Pre Loadcell</div>
                                                <div class="col-3">
                                                    <input type="text" class="form-control form-control-sm text-center bord-col-215ED6" value="0.000">
                                                </div>
                                                <div class="col-3">
                                                    <input type="text" class="form-control form-control-sm text-center bord-col-8434C6" value="0.000">
                                                </div>

                                                <div class="col-6 fw-semibold">S2 Main Loadcell</div>
                                                <div class="col-3">
                                                    <input type="text" class="form-control form-control-sm text-center bord-col-215ED6" value="0.000">
                                                </div>
                                                <div class="col-3">
                                                    <input type="text" class="form-control form-control-sm text-center bord-col-8434C6" value="0.000">
                                                </div>

                                                <div class="col-6 fw-semibold">S2 Pre Loadcell</div>
                                                <div class="col-3">
                                                    <input type="text" class="form-control form-control-sm text-center bord-col-215ED6" value="0.000">
                                                </div>
                                                <div class="col-3">
                                                    <input type="text" class="form-control form-control-sm text-center bord-col-8434C6" value="0.000">
                                                </div>

                                            </div>
                                        </div>

                                        <!-- RIGHT COLUMN -->
                                        <div class="col-md-6">
                                            <!-- Header Row -->
                                            <div class="row g-2 mb-2">
                                                <div class="col-6"></div>
                                                <div class="col-3 right-kN text-center fw-semibold">kN</div>
                                                <div class="col-3 right-kN text-center fw-semibold">Volt</div>
                                            </div>

                                            <div class="row g-3 align-items-center">
                                                <div class="col-6 fw-semibold">S1 Eject Loadcell</div>
                                                <div class="col-3">
                                                    <input type="text" class="form-control form-control-sm text-center bord-col-215ED6" value="0.000">
                                                </div>
                                                <div class="col-3">
                                                    <input type="text" class="form-control form-control-sm text-center bord-col-8434C6" value="0.000">
                                                </div>

                                                <div class="col-6 fw-semibold">S2 Eject Loadcell</div>
                                                <div class="col-3">
                                                    <input type="text" class="form-control form-control-sm text-center bord-col-215ED6" value="0.000">
                                                </div>
                                                <div class="col-3">
                                                    <input type="text" class="form-control form-control-sm text-center bord-col-8434C6" value="0.000">
                                                </div>

                                                <div class="col-6 fw-semibold">Upper Punch Loadcell</div>
                                                <div class="col-3">
                                                    <input type="text" class="form-control form-control-sm text-center bord-col-215ED6" value="0.000">
                                                </div>
                                                <div class="col-3">
                                                    <input type="text" class="form-control form-control-sm text-center bord-col-8434C6" value="0.000">
                                                </div>

                                                <div class="col-6 fw-semibold">Lower Punch Loadcell</div>
                                                <div class="col-3">
                                                    <input type="text" class="form-control form-control-sm text-center bord-col-215ED6" value="0.000">
                                                </div>
                                                <div class="col-3">
                                                    <input type="text" class="form-control form-control-sm text-center bord-col-8434C6" value="0.000">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>

                <!--Card 4-->
                <div class="col-lg-5">
                    <div class="card box-shadow-1 h-100">

                        <div class="card-body">

                            <div class="container py-4 h-100">
                                <div class="d-flex justify-content-center h-100 ">
                                    <div class="w-100 d-flex h-100 flex-column justify-content-center ">

                                        <div class="container w-auto">
                                            <div class="row mb-3 justify-content-center">
                                                <!-- Left Label Column -->
                                                <div class="col-auto pe-2 align-self-end mb-1" style="min-width: 140px;">
                                                    <label class="fw-semibold text-nowrap">Revolution Count</label>
                                                </div>

                                                <!-- Right Input Column -->
                                                <div class="col-auto">
                                                    <input id="revCount"
                                                           type="text"
                                                           class="form-control form-control-sm text-center"
                                                           value="0.000"
                                                           style="width: 100px;"
                                                           readonly>
                                                </div>
                                            </div>

                                            <div class="row mb-3 justify-content-center">
                                                <!-- Left Label Column -->
                                                <div class="col-auto pe-2 align-self-end mb-1" style="min-width: 140px;">
                                                    <label class="fw-semibold text-nowrap">Encoder Act Count</label>
                                                </div>

                                                <!-- Right Input Column -->
                                                <div class="col-auto">

                                                    <input id="encoderCount"
                                                           type="text"
                                                           class="form-control form-control-sm text-center"
                                                           value="0.000"
                                                           style="width: 100px;"
                                                           readonly>
                                                </div>
                                            </div>
                                        </div>



                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!--Servo Management-->
        <div class="tab-pane pt-3 fade" id="profile-tab-pane" role="tabpanel" aria-labelledby="profile-tab" tabindex="0">
            <div class="servo-container">

                @{
                    // Display title → PLC servo code mapping
                    var servos = new Dictionary<string, string>
                                {
                                { "S1 Fill Depth Servo-1",        "S1_Fill_Depth_Servo-1" },
                                { "S2 Fill Depth Servo-2",        "S2_Fill_Depth_Servo-2" },
                                { "S1 Main Lower Servo-3",        "S1_Main_Lower_Servo-3" },
                                { "S1 Main Penetration Servo-4",  "S1_Main_Penetration_Servo-4" },
                                { "S1 Pre Lower Servo-5",         "S1_Pre_Lower_Servo-5" },
                                { "S1 Pre Penetration Servo-6",   "S1_Pre_Penetration_Servo-6" },
                                { "S2 Main Lower Servo-7",        "S2_Main_Lower_Servo-7" },
                                { "S2 Main Penetration Servo-8",  "S2_Main_Penetration_Servo-8" },
                                { "S1 Pre Lower Servo-9",         "S1_Pre_Lower_Servo-9" },
                                { "S2 Pre Penetration Servo-10",  "S2_Pre_Penetration_Servo-10" }
                                };
                }

                @foreach (var servo in servos)
                {
                    <div class="col">
                        <div class="card h-100 box-shadow-1 servo-card">


                            <!-- 🔥 IMPORTANT: data-servo -->
                            <h5 class="card-title col-FFFFFF bord-top-rad-4px mb-0"
                                data-servo="@servo.Value">
                                @servo.Key
                            </h5>

                            <div class="card-body p-3 bord-rad-4px">

                                <!--1st row-->
                                <div class="d-flex gap-2 mb-3">
                                    <button class="btn btn-primary bgcol-8434C6 me-auto fw-semibold w-100px"
                                            type="button"
                                            onclick="jogUp(this)">
                                        Jog Up
                                    </button>

                                    <button class="btn btn-primary bgcol-8434C6 fw-semibold w-100px"
                                            type="button"
                                            onclick="jogDown(this)">
                                        Jog Down
                                    </button>
                                </div>

                                <!--Counter component-->
                                <div class="row mb-3 justify-content-start w-100 position-relative counter-comp">
                                    <label for="colFormLabelSm" class="col-auto col-form-label me-auto col-form-label-sm fw-semibold">Jog Speed</label>

                                    <div class="col-sm-3 d-flex align-items-center bord-D2D2D2 rounded px-2 w-70px py-1">
                                        <div class="d-flex flex-column me-2 row-gap-1">

                                            <button class="btn btn-sm arrow-btns p-0 arrows-text-dis">
                                                <svg width="6" height="5"
                                                     viewBox="0 0 6 5"
                                                     fill="none"
                                                     xmlns="http://www.w3.org/2000/svg"
                                                     onclick="changeValue(this, 1)">
                                                    <path d="M0.706446 3.13825L2.50994 0.318397C2.57436 0.217467 2.65088 0.137392 2.73512 0.0827573C2.81936 0.0281225 2.90966 0 3.00086 0C3.09206 0 3.18236 0.0281225 3.2666 0.0827573C3.35083 0.137392 3.42735 0.217467 3.49177 0.318397L5.29527 3.13825C5.73396 3.82416 5.42061 5 4.80088 5H1.19388C0.574143 5 0.267758 3.82416 0.706446 3.13825Z" fill="#242424" />
                                                </svg>
                                            </button>



                                            <button class="btn btn-sm arrow-btns p-0 arrows-text-dis">
                                                <svg width="6" height="5"
                                                     viewBox="0 0 6 5"
                                                     fill="none"
                                                     xmlns="http://www.w3.org/2000/svg"
                                                     onclick="changeValue(this, -1)">
                                                    <path d="M5.29355 1.86175L3.49006 4.6816C3.42564 4.78253 3.34912 4.86261 3.26488 4.91724C3.18064 4.97188 3.09034 5 2.99914 5C2.90794 5 2.81764 4.97188 2.7334 4.91724C2.64917 4.86261 2.57265 4.78253 2.50823 4.6816L0.70473 1.86175C0.266041 1.17584 0.57939 0 1.19912 0H4.80612C5.42586 0 5.73224 1.17584 5.29355 1.86175Z" fill="#242424" />
                                                </svg>
                                            </button>


                                        </div>
                                        <input class="form-control arrows-text font-size-12px h-16px border-0 p-0 ps-1 text-start fw-semibold jog-speed" value="0">
                                    </div>
                                </div>

                                <!--3rd and 4th rows-->
                                <div class="row mb-3 justify-content-start w-100 position-relative counter-comp align-items-center">
                                    <label for="colFormLabelSm" class="col-4 col-form-label me-auto text-nowrap col-form-label-sm fw-semibold">Act Torque</label>
                                    <input class="form-control form-control-sm me-auto col-4 text-center w-60px bord-col-215ED6 fw-semibold act-torque" value="0" readonly>
                                    <div class="form-check col-4 form-check-reverse">
                                        <input class="form-check-input servo-radio ready-radio"
                                               type="radio"
                                               name="radio_@servo.Value">
                                        <label class="form-check-label pe-2 fw-semibold" for="radioDefault1">
                                            Ready
                                        </label>
                                    </div>
                                </div>

                                <div class="row mb-3 justify-content-start w-100 position-relative counter-comp align-items-center">
                                    <label for="colFormLabelSm" class="col-4 col-form-label me-auto col-form-label-sm fw-semibold">Act Pos.</label>
                                    <input type="text"
                                           class="form-control form-control-sm me-auto col-4 text-center w-60px
                      bord-col-215ED6 fw-semibold act-pos"
                                           value="0"
                                           readonly>

                                    <div class="form-check col-4 form-check-reverse">
                                        <input class="form-check-input servo-radio alarm-radio"
                                               type="radio"
                                               name="radio_@servo.Value">
                                        <label class="form-check-label pe-2 fw-semibold" for="radioDefault1">
                                            Alarm
                                        </label>
                                    </div>
                                </div>

                                <!--Buttons-->
                                <div class="d-flex gap-2 mb-3">
                                    <button class="btn btn-primary bgcol-81D4FA me-auto fw-semibold col-242424 w-100px enable-btn"
                                            type="button"
                                            onclick="toggleEnable(this)">
                                        Enable
                                    </button>

                                    <button class="btn btn-primary bgcol-FF441F fw-semibold w-100px"
                                            type="button"
                                            onclick="stopServo(this)">
                                        Stop
                                    </button>
                                </div>

                                <div class="d-flex gap-2 mb-3">
                                    <button class="btn btn-primary bgcol-34C63B me-auto fw-semibold w-100px"
                                            type="button"
                                            disabled
                                            onclick="runServo(this)">
                                        Run
                                    </button>
                                    <button class="btn btn-primary bgcol-81D4FA me-auto fw-semibold w-100px"
                                            type="button"
                                            onclick="saveServoCalibration(this)">
                                        Set
                                    </button>
                                    <button class="btn btn-primary bgcol-FFAB36 fw-semibold w-100px"
                                            type="button"
                                            onclick="resetServoCalibration(this)">
                                        Reset
                                    </button>
                                    
                                </div>

                                <!--Last rows-->
                                <div class="row mb-3 justify-content-start w-100 position-relative counter-comp">
                                    <label for="colFormLabelSm" class="col-auto col-form-label me-auto col-form-label-sm fw-semibold">Set Pos.</label>
                                    

                                    <div class="col-sm-3 d-flex align-items-center bord-D2D2D2 opacity-50 rounded px-2 w-70px py-1">
                                        <div class="d-flex flex-column me-2 row-gap-1">

                                            <button class="btn btn-sm arrow-btns p-0 arrows-text-dis">
                                                <svg width="6" height="5"
                                                     viewBox="0 0 6 5"
                                                     fill="none"
                                                     xmlns="http://www.w3.org/2000/svg"
                                                     onclick="changeValue(this, 1)">
                                                    <path d="M0.706446 3.13825L2.50994 0.318397C2.57436 0.217467 2.65088 0.137392 2.73512 0.0827573C2.81936 0.0281225 2.90966 0 3.00086 0C3.09206 0 3.18236 0.0281225 3.2666 0.0827573C3.35083 0.137392 3.42735 0.217467 3.49177 0.318397L5.29527 3.13825C5.73396 3.82416 5.42061 5 4.80088 5H1.19388C0.574143 5 0.267758 3.82416 0.706446 3.13825Z" fill="#242424" />
                                                </svg>
                                            </button>



                                            <button class="btn btn-sm arrow-btns p-0 arrows-text-dis">
                                                <svg width="6" height="5"
                                                     viewBox="0 0 6 5"
                                                     fill="none"
                                                     xmlns="http://www.w3.org/2000/svg"
                                                     onclick="changeValue(this, -1)">
                                                    <path d="M5.29355 1.86175L3.49006 4.6816C3.42564 4.78253 3.34912 4.86261 3.26488 4.91724C3.18064 4.97188 3.09034 5 2.99914 5C2.90794 5 2.81764 4.97188 2.7334 4.91724C2.64917 4.86261 2.57265 4.78253 2.50823 4.6816L0.70473 1.86175C0.266041 1.17584 0.57939 0 1.19912 0H4.80612C5.42586 0 5.73224 1.17584 5.29355 1.86175Z" fill="#242424" />
                                                </svg>
                                            </button>


                                        </div>
                                        <input class="form-control arrows-text arrows-text-dis font-size-12px h-16px border-0 p-0 ps-1 text-start fw-semibold set-pos" disabled value="0">
                                    </div>
                                </div>


                                <div class="row justify-content-start w-100 position-relative counter-comp">
                                    <label for="colFormLabelSm" class="col-auto col-form-label me-auto col-form-label-sm fw-semibold">Set Speed</label>
                                    

                                    <div class="col-sm-3 d-flex align-items-center bord-D2D2D2 opacity-50 rounded px-2 w-70px py-1">
