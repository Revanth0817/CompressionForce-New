                /* ===============================
       2️⃣ SERVO HOME & RETRIEVE PAGE
    =============================== */

    document
        .querySelectorAll("#disabled-tab-pane [data-servo]")
        .forEach(row => {

            if (row.dataset.servo !== servoCode) return;

            const readyRadio = row.querySelector(".ready-radio");
