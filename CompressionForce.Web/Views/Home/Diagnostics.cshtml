    }


    /* ============================================================
       SERVO COMMAND HELPERS
    ============================================================ */
    function getServoCode(btn) {
        const card = btn.closest(".servo-card");
        return card?.querySelector(".card-title")?.dataset?.servo ?? null;
    }

    function sendServoCommand(url, servoCode) {

        if (!servoCode) return alert("Servo mapping error");

        fetch(`${url}?servoCode=${encodeURIComponent(servoCode)}`, {
            method: "POST"
        })
        .catch(err => {
            console.error("PLC error", err);
            alert("PLC communication error");
        });
    }

    function jogUp(btn) { sendServoCommand("/ServoCalibration/JogUp", getServoCode(btn)); }
    function jogDown(btn) { sendServoCommand("/ServoCalibration/JogDown", getServoCode(btn)); }
    function runServo(btn) { sendServoCommand("/ServoCalibration/Run", getServoCode(btn)); }
    function stopServo(btn) { sendServoCommand("/ServoCalibration/Stop", getServoCode(btn)); }


    /* ============================================================
       SERVO APPLY SET VALUES (MANUAL SET BUTTON)
    ============================================================ */
    function saveServoCalibration(btn) {

        const card = btn.closest(".servo-card");
        if (!card) return;

        const servoCode = card.querySelector(".card-title")?.dataset?.servo;
        if (!servoCode) return;

        const payload = {
            servoCode: servoCode,
            setPosition: Number(card.querySelector(".set-pos")?.value ?? 0),
            setSpeed: Number(card.querySelector(".set-speed")?.value ?? 0),
            jogSpeed: Number(card.querySelector(".jog-speed")?.value ?? 0)
        };

        fetch("/ServoCalibration/ApplySet", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload)
        })
        .then(r => {
            if (!r.ok) throw new Error("PLC write failed");
            alert("✅ Values applied to PLC");
        })
        .catch(err => {
            console.error(err);
            alert("❌ PLC write failed");
        });
    }
     /* ==========================================
       LOAD LAST CALIBRATION FROM DB
    ========================================== */

    document.querySelectorAll(".servo-card").forEach(card => {

        const servoCode = card
            .querySelector(".card-title")
            ?.dataset?.servo;

        if (!servoCode) return;

        fetch(`/ServoCalibration/GetCurrentSetValues?servoCode=${encodeURIComponent(servoCode)}`)
            .then(r => {
                if (!r.ok) throw new Error("DB read failed");
                return r.json();
            })
            .then(data => {

                if (!data) return;

                const setPos = card.querySelector(".set-pos");
                const setSpeed = card.querySelector(".set-speed");
                const jogSpeed = card.querySelector(".jog-speed");
                

                if (setPos) setPos.value = data.setPosition ?? 0;
                if (setSpeed) setSpeed.value = data.setSpeed ?? 0;
                if (jogSpeed) jogSpeed.value = data.jogSpeed ?? 0;
            })
            .catch(err => {
                console.error("PLC load error:", err);
            });
    });
   


        function initializeServoAutoWrite() {

        document.querySelectorAll(".servo-card").forEach(card => {

            const servoCode = card.querySelector(".card-title")?.dataset?.servo;
            if (!servoCode) return;

            const setPos = card.querySelector(".set-pos");
            const setSpeed = card.querySelector(".set-speed");
            const jogSpeed = card.querySelector(".jog-speed");

            function writeNow() {

                const payload = {
                    servoCode: servoCode,
                    setPosition: Number(setPos?.value ?? 0),
                    setSpeed: Number(setSpeed?.value ?? 0),
                    jogSpeed: Number(jogSpeed?.value ?? 0)
                };

                fetch("/ServoCalibration/ApplySet", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(payload)
                })
                .then(r => {
                    if (!r.ok) throw new Error("PLC write failed");
                    console.log("✅ Servo values written");
                })
                .catch(err => {
                    console.error("PLC write error:", err);
                });
            }

            /* 🔥 WRITE ON CHANGE */
            setPos?.addEventListener("change", writeNow);
            setSpeed?.addEventListener("change", writeNow);
            jogSpeed?.addEventListener("change", writeNow);

            /* 🔥 WRITE ON ENTER KEY */
            [setPos, setSpeed, jogSpeed].forEach(input => {

                input?.addEventListener("keydown", function (e) {

                    if (e.key === "Enter") {

                        e.preventDefault();   // stop form submit
                        this.blur();          // remove focus
                        writeNow();           // write immediately
                    }
                });
            });
        });
    }


    /* ============================================================
       COUNTER ARROW CONTROL
    ============================================================ */
    function changeValue(btn, step) {

        const container = btn.closest(".bord-D2D2D2");
        if (!container) return;

        const input = container.querySelector("input");
        if (!input) return;

        let value = Number(input.value) || 0;
        value += step;
        if (value < 0) value = 0;

        input.value = value;
    }


    /* ============================================================
       SERVO ENABLE / DISABLE
    ============================================================ */
    function toggleEnable(btn) {

        const card = btn.closest(".servo-card");
        if (!card) return;

        const runBtn = card.querySelector("button[onclick='runServo(this)']");
        const setPos = card.querySelector(".set-pos");
        const setSpeed = card.querySelector(".set-speed");
        const jogSpeed = card.querySelector(".jog-speed");

        const enabled = btn.dataset.enabled === "true";

        if (enabled) {

            btn.innerText = "Enable";
            btn.dataset.enabled = "false";
            btn.classList.remove("bgcol-FF441F");
            btn.classList.add("bgcol-81D4FA");

            if (runBtn) runBtn.disabled = true;

            setPos.disabled = true;
            setSpeed.disabled = true;
            jogSpeed.disabled = true;

        } else {

            btn.innerText = "Disable";
            btn.dataset.enabled = "true";
            btn.classList.remove("bgcol-81D4FA");
            btn.classList.add("bgcol-FF441F");

            if (runBtn) runBtn.disabled = false;

            setPos.disabled = false;
            setSpeed.disabled = false;
            jogSpeed.disabled = false;
        }
    }
               function writeCoil(btn) {

        const tag = btn.dataset.tag;
        const isOn = btn.innerText === "ON";

        fetch("/Diagnostics/WriteTag", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
                tagKey: tag,
                value: !isOn
            })
        })
        .catch(err => {
            console.error("Coil write failed", err);
            alert("PLC write failed");
        });
    }


              function writeRegister(input) {

        const tag = input.dataset.tag;
        const value = Number(input.value);

        if (isNaN(value)) {
            alert("Invalid value");
            return;
        }

        fetch("/Diagnostics/WriteTag", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
                tagKey: tag,
                value: value
            })
        })
        .then(r => {
            if (!r.ok) throw new Error("Write failed");
        })
        .catch(err => {
            console.error("Register write failed", err);
            alert("PLC write failed");
        });
    }
                   
</script>

<script>

    document.addEventListener("DOMContentLoaded", function () {

        loadRetrieveValues();

    });


    /* =========================================
       LOAD LAST PLC SET_POS INTO RETRIEVE COLUMN
    ========================================= */
    function loadRetrieveValues() {

        document
            .querySelectorAll("#disabled-tab-pane [data-servo]")
            .forEach(row => {

                const servoCode = row.dataset.servo;

                if (!servoCode) return;

                fetch(`/ServoCalibration/GetCurrentSetValues?servoCode=${encodeURIComponent(servoCode)}`)
                    .then(r => {
                        if (!r.ok) throw new Error("PLC read failed");
                        return r.json();
                    })
                    .then(data => {

                        if (!data) return;

                        const retrieveInput = row.querySelector(".set-pos");

                        if (retrieveInput) {
                            retrieveInput.value = data.setPosition ?? 0;
                        }

                    })
                    .catch(err => {
                        console.error("Retrieve load error:", err);
                    });
            });
    }


    /* =========================================
       TURRET RETRIEVE BUTTON
       SEND RETRIEVE VALUE TO PLC
    ========================================= */
    function turretRetrieve() {

        document
            .querySelectorAll("#disabled-tab-pane [data-servo]")
            .forEach(row => {

                const servoCode = row.dataset.servo;
                const input = row.querySelector(".set-pos");

                if (!servoCode || !input) return;

                const position = Number(input.value);

                fetch(`/ServoCalibration/HomeServo?servoCode=${encodeURIComponent(servoCode)}&position=${position}`, {
                    method: "POST"
                })
                .then(r => {
                    if (!r.ok) throw new Error("PLC write failed");
                })
                .catch(err => {
                    console.error("Retrieve write error:", err);
                    alert("PLC write failed");
                });

            });
    }


    /* =========================================
       TURRET HOME BUTTON
    ========================================= */
    function turretHome() {

        document
            .querySelectorAll("#disabled-tab-pane [data-servo]")
            .forEach(row => {

                const servoCode = row.dataset.servo;

                const setHomeInput =
                    row.querySelector(".bord-col-8434C6 input");

                if (!servoCode || !setHomeInput) return;

                const position = Number(setHomeInput.value);

                fetch(`/ServoCalibration/HomeServo?servoCode=${encodeURIComponent(servoCode)}&position=${position}`, {
                    method: "POST"
                })
                .then(r => {
                    if (!r.ok) throw new Error("PLC write failed");
                })
                .catch(err => {
                    console.error("Home write error:", err);
                    alert("PLC write failed");
                });

            });
    }

