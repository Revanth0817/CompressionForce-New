@{
    ViewData["Title"] = "Diagnostics";
}
@model CompressionForce.Domain.ViewModels.DiagnosticsFixedVM


<div class="card border-0 mx-4 ps-0 pt-4">
    <ul class="nav nav-tabs row-gap-3" id="myTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active col-242424 fw-semibold" id="" data-bs-toggle="tab" data-bs-target="#home-tab-pane" type="button" role="tab" aria-controls="home-tab-pane" aria-selected="true">Input & Output</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link col-242424 fw-semibold" id="" data-bs-toggle="tab" data-bs-target="#profile-tab-pane" type="button" role="tab" aria-controls="profile-tab-pane" aria-selected="false">Servo Management</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link col-242424 fw-semibold" id="" data-bs-toggle="tab" data-bs-target="#contact-tab-pane" type="button" role="tab" aria-controls="contact-tab-pane" aria-selected="false">Signal Monitoring</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link col-242424 fw-semibold" id="" data-bs-toggle="tab" data-bs-target="#disabled-tab-pane" type="button" role="tab" aria-controls="disabled-tab-pane" aria-selected="false">Servo Home & Retrieve Setting</button>
        </li>
    </ul>


    <div class="tab-content" id="">

        <!--Input & Output-->
        <div class="tab-pane pt-3 fade show active" id="home-tab-pane" role="tabpanel" aria-labelledby="home-tab" tabindex="0">
            <div class="row row-cols-1 row-cols-lg-2 g-4">

                <!--Card 1-->
                <div class="col-lg-7">
                    <div class="card box-shadow-1">

                        <div class="card-body p-0 bord-rad-4px">
                            <h5 class="card-title col-FFFFFF bord-top-rad-4px">Digital Inputs</h5>
                            <div class="d-sm-flex px-4 pt-3">
                                <ul class="list-group list-group-flush row-gap-16px mb-3 w-50 media-w-50">

                                    <li id="emergencyControl" class="diagnostics-list1 fw-semibold d-flex align-items-center di-false">
                                        Emergency Control
                                    </li>

                                    <li id="doorSafety" class="diagnostics-list1 fw-semibold d-flex align-items-center di-false">
                                        Door Safety
                                    </li>

                                    <li id="turretDriveTrip" class="diagnostics-list1 fw-semibold d-flex align-items-center di-false">
                                        Turret Drive Trip
                                    </li>

                                    <li id="lhsFeederDriveTrip" class="diagnostics-list1 fw-semibold d-flex align-items-center di-false">
                                        LHS Feeder Drive Trip
                                    </li>

                                    <li id="rhsFeederDriveTrip" class="diagnostics-list1 fw-semibold d-flex align-items-center di-false">
                                        RHS Feeder Drive Trip
                                    </li>

                                    <li id="lubeMotorTrip" class="diagnostics-list1 fw-semibold d-flex align-items-center di-false">
                                        Lube Motor Trip
                                    </li>

                                    <li id="s1UpperCam" class="diagnostics-list1 fw-semibold d-flex align-items-center di-false">
                                        S1 Upper Cam in Position
                                    </li>

                                    <li id="s1LowerCam" class="diagnostics-list1 fw-semibold d-flex align-items-center di-false">
                                        S1 Lower Cam in Position
                                    </li>

                                    <li id="s2UpperCam" class="diagnostics-list1 fw-semibold d-flex align-items-center di-false">
                                        S2 Upper Cam in Position
                                    </li>

                                    <li id="s2LowerCam" class="diagnostics-list1 fw-semibold d-flex align-items-center di-false">
                                        S2 Lower Cam in Position
                                    </li>

                                </ul>



                                <ul class="list-group list-group-flush row-gap-16px mb-3 w-50 media-w-50">

                                    <li id="s1MainPenRollerPos" class="diagnostics-list1 fw-semibold d-flex align-items-center di-false">
                                        S1 Main Penetration Roller in Position
                                    </li>

                                    <li id="s1PrePenRollerPos" class="diagnostics-list1 fw-semibold d-flex align-items-center di-false">
                                        S1 Pre Penetration Roller in Position
                                    </li>

                                    <li id="s2MainPenRollerPos" class="diagnostics-list1 fw-semibold d-flex align-items-center di-false">
                                        S2 Main Penetration Roller in Position
                                    </li>

                                    <li id="s2PrePenRollerPos" class="diagnostics-list1 fw-semibold d-flex align-items-center di-false">
                                        S2 Pre Penetration Roller in Position
                                    </li>

                                    <li id="turretInPosition" class="diagnostics-list1 fw-semibold d-flex align-items-center di-false">
                                        Turret in Position
                                    </li>

                                    <li id="s1ScrapperPos" class="diagnostics-list1 fw-semibold d-flex align-items-center di-false">
                                        S1 Scrapper in Position
                                    </li>

                                    <li id="s2ScrapperPos" class="diagnostics-list1 fw-semibold d-flex align-items-center di-false">
                                        S2 Scrapper in Position
                                    </li>

                                    <li id="rhsPowderLevel" class="diagnostics-list1 fw-semibold d-flex align-items-center di-false">
                                        RHS Powder Level Sensor
                                    </li>

                                    <li id="lhsPowderLevel" class="diagnostics-list1 fw-semibold d-flex align-items-center di-false">
                                        LHS Powder Level Sensor
                                    </li>

                                    <li id="lubeOilLow" class="diagnostics-list1 fw-semibold d-flex align-items-center di-false">
                                        Lube Oil Low
                                    </li>

                                </ul>


                            </div>
                        </div>
                    </div>
                </div>

                <!--Card 2-->
                <div class="col-lg-5">
                    <div class="card box-shadow-1 h-100">

                        <div class="card-body  p-0 bord-rad-4px">
                            <h5 class="card-title col-FFFFFF bord-top-rad-4px">Digital Outputs</h5>
                            <ul class="list-group list-group-flush row-gap-16px px-4 py-3">

                                <li class="diagnostics-list-before">
                                    <div class="form-check form-switch diagnostics-list text-start form-check-reverse mb-0">
                                        <input id="doS1InitialRej"
                                               class="form-check-input"
                                               type="checkbox"
                                               role="switch"
                                               onchange="onToggleChanged(this, 'S1InitialReject')" />
                                        <label class="form-check-label fw-semibold">S1 Initial Rej. Valve</label>
                                    </div>
                                </li>

                                <li class="diagnostics-list-before">
                                    <div class="form-check form-switch diagnostics-list text-start form-check-reverse mb-0">
                                        <input id="doS2InitialRej"
                                               class="form-check-input"
                                               type="checkbox"
                                               role="switch"
                                               onchange="onToggleChanged(this, 'S2InitialReject')" />
                                        <label class="form-check-label fw-semibold">S2 Initial Rej. Valve</label>
                                    </div>
                                </li>

                                <li class="diagnostics-list-before">
                                    <div class="form-check form-switch diagnostics-list text-start form-check-reverse mb-0">
                                        <input id="doS1Sample"
                                               class="form-check-input"
                                               type="checkbox"
                                               role="switch"
                                               onchange="onToggleChanged(this, 'S1SampleValve')" />
                                        <label class="form-check-label fw-semibold">S1 Sample Valve</label>
                                    </div>
                                </li>

                                <li class="diagnostics-list-before">
                                    <div class="form-check form-switch diagnostics-list text-start form-check-reverse mb-0">
                                        <input id="doS2Sample"
                                               class="form-check-input"
                                               type="checkbox"
                                               role="switch"
                                               onchange="onToggleChanged(this, 'S2SampleValve')" />
                                        <label class="form-check-label fw-semibold">S2 Sample Valve</label>
                                    </div>
                                </li>

                                <li class="diagnostics-list-before">
                                    <div class="form-check form-switch diagnostics-list text-start form-check-reverse mb-0">
                                        <input id="doS1Reject"
                                               class="form-check-input"
                                               type="checkbox"
                                               role="switch"
                                               onchange="onToggleChanged(this, 'S1RejectValve')" />
                                        <label class="form-check-label fw-semibold">S1 Rejection Valve</label>
                                    </div>
                                </li>

                                <li class="diagnostics-list-before">
                                    <div class="form-check form-switch diagnostics-list text-start form-check-reverse mb-0">
                                        <input id="doS2Reject"
                                               class="form-check-input"
                                               type="checkbox"
                                               role="switch"
                                               onchange="onToggleChanged(this, 'S2RejectValve')" />
                                        <label class="form-check-label fw-semibold">S2 Rejection Valve</label>
                                    </div>
                                </li>

                                <li class="diagnostics-list-before">
                                    <div class="form-check form-switch diagnostics-list text-start form-check-reverse mb-0">
                                        <input id="doLubrication"
                                               class="form-check-input"
                                               type="checkbox"
                                               role="switch"
                                               onchange="onToggleChanged(this, 'Lubrication')" />
                                        <label class="form-check-label fw-semibold">Lubrication</label>
                                    </div>
                                </li>

                                <li class="diagnostics-list-before">
                                    <div class="form-check form-switch diagnostics-list text-start form-check-reverse mb-0">
                                        <input id="doRedLamp"
                                               class="form-check-input"
                                               type="checkbox"
                                               role="switch"
                                               onchange="onToggleChanged(this, 'RedLamp')" />
                                        <label class="form-check-label fw-semibold">Red Lamp</label>
                                    </div>
                                </li>

                                <li class="diagnostics-list-before">
                                    <div class="form-check form-switch diagnostics-list text-start form-check-reverse mb-0">
                                        <input id="doYellowLamp"
                                               class="form-check-input"
                                               type="checkbox"
                                               role="switch"
                                               onchange="onToggleChanged(this, 'YellowLamp')" />
                                        <label class="form-check-label fw-semibold">Yellow Lamp</label>
                                    </div>
                                </li>

                                <li class="diagnostics-list-before">
                                    <div class="form-check form-switch diagnostics-list text-start form-check-reverse mb-0">
                                        <input id="doGreenLamp"
                                               class="form-check-input"
                                               type="checkbox"
                                               role="switch"
                                               onchange="onToggleChanged(this, 'GreenLamp')" />
                                        <label class="form-check-label fw-semibold">Green Lamp</label>
                                    </div>
                                </li>

                            </ul>


                        </div>
                    </div>
                </div>

                <!--Card 3-->
                <div class="col-lg-7">
                    <div class="card box-shadow-1">

                        <div class="card-body  p-0 bord-rad-4px">
                            <h5 class="card-title col-FFFFFF bord-top-rad-4px">Analog Inputs</h5>
                            <div class="card-body overflow-x-auto p-0 bord-rad-4px">


                                <div class="container analog-container px-4 py-3">
                                    <div class="row">
                                        <!-- LEFT COLUMN -->
                                        <div class="col-md-6">
                                            <!-- Header Row -->
                                            <div class="row g-2 mb-2">
                                                <div class="col-6"></div>
                                                <div class="col-3 text-center fw-semibold">kN</div>
                                                <div class="col-3 text-center fw-semibold">Volt</div>
                                            </div>

                                            <div class="row g-3 align-items-center">

                                                <div class="col-6 fw-semibold">S1 Main Loadcell</div>
                                                <div class="col-3">
                                                    <input id="S1MainLoadcell_kn"
                                                           class="form-control form-control-sm text-center"
                                                           readonly />
                                                </div>
                                                <div class="col-3">
                                                    <input id="S1MainLoadcell_v"
                                                           class="form-control form-control-sm text-center"
                                                           readonly />

                                                </div>


                                                <div class="col-6 fw-semibold">S1 Pre Loadcell</div>
                                                <div class="col-3">
                                                    <input id="S1PreLoadcell_kn"
                                                           class="form-control form-control-sm text-center"
                                                           readonly />
                                                </div>
                                                <div class="col-3">
                                                    <input id="S1PreLoadcell_v"
                                                           class="form-control form-control-sm text-center"
                                                           readonly />
                                                </div>

                                                <div class="col-6 fw-semibold">S2 Main Loadcell</div>
                                                <div class="col-3">
                                                    <input id="S2MainLoadcell_kn"
                                                           class="form-control form-control-sm text-center"
                                                           readonly />
                                                </div>
                                                <div class="col-3">
                                                    <input id="S2MainLoadcell_v"
                                                           class="form-control form-control-sm text-center"
                                                           readonly />
                                                </div>

                                                <div class="col-6 fw-semibold">S2 Pre Loadcell</div>
                                                <div class="col-3">
                                                    <input id="S2PreLoadcell_kn"
                                                           class="form-control form-control-sm text-center"
                                                           readonly />
                                                </div>
                                                <div class="col-3">
                                                    <input id="S2PreLoadcell_v"
                                                           class="form-control form-control-sm text-center"
                                                           readonly />
                                                </div>

                                            </div>
                                        </div>

                                        <!-- RIGHT COLUMN -->
                                        <div class="col-md-6">
                                            <!-- Header Row -->
                                            <div class="row g-2 mb-2">
                                                <div class="col-6"></div>
                                                <div class="col-3 right-kN text-center fw-semibold">kN</div>
                                                <div class="col-3 right-kN text-center fw-semibold">Volt</div>
                                            </div>

                                            <div class="row g-3 align-items-center">
                                                <div class="col-6 fw-semibold">S1 Eject Loadcell</div>
                                                <div class="col-3">
                                                    <input id="S1EjectLoadcell_kn"
                                                           class="form-control form-control-sm text-center"
                                                           readonly />
                                                </div>
                                                <div class="col-3">
                                                    <input id="S1EjectLoadcell_v"
                                                           class="form-control form-control-sm text-center"
                                                           readonly />
                                                </div>

                                                <div class="col-6 fw-semibold">S2 Eject Loadcell</div>
                                                <div class="col-3">
                                                    <input id="S2EjectLoadcell_kn"
                                                           class="form-control form-control-sm text-center"
                                                           readonly />
                                                </div>
                                                <div class="col-3">
                                                    <input id="S2EjectLoadcell_v"
                                                           class="form-control form-control-sm text-center"
                                                           readonly />
                                                </div>

                                                <div class="col-6 fw-semibold">Upper Punch Loadcell</div>
                                                <div class="col-3">
                                                    <input id="UpperPunchLoadcell_kn"
                                                           class="form-control form-control-sm text-center"
                                                           readonly />
                                                </div>
                                                <div class="col-3">
                                                    <input id="UpperPunchLoadcell_v"
                                                           class="form-control form-control-sm text-center"
                                                           readonly />
                                                </div>

                                                <div class="col-6 fw-semibold">Lower Punch Loadcell</div>
                                                <div class="col-3">
                                                    <input id="LowerPunchLoadcell_kn"
                                                           class="form-control form-control-sm text-center"
                                                           readonly />
                                                </div>
                                                <div class="col-3">
                                                    <input id="LowerPunchLoadcell_v"
                                                           class="form-control form-control-sm text-center"
                                                           readonly />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>

                <!--Card 4-->
                <div class="col-lg-5">
                    <div class="card box-shadow-1 h-100">

                        <div class="card-body">

                            <div class="container py-4 h-100">
                                <div class="d-flex justify-content-center h-100 ">
                                    <div class="w-100 d-flex h-100 flex-column justify-content-center ">

                                        <div class="container w-auto">
                                            <div class="row mb-3 justify-content-center">
                                                <!-- Left Label Column -->
                                                <div class="col-auto pe-2 align-self-end mb-1" style="min-width: 140px;">
                                                    <label class="fw-semibold text-nowrap">Revolution Count</label>
                                                </div>

                                                <!-- Right Input Column -->
                                                <div class="col-auto">
                                                    <input id="revolutionCount"
                                                           type="text"
                                                           class="form-control form-control-sm text-center"
                                                           readonly />
                                                </div>
                                            </div>

                                            <div class="row mb-3 justify-content-center">
                                                <!-- Left Label Column -->
                                                <div class="col-auto pe-2 align-self-end mb-1" style="min-width: 140px;">
                                                    <label class="fw-semibold text-nowrap">Encoder Act Count</label>
                                                </div>

                                                <!-- Right Input Column -->
                                                <div class="col-auto">
                                                    <input id="encoderActCount"
                                                           type="text"
                                                           class="form-control form-control-sm text-center"
                                                           readonly />

                                                </div>
                                            </div>
                                        </div>



                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!--Servo Management-->
        <div class="tab-pane pt-3 fade" id="profile-tab-pane" role="tabpanel" aria-labelledby="profile-tab" tabindex="0">
            <div class="servo-container">

                @{
                    // List of titles for the servo management cards
                    var titles = new List<string>
                                {
                                "S1 Fill Depth Servo-1",
                                "S2 Fill Depth Servo-2",
                                "S1 Main Lower Servo-3",
                                "S1 Main Penetration Servo-4",
                                "S1 Pre Lower Servo-5",
                                "S1 Pre Penetration Servo-6",
                                "S2 Main Lower Servo-7",
                                "S2 Main Penetration Servo-8",
                                "S1 Pre Lower Servo-9",
                                "S2 Pre Penetration Servo-10"
                                };
                }
                @foreach (var title in titles)
                {
                    <!--Cards 1 to 10-->
                    <div class="col">
                        <div class="card h-100 box-shadow-1">


                            <h5 class="card-title col-FFFFFF bord-top-rad-4px mb-0">@title</h5>
                            <div class="card-body p-3 bord-rad-4px">

                                <!--1st row-->
                                <div class="d-flex gap-2 mb-3">
                                    <button class="btn btn-primary bgcol-8434C6 me-auto fw-semibold w-100px" type="button">Jog Up</button>
                                    <button class="btn btn-primary bgcol-8434C6 fw-semibold w-100px" type="button">Jog Down</button>
                                </div>

                                <!--Counter component-->
                                <div class="row mb-3 justify-content-start w-100 position-relative counter-comp">
                                    <label for="colFormLabelSm" class="col-auto col-form-label me-auto col-form-label-sm fw-semibold">Jog Speed</label>

                                    <div class="col-sm-3 d-flex align-items-center bord-D2D2D2 rounded px-2 w-70px py-1">
                                        <div class="d-flex flex-column me-2 row-gap-1">

                                            <button class="btn btn-sm arrow-btns p-0">
                                                <svg width="6" height="5" viewBox="0 0 6 5" fill="none" xmlns="http://www.w3.org/2000/svg" onclick="changeValue(1)">
                                                    <path d="M0.706446 3.13825L2.50994 0.318397C2.57436 0.217467 2.65088 0.137392 2.73512 0.0827573C2.81936 0.0281225 2.90966 0 3.00086 0C3.09206 0 3.18236 0.0281225 3.2666 0.0827573C3.35083 0.137392 3.42735 0.217467 3.49177 0.318397L5.29527 3.13825C5.73396 3.82416 5.42061 5 4.80088 5H1.19388C0.574143 5 0.267758 3.82416 0.706446 3.13825Z" fill="#242424" />
                                                </svg>
                                            </button>



                                            <button class="btn btn-sm arrow-btns p-0">
                                                <svg width="6" height="5" viewBox="0 0 6 5" fill="none" xmlns="http://www.w3.org/2000/svg" onclick="changeValue(-1)">
                                                    <path d="M5.29355 1.86175L3.49006 4.6816C3.42564 4.78253 3.34912 4.86261 3.26488 4.91724C3.18064 4.97188 3.09034 5 2.99914 5C2.90794 5 2.81764 4.97188 2.7334 4.91724C2.64917 4.86261 2.57265 4.78253 2.50823 4.6816L0.70473 1.86175C0.266041 1.17584 0.57939 0 1.19912 0H4.80612C5.42586 0 5.73224 1.17584 5.29355 1.86175Z" fill="#242424" />
                                                </svg>
                                            </button>


                                        </div>
                                        <input type="" id="" class="form-control arrows-text font-size-12px h-16px border-0 p-0 ps-1 text-start fw-semibold" value="10">
                                    </div>
                                </div>

                                <!--3rd and 4th rows-->
                                <div class="row mb-3 justify-content-start w-100 position-relative counter-comp align-items-center">
                                    <label for="colFormLabelSm" class="col-4 col-form-label me-auto text-nowrap col-form-label-sm fw-semibold">Act Torque</label>
                                    <input type="text" class="form-control form-control-sm me-auto col-4 text-center w-60px bord-col-215ED6 fw-semibold" value="0">
                                    <div class="form-check col-4 form-check-reverse">
                                        <input class="form-check-input servo-radio" type="radio" name="radioDefault" id="">
                                        <label class="form-check-label pe-2 fw-semibold" for="radioDefault1">
                                            Ready
                                        </label>
                                    </div>
                                </div>

                                <div class="row mb-3 justify-content-start w-100 position-relative counter-comp align-items-center">
                                    <label for="colFormLabelSm" class="col-4 col-form-label me-auto col-form-label-sm fw-semibold">Act Pos.</label>
                                    <input type="text" class="form-control form-control-sm me-auto col-4 text-center w-60px bord-col-215ED6 fw-semibold" value="0">
                                    <div class="form-check col-4 form-check-reverse">
                                        <input class="form-check-input servo-radio" type="radio" name="radioDefault" id="">
                                        <label class="form-check-label pe-2 fw-semibold" for="radioDefault1">
                                            Alarm
                                        </label>
                                    </div>
                                </div>

                                <!--Buttons-->
                                <div class="d-flex gap-2 mb-3">
                                    <button class="btn btn-primary bgcol-81D4FA me-auto fw-semibold col-242424 w-100px" type="button">Enable</button>
                                    <button class="btn btn-primary bgcol-FF441F  fw-semibold w-100px col-242424" type="button">Stop</button>
                                </div>

                                <div class="d-flex gap-2 mb-3">
                                    <button class="btn btn-primary bgcol-34C63B me-auto fw-semibold opacity-50 w-100px col-242424" type="button">Run</button>
                                    <button class="btn btn-primary bgcol-FFAB36 fw-semibold w-100px col-242424" type="button">Reset</button>
                                </div>

                                <!--Last rows-->
                                <div class="row mb-3 justify-content-start w-100 position-relative counter-comp">
                                    <label for="colFormLabelSm" class="col-auto col-form-label me-auto col-form-label-sm fw-semibold">Set Pos.</label>

                                    <div class="col-sm-3 d-flex align-items-center bord-D2D2D2 opacity-50 rounded px-2 w-70px py-1">
                                        <div class="d-flex flex-column me-2 row-gap-1">

                                            <button class="btn btn-sm arrow-btns p-0 arrows-text-dis">
                                                <svg width="6" height="5" viewBox="0 0 6 5" fill="none" xmlns="http://www.w3.org/2000/svg" onclick="changeValue(1)">
                                                    <path d="M0.706446 3.13825L2.50994 0.318397C2.57436 0.217467 2.65088 0.137392 2.73512 0.0827573C2.81936 0.0281225 2.90966 0 3.00086 0C3.09206 0 3.18236 0.0281225 3.2666 0.0827573C3.35083 0.137392 3.42735 0.217467 3.49177 0.318397L5.29527 3.13825C5.73396 3.82416 5.42061 5 4.80088 5H1.19388C0.574143 5 0.267758 3.82416 0.706446 3.13825Z" fill="#242424" />
                                                </svg>
                                            </button>



