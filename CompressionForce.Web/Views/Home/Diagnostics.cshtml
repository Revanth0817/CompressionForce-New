    });

    });

      hub.on("TagUpdated", (tagKey, value) => {

        const el = document.querySelector(`[data-tag='${tagKey}']`);
        if (!el) return;

        /* ================= DOOR INTERLOCK ================= */
        if (tagKey === "TURRET_DOOR_INTERLOCK") {

            // Always keep purple
            el.classList.add("bgcol-8434C6");
            el.classList.remove("bg-danger");

            if (value === true) {
                // TRUE → full visibility
                el.classList.remove("opacity-50");
                el.style.opacity = "1";
            } else {
                // FALSE → dim
                el.classList.add("opacity-50");
            }

            return;
        }

        /* 🚫 DO NOT TOUCH START / JOG */
        if (tagKey === "TURRET_START" || tagKey === "TURRET_JOG") {
            return;
        }

        /* ================= BOOLEAN TAGS ================= */
        if (typeof value === "boolean") {

            el.innerText = value ? "ON" : "OFF";

            el.classList.remove(
                "bg-success",
                "bg-danger",
                "bg-secondary",
                "bgcol-47494A"
            );

            if (value === true) {
                el.classList.add("bg-success");
            } else {
                el.classList.add("bg-danger");
            }
        }

            /* ================= ANALOG / RPM ================= */
    else {

        if (el.tagName === "INPUT") {

            // 🔥 DO NOT overwrite while typing
            if (document.activeElement !== el) {
                el.value = value;
            }

        } else {
            el.innerText = value;
        }
    }

    });





        hub.start()
            .then(() => console.log("✅ Unified SignalR Connected"))
            .catch(err => console.error("❌ SignalR Error:", err));
    }


    /* ============================================================
       DIGITAL OUTPUT WRITE (PLC CONFIRMATION BASED)
