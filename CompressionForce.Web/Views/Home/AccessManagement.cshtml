<div class="container-fluid pt-4 px-4">
    <div class="accountManagementContainer">
        <h4 class="clr-215ED6 fw-semibold mb-4 mt-0">Account Management</h4>
        <div class="d-flex flex-wrap gap-3 pb-3">
            <button type="button"
                    class="bord-D2D2D2 clr-242424 boxshadow font-size-14px fw-semibold rounded-2 py-2 px-3 bg-white"
                    data-bs-toggle="modal"
                    data-bs-target="#changePasswordModal">
                Change Password
            </button>

            <button class="bord-D2D2D2 clr-242424 boxshadow font-size-14px fw-semibold rounded-2 py-2 px-3 bg-white" data-bs-toggle="modal" data-bs-target="#exampleModalToggle2" href="" role="button">Change Access</button>
            <button class="bord-D2D2D2 clr-242424 boxshadow font-size-14px fw-semibold rounded-2 py-2 px-3 bg-white" data-bs-toggle="modal" data-bs-target="#exampleModalToggle" href="" role="button">Create Account</button>
            <button type="button"
                    class="bord-D2D2D2 clr-242424 boxshadow font-size-14px fw-semibold rounded-2 py-2 px-3 bg-white"
                    data-bs-toggle="modal"
                    data-bs-target="#addGroupModal">
                Add Group
            </button>




          <button type="button"
        class="bord-D2D2D2 clr-242424 boxshadow font-size-14px fw-semibold rounded-2 py-2 px-3 bg-white"
        onclick="setInactive()">
    Account Deactivate
</button>

<button type="button"
        class="bord-D2D2D2 clr-242424 boxshadow font-size-14px fw-semibold rounded-2 py-2 px-3 bg-white"
        onclick="setActive()">
    Account Activate
</button>


            <button type="button"
                    class="bord-D2D2D2 clr-242424 boxshadow font-size-14px fw-semibold rounded-2 py-2 px-3 bg-white"
                    onclick="applyPasswordExpiry()">
                Reset Password Expiry
            </button>

            <button type="button" class="bord-D2D2D2 clr-242424 boxshadow font-size-14px fw-semibold rounded-2 py-2 px-3 bg-white" data-bs-toggle="modal" data-bs-target="#exampleModalToggle3" href="" role="button">Previlege</button>
            <button type="button" class="bord-D2D2D2 clr-242424 boxshadow font-size-14px fw-semibold rounded-2 py-2 px-3 bg-white" data-bs-toggle="modal" data-bs-target="#exampleModalToggle4" href="" role="button">Security Settings</button>
        </div>
        <div class="table-wrapper">
            <table class="table table-bordered bord-D2D2D2 boxshadow bord-rad-4px">
                <thead>
                    <tr>
                        <th scope="col" class="fw-semibold text-center"></th>
                        <th scope="col" class="fw-semibold">User Name</th>
                        <th scope="col" class="fw-semibold">Access</th>
                        <th scope="col" class="fw-semibold">Expires On</th>
                        <th scope="col" class="fw-semibold">Activate / Deactivate</th>
                        <th scope="col" class="fw-semibold">Last Login</th>
                    </tr>
                </thead>

                <tbody id="userTableBody">
                    <!-- New users will be added here -->
                </tbody>

            </table>
        </div>
    </div>  
</div>      
<!--User create Popup-->
<div class="modal fade" id="exampleModalToggle" tabindex="-1" aria-labelledby="exampleModalToggleLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">

            <!-- HEADER -->
            <div class="modal-header bgcol-215ED6 text-white justify-content-between font-size-18px">
                <h5 class="fw-semibold modal-title" id="exampleModalToggleLabel">
                    User Creation
                </h5>
                <button type="button" class="bg-transparent border-0" data-bs-dismiss="modal" aria-label="Close">
                    <img src="~/icons/closeicon.svg" />
                </button>
            </div>

            <!-- BODY -->
            <div class="modal-body p-4 userCreationScroll">
                <div class="d-flex gap-4 flex-lg-row flex-column">

                    <!-- LEFT INFO -->
                    <div class="userCreationlefContainer">
                        <div class="position-relative w-60">
                            <div class="camera-preview d-flex align-items-center justify-content-center mb-3 rounded">
                                Preview
                            </div>

                            <label class="btn btn-take-picture bord-D2D2D2 font-size-14 fw-semibold mb-3 boxshadow w-100">
                                Take Picture
                                <input type="file" accept="image/*" capture="user" hidden>
                            </label>
                        </div>

                        <p class="font-size-14 fw-semibold">
                            Note: Make sure your password follows these rules:
                        </p>
                        <ul class="ps-3">
                            <li class="font-size-14 mb-2">8–15 characters</li>
                            <li class="font-size-14 mb-2">Upper & lower case letters</li>
                            <li class="font-size-14">1 number & 1 special character</li>
                        </ul>
                        <p class="font-size-14">
                            <span class="fw-semibold">Example:</span> Admin@1234
                        </p>
                    </div>

                    <!-- FORM -->
                    <div class="flex-grow-1">
                        <form id="createUserForm" onsubmit="createUser(event)">

                            <div class="mb-2">
                                <label class="form-label font-size-14 fw-semibold">Email</label>
                                <input type="email" class="form-control" id="email" required>
                            </div>

                            <div class="mb-2">
                                <label class="form-label font-size-14 fw-semibold">User Name</label>
                                <input type="text" class="form-control" id="userName" required>
                            </div>

                            <div class="mb-2">
                                <label class="form-label font-size-14 fw-semibold">Password</label>

                                <div class="input-group password-group">
                                    <input type="password"
                                           class="form-control password-input"
                                           id="password"
                                           placeholder="Password"
                                           required>

                                    <span class="input-group-text password-eye"
                                          onclick="togglePassword(this)">
                                        <img src="~/icons/password_show.svg" alt="Show">
                                    </span>
                                </div>
                            </div>

                            <div class="mb-2">
                                <label class="form-label font-size-14 fw-semibold">Confirm Password</label>

                                <div class="input-group password-group">
                                    <input type="password"
                                           class="form-control password-input"
                                           id="confirmPassword"
                                           placeholder="Confirm password"
                                           required>

                                    <span class="input-group-text password-eye"
                                          onclick="togglePassword(this)">
                                        <img src="~/icons/password_show.svg" alt="Show">
                                    </span>
                                </div>
                            </div>

                            <!-- USER ROLE DROPDOWN -->
                            <div class="mb-2">
                                <label class="form-label font-size-14 fw-semibold">User Role</label>

                                <div class="dropdown">
                                    <input type="text"
                                           class="form-control dropdown-toggle"
                                           id="selectedRole"
                                           placeholder="Select Role"
                                           data-bs-toggle="dropdown"
                                           readonly
                                           required>

                                    <ul class="dropdown-menu w-100">
                                        <li><a class="dropdown-item" href="#" onclick="selectRole('Admin')">Admin</a></li>
                                        <li><a class="dropdown-item" href="#" onclick="selectRole('User')">User</a></li>
                                        <li><a class="dropdown-item" href="#" onclick="selectRole('Maintenance')">Maintenance</a></li>
                                    </ul>
                                </div>
                            </div>

                            <!-- ACTION BUTTONS -->
                            <div class="d-flex justify-content-end gap-3 mt-4">
                                <button type="button"
                                        class="btn col-215ED6 bord-215ED6 fw-semibold px-4 clr-215ED6"
                                        data-bs-dismiss="modal">
                                    Cancel
                                </button>

                                <button type="submit"
                                        class="btn bgcol-215ED6 text-white fw-semibold px-4">
                                    Create User
                                </button>
                            </div>

                        </form>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>


