<script>
    async function bulkChangePassword() {

        const newPwd = document.getElementById("newPassword").value.trim();
        const confirmPwd = document.getElementById("confirmNewPassword").value.trim();

        if (!newPwd || !confirmPwd) {
            alert("Password fields are required");
            return;
        }

        if (newPwd !== confirmPwd) {
            alert("Passwords do not match");
            return;
        }

        const userIds = Array.from(
            document.querySelectorAll(".row-checkbox:checked")
        ).map(cb => parseInt(cb.dataset.id));

        if (userIds.length === 0) {
            alert("Please select at least one user");
            return;
        }

        const res = await fetch("/AdminUser/BulkChangePassword", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
                userIds: userIds,
                newPassword: newPwd
            })
        });

        if (!res.ok) {
            alert(await res.text());
            return;
        }

        // Reset inputs
        document.getElementById("newPassword").value = "";
        document.getElementById("confirmNewPassword").value = "";

        // Close modal
        bootstrap.Modal.getInstance(
            document.getElementById("changePasswordModal")
        ).hide();

        alert("Password updated successfully");
    }
</script>

<script>
    function togglePassword(el) {

        let input = null;

        // Case 1: data-target based (recommended)
        const targetId = el.getAttribute("data-target");
        if (targetId) {
            input = document.getElementById(targetId);
        }

        // Case 2: password-group based (fallback)
        if (!input) {
            const group = el.closest('.password-group');
            if (group) {
                input = group.querySelector('.password-input');
            }
        }

        // Safety check
        if (!input) {
            console.warn("Password input not found");
            return;
        }

        // Toggle password visibility
        if (input.type === "password") {
            input.type = "text";
            el.classList.add("active");
        } else {
            input.type = "password";
            el.classList.remove("active");
        }
    }
</script>


