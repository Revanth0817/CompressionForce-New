<script>
    document.addEventListener("DOMContentLoaded", loadUsers);

    let cachedUsers = [];

    /* ================= LOAD USERS ================= */
    async function loadUsers() {
        const res = await fetch("/AdminUser/List");
        if (!res.ok) return;

        const users = await res.json();
        cachedUsers = users;

        const tbody = document.getElementById("userTableBody");
        tbody.innerHTML = "";

        if (users.length === 0) {
            tbody.innerHTML = `
                <tr>
                    <td colspan="6" class="text-center text-muted">
                        No users found
                    </td>
                </tr>`;
            return;
        }

        users.forEach(u => {
            const statusClass = u.isActive ? "text-success" : "text-danger";
            const statusText = u.isActive ? "Active" : "Inactive";

            tbody.innerHTML += `
                <tr data-id="${u.id}">
                    <td class="text-center">
                        <input type="checkbox" class="row-checkbox" data-id="${u.id}">
                    </td>
                    <td class="td-username">${u.userName}</td>
                    <td class="td-role">${u.role}</td>
                    <td>${u.expiryDate ? new Date(u.expiryDate).toLocaleDateString() : "-"}</td>
                    <td class="fw-semibold ${statusClass}">${statusText}</td>
                    <td>${u.lastLoginDate ? new Date(u.lastLoginDate).toLocaleString() : "-"}</td>
                </tr>`;
        });

        populateUserDropdown(users);
    }

    /* ================= CREATE ACCOUNT (FIXED) ================= */
    async function createUser(event) {
        event.preventDefault();

        const userName = document.getElementById("userName").value.trim();
        const email = document.getElementById("email").value.trim();
        const password = document.getElementById("password").value;
        const confirmPassword = document.getElementById("confirmPassword").value;
        const role = document.getElementById("selectedRole").value.trim();

        if (!userName || !email || !password || !confirmPassword || !role) {
            alert("All fields are required");
            return;
        }

        if (password !== confirmPassword) {
            alert("Passwords do not match");
            return;
        }

        const res = await fetch("/AdminUser/Create", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
                userName: userName,
                email: email,
                password: password,
                role: role
            })
        });

        if (!res.ok) {
            alert(await res.text());
            return;
        }

        // ✅ RESET FORM
        document.getElementById("createUserForm").reset();
        document.getElementById("selectedRole").value = "";

        // ✅ CLOSE MODAL
        bootstrap.Modal.getInstance(
            document.getElementById("exampleModalToggle")
        ).hide();

        // ✅ REFRESH TABLE
        loadUsers();
    }

    /* ================= ROLE SELECT ================= */
    function selectRole(role) {
        document.getElementById("selectedRole").value = role;
    }

    /* ================= ACTIVATE / DEACTIVATE ================= */
    async function setUsersActive(isActive) {
        const ids = Array.from(document.querySelectorAll(".row-checkbox:checked"))
            .map(cb => parseInt(cb.dataset.id));

        if (ids.length === 0) {
            alert("Please select at least one user");
            return;
        }

        const res = await fetch("/AdminUser/SetActive", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
                userIds: ids,
                isActive: isActive
            })
        });

        if (!res.ok) {
            alert(await res.text());
            return;
        }

        loadUsers();
    }

    function setActive() {
        setUsersActive(true);
    }

    function setInactive() {
        setUsersActive(false);
    }

    /* ================= CHANGE ACCESS ================= */
    function populateUserDropdown(users) {
        const list = document.getElementById("userDropdownList");
        list.innerHTML = "";

        users.forEach(u => {
            list.innerHTML += `
                <li>
                    <a class="dropdown-item"
                       href="#"
                       onclick="selectUserFromDropdown(event, ${u.id}, '${u.userName}', '${u.role}')">
                       ${u.userName}
                    </a>
                </li>`;
        });
    }

    function selectUserFromDropdown(e, id, userName, role) {
        e.preventDefault();
        document.getElementById("changeUserId").value = id;
        document.getElementById("changeUserName").value = userName;
        document.getElementById("currentRole").value = role;
        document.getElementById("newRole").value = "";
    }

    function selectNewRole(e, role) {
        e.preventDefault();
        document.getElementById("newRole").value = role;
    }

    async function changeAccess() {
        const userId = document.getElementById("changeUserId").value;
        const newRole = document.getElementById("newRole").value.trim();

        if (!userId || !newRole) {
            alert("Select user and new group");
            return;
        }

        const res = await fetch("/AdminUser/ChangeAccess", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
                userId: parseInt(userId),
                newRole: newRole
            })
        });

        if (!res.ok) {
            alert(await res.text());
            return;
        }

        bootstrap.Modal.getInstance(
            document.getElementById("exampleModalToggle2")
        ).hide();

        loadUsers();
    }
</script>

<script>
    let groups = [];

    document.addEventListener("DOMContentLoaded", loadGroups);

    /* ================= LOAD GROUPS ================= */
    async function loadGroups() {
        const res = await fetch("/AdminUser/Groups");
        if (!res.ok) return;

        groups = await res.json();

        renderGroupManagerDropdown();
        renderCreateAccountRoles();
        renderChangeAccessRoles();
    }

    /* ================= ADD GROUP ================= */
    async function addGroup() {
        const input = document.getElementById("groupInput");
        const name = input.value.trim();

        if (!name) {
            alert("Group name required");
            return;
        }

        const res = await fetch("/AdminUser/AddGroup", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(name)
        });

        if (!res.ok) {
            alert(await res.text());
            return;
        }

        input.value = "";
        loadGroups();
    }

    /* ================= DELETE GROUP ================= */
    async function deleteGroup() {
        const name = document.getElementById("groupInput").value.trim();

        if (!name) {
            alert("Select group to delete");
            return;
        }

        const res = await fetch(`/AdminUser/DeleteGroup/${name}`, {
            method: "DELETE"
        });

        if (!res.ok) {
            alert(await res.text());
            return;
        }

        document.getElementById("groupInput").value = "";
        loadGroups();
    }

    /* ================= GROUP MANAGER DROPDOWN ================= */
    function renderGroupManagerDropdown() {
        const list = document.getElementById("groupDropdownList");
        if (!list) return;

        list.innerHTML = "";

        groups.forEach(g => {
            list.innerHTML += `
                <li>
                    <a class="dropdown-item"
                       href="#"
                       onclick="selectGroup('${g}')">
                       ${g}
                    </a>
                </li>`;
        });
    }

    function selectGroup(name) {
        document.getElementById("groupInput").value = name;
    }

    /* ================= CREATE ACCOUNT ================= */
    function renderCreateAccountRoles() {
        const input = document.getElementById("selectedRole");
        if (!input) return;

        const menu = input.parentElement.querySelector(".dropdown-menu");
        menu.innerHTML = "";

        groups.forEach(g => {
            menu.innerHTML += `
                <li>
                    <a class="dropdown-item"
                       href="#"
                       onclick="selectRole('${g}')">
                       ${g}
                    </a>
                </li>`;
        });
    }

    function selectRole(role) {
        document.getElementById("selectedRole").value = role;
    }

    /* ================= CHANGE ACCESS ================= */
    function renderChangeAccessRoles() {
        const input = document.getElementById("newRole");
        if (!input) return;

        const menu = input.closest(".batchDropdown")
            .querySelector(".dropdown-menu");

        menu.innerHTML = "";

        groups.forEach(g => {
            menu.innerHTML += `
                <li>
                    <a class="dropdown-item"
                       href="#"
                       onclick="selectNewRole(event,'${g}')">
                       ${g}
                    </a>
                </li>`;
        });
    }

    function selectNewRole(e, role) {
        e.preventDefault();
        document.getElementById("newRole").value = role;
    }
</script>

<script>
    /* ================= HIDE DROPDOWN ON TYPING ================= */
    function hideGroupDropdown() {
        const input = document.getElementById("groupInput");

