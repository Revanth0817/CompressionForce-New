<script>
    let selectedPrivilegeGroup = "";

    /* ================= LOAD GROUPS INTO PRIVILEGE DROPDOWN ================= */
    async function loadPrivilegeGroups() {
        const res = await fetch("/AdminUser/Groups");
        if (!res.ok) return;

        const groups = await res.json();
        const list = document.getElementById("privilegeGroupDropdown");
        list.innerHTML = "";

        groups.forEach(g => {
            list.innerHTML += `
                <li>
                    <a class="dropdown-item"
                       href="#"
                       onclick="selectPrivilegeGroup('${g}')">
                       ${g}
                    </a>
                </li>`;
        });
    }

    /* ================= SELECT GROUP ================= */
    async function selectPrivilegeGroup(group) {
        selectedPrivilegeGroup = group;
        document.getElementById("privilegeGroup").value = group;

        // clear all checkboxes
        document
            .querySelectorAll("#privilegeCheckboxes input[type='checkbox']")
            .forEach(cb => cb.checked = false);

        // load saved privileges
        const res = await fetch(`/AdminUser/GroupPrivileges/${group}`);
        if (!res.ok) return;

        const privileges = await res.json();

        privileges.forEach(p => {
            const cb = document.querySelector(
                `input[data-privilege='${p.key}']`
            );
            if (cb) cb.checked = p.allowed;
        });
    }

    /* ================= SAVE PRIVILEGES ================= */
    async function saveGroupPrivileges() {
        if (!selectedPrivilegeGroup) {
            alert("Please select a group");
            return;
        }

        const selected = Array.from(
            document.querySelectorAll(
                "#privilegeCheckboxes input[type='checkbox']:checked"
            )
        ).map(cb => cb.dataset.privilege);

        const res = await fetch("/AdminUser/SaveGroupPrivileges", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
                groupName: selectedPrivilegeGroup,
                privileges: selected
            })
        });

        if (!res.ok) {
            alert(await res.text());
            return;
        }

        bootstrap.Modal.getInstance(
            document.getElementById("exampleModalToggle3")
        ).hide();
    }

    /* ================= INIT ================= */
    document
        .getElementById("exampleModalToggle3")
        .addEventListener("show.bs.modal", loadPrivilegeGroups);
</script>

<script>
    /* ================= LOAD SETTINGS WHEN MODAL OPENS ================= */
    document
        .getElementById("exampleModalToggle4")
        .addEventListener("show.bs.modal", loadSecuritySettings);

    async function loadSecuritySettings() {

        const res = await fetch("/AdminUser/GetSecuritySettings");
        if (!res.ok) {
            console.warn("No security settings found");
            return;
        }

        const s = await res.json();

        document.getElementById("appTimeout").value = s.applicationTimeoutMinutes;
        document.getElementById("pwdExpiry").value = s.passwordExpiryDays;
        document.getElementById("wrongAttempts").value = s.maxWrongAttempts;
    }

    /* ================= SAVE SETTINGS ================= */
    async function saveSecuritySettings() {

        const data = {
            applicationTimeoutMinutes: parseInt(
                document.getElementById("appTimeout").value
            ),
            passwordExpiryDays: parseInt(
                document.getElementById("pwdExpiry").value
            ),
            maxWrongAttempts: parseInt(
                document.getElementById("wrongAttempts").value
            )
        };

        console.log("Saving security settings:", data);

        const res = await fetch("/AdminUser/SaveSecuritySettings", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(data)
        });

        if (!res.ok) {
            alert(await res.text());
            return;
        }

        alert("Security settings saved successfully");

        bootstrap.Modal.getInstance(
            document.getElementById("exampleModalToggle4")
        ).hide();
    }
</script>

<script>
    const modalEl = document.getElementById("exampleModalToggle4");

    // Load settings when modal opens
    modalEl.addEventListener("show.bs.modal", async () => {
        const res = await fetch("/AdminUser/GetSecuritySettings");
        if (!res.ok) return;

        const data = await res.json();
        const inputs = document.querySelectorAll(".arrows-text");

        inputs[0].value = data.applicationTimeoutMinutes;
        inputs[1].value = data.passwordExpiryDays;
        inputs[2].value = data.maxWrongAttempts;
    });

    async function saveSecuritySettings() {

        const inputs = document.querySelectorAll(".arrows-text");

        const payload = {
            applicationTimeoutMinutes: parseInt(inputs[0].value),
            passwordExpiryDays: parseInt(inputs[1].value),
            maxWrongAttempts: parseInt(inputs[2].value)
        };

        const res = await fetch("/AdminUser/SaveSecuritySettings", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload)
        });

        if (!res.ok) {
            alert("Failed to save security settings");
            return;
        }

        // Reload values from DB after save
        const reload = await fetch("/AdminUser/GetSecuritySettings");
        const data = await reload.json();

        inputs[0].value = data.applicationTimeoutMinutes;
        inputs[1].value = data.passwordExpiryDays;
        inputs[2].value = data.maxWrongAttempts;

        bootstrap.Modal.getInstance(modalEl).hide();
    }
</script>

