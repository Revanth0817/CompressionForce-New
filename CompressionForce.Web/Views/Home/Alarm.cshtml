<div class="container-fluid p-4 d-flex flex-column min-vh-75">
    <div class="flex-grow-1">
        <!-- Header + Buttons -->
        <div class="row align-items-center mb-4 mb-md-4">
            <div class="col-md-4 col-12">
                <h5 class="font-size-20px col-215ED6 fw-semibold mb-3 mb-md-0">Alarm Summary</h5>
            </div>
            <div class="col-md-8 col-12 d-flex flex-wrap justify-content-md-end gap-2">
                <div class="d-flex gap-2">
                    <button type="button"
        id="fetchReportBtn"
        class="btn btn-primary btn-sm">
    Fetch Report
</button>

                   <button type="button"
        class="btn btn-outline-primary btn-sm"
        onclick="downloadAlarmPdf()">
    Print Report
</button>


                </div>
                <div class="d-flex align-items-center gap-2">
                    <label class="fw-semibold col-242424 font-size-14px mb-0">Total No of Alarms </label>
                    <input type="text"
       id="totalCount"
       class="form-control form-control-sm shadow-custom bg-white max-w-63px fw-semibold col-242424 font-size-14px"
       value="0"
       readonly>

                </div>
            </div>
        </div>

        <!-- Filters Row -->
        <div class="row gy-2 mb-4 mb-md-4">
            <!-- From Date Time -->
            <div class="col-md-6 col-12 d-flex align-items-center gap-2">
                <label class="fw-semibold font-size-14px col-242424 mb-0 text-nowrap min-w-120px">
                    From Date Time
                </label>
                <div class="input-group w-100 position-relative">
                    <input type="datetime-local"
                           id="fromDate"
                           class="form-control form-control-sm fw-normal col-242424 font-size-13px datetime-input">

                    <span class="input-group-text calendar-btn bgcol-215ED6
              d-flex align-items-center justify-content-center p-0 w-26px h-32px"
                          onclick="openCalendar('fromDate')">
                        <img src="~/images/bx_calendar.png"
                             alt="calendar-icon"
                             class="w-16px h-16px">
                    </span>
                </div>
            </div>


           
             <!-- To Date Time -->
            <div class="col-md-6 col-12 d-flex align-items-center gap-2">
                <label class="fw-semibold font-size-14px col-242424 mb-0 text-nowrap min-w-120px">
                    To Date Time
                </label>

                <div class="input-group w-100 position-relative">
                    <input type="datetime-local"
                           id="toDate"
                           class="form-control form-control-sm fw-normal col-242424 font-size-13px datetime-input">

                    <span class="input-group-text calendar-btn bgcol-215ED6
              d-flex align-items-center justify-content-center p-0 w-26px h-32px"
                          onclick="openCalendar('toDate')">
                        <img src="~/images/bx_calendar.png"
                             alt="calendar-icon"
                             class="w-16px h-16px">
                    </span>
                </div>
            </div>
        </div>

        <!-- Table Section -->
        <div class="table-responsive">
            <table class="table table-bordered table-sm mb-0 font-size-12px col-242424 fw-normal text-nowrap table-striped-blue min-w-800px">
                <thead class="text-center">
                    <tr>
                        <th class="text-center fw-semibold font-size-16px bgcol-215ED6 text-white text-start">Alarm Code</th>
                        <th class="text-center fw-semibold font-size-16px bgcol-215ED6 text-white">Alarm Created Time</th>
                        <th class="text-center fw-semibold font-size-16px bgcol-215ED6 text-white">Alarm Description</th>
                        <th class="text-center fw-semibold font-size-16px bgcol-215ED6 text-white">User Name</th>
                    </tr>
                </thead>
               <tbody id="alarmTableBody">
</tbody>

            </table>
        </div>
    </div>
</div>
<script>
    function openCalendar(inputId) {
        const input = document.getElementById(inputId);
        if (!input) return;

        if (input.showPicker) {
            input.showPicker(); // Chrome / Edge
        } else {
            input.focus(); // fallback
        }
    }
</script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    let allAlarms = [];   // 🔥 stores all alarms from DB

    // 🔹 Render alarm table
    function renderAlarmTable(data) {

        let rows = "";

        if (data.length === 0) {
            rows = `
                <tr>
                    <td colspan="4" class="text-center text-muted">
                        No alarms found
                    </td>
                </tr>`;
        } else {
            data.forEach(item => {
                rows += `
                    <tr class="text-center fw-normal col-242424 font-size-13px">
                        <td>${item.alarmCode}</td>
                        <td>${item.alarmCreatedTimeText}</td>
                        <td>${item.alarmDescription}</td>
                        <td>${item.userName ?? ""}</td>
                    </tr>`;
            });
        }

        $("#alarmTableBody").html(rows);
        $("#totalCount").val(data.length);
    }

    // 🔹 Fetch ALL alarms from DB (AUTO)
    function fetchAllAlarms() {
        $.ajax({
            url: "/Alarm/GetAllAlarms",
            type: "GET",
            success: function (data) {
                allAlarms = data;
                renderAlarmTable(allAlarms);
            },
            error: function () {
                console.error("Failed to fetch alarms");
            }
        });
    }

    // 🔹 Filter alarms using From / To Date (CLIENT SIDE)
    function filterAlarms() {

        if (allAlarms.length === 0) return;

        let filtered = allAlarms;

        const fromVal = $("#fromDate").val();
        const toVal = $("#toDate").val();

        if (fromVal) {
            const fromDate = new Date(fromVal);
            filtered = filtered.filter(a =>
                new Date(a.alarmCreatedTime) >= fromDate
            );
        }

        if (toVal) {
            const toDate = new Date(toVal);
            filtered = filtered.filter(a =>
                new Date(a.alarmCreatedTime) <= toDate
            );
        }

        renderAlarmTable(filtered);
    }

    // 🔥 AUTO FETCH WHEN PAGE LOADS
    $(document).ready(function () {
        fetchAllAlarms();
    });

    // 🔹 Apply filter when date changes
    $("#fromDate, #toDate").on("change", function () {
        filterAlarms();
    });

    // 🔹 OPTIONAL: Auto refresh every 5 seconds (industrial style)
    setInterval(fetchAllAlarms, 5000);
</script>
<script>
    $("#fetchReportBtn").on("click", function (e) {
        e.preventDefault();   // 🔥 stops refresh
        fetchAllAlarms();     // reuse auto-fetch logic
    });
</script>
<script>
    function downloadAlarmPdf() {
        const fromDate = $("#fromDate").val();
        const toDate = $("#toDate").val();

        let url = "/Alarm/DownloadAlarmPdf";

        if (fromDate || toDate) {
            url += `?fromDate=${fromDate}&toDate=${toDate}`;
        }

        window.location.href = url;
    }
</script>

