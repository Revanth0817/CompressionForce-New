@{
    ViewData["Title"] = "Calibration";
}

<div class="card border-0 mx-4 ps-0 pt-4 min-height-78vh">
    <ul class="nav nav-tabs row-gap-3" id="myTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active col-242424 fw-semibold" id="" data-bs-toggle="tab" data-bs-target="#loadcellCali" type="button" role="tab" aria-controls="loadcellCali" aria-selected="true">Loadcell Calibration</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link col-242424 fw-semibold" id="" data-bs-toggle="tab" data-bs-target="#servoCali" type="button" role="tab" aria-controls="servoCali" aria-selected="false">Servo Calibration</button>
        </li>

    </ul>

    <div class="tab-content">

        <!-- Load Calibration -->
        <div class="tab-pane pt-3 fade show active" id="loadcellCali" role="tabpanel">

            <div class="card shadow-sm p-5">

                <!-- Sensor Name -->
                <div class="mb-4 row align-items-center">
                    <label class="col-md-2 col-form-label font-size-18px fw-semibold">
                        Sensor Name:
                    </label>

                    <div class="col-md-10">
                        <div class="input-group position-relative">

                            <input type="text"
                                   id="selectedItem"
                                   class="form-control bg-white"
                                   readonly />

                            <button class="btn bgcol-215ED6 dropdown-toggle"
                                    data-bs-toggle="dropdown">
                            </button>

                            <ul class="dropdown-menu dropdown-menu-end"
                                id="loadcellDropdown">
                            </ul>

                        </div>

                    </div>
                </div>

                <!-- Display Row -->
                <div class="row text-center fw-semibold mb-3">

                    <div class="col-lg-4">
                        <label class="form-label">Calibrated Value</label>
                        <div class="d-flex justify-content-center gap-2">
                            <input id="calibratedValue"
                                   type="number"
                                   step="0.001"
                                   class="form-control text-center w-25"
                                   value="0.000"
                                   readonly />

                            <span>kN</span>
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <label class="form-label">Sensor Voltage</label>
                        <div class="d-flex justify-content-center gap-2">
                            <input id="sensorVoltage"
                                   type="number"
                                   step="0.001"
                                   class="form-control text-center w-25"
                                   value="0.000"
                                   readonly />
                            <span>V</span>
                        </div>
                    </div>

                    <div class="col-lg-4 text-end">
                        <button type="button"
                                class="btn btn-primary bgcol-215ED6"
                                onclick="calculateCalibration()">
                            Calibrate
                        </button>

                    </div>
                </div>

                <!-- Setpoints -->
                <div class="row mb-3">

                    <!-- Min Volt -->
                    <div class="col-lg-3">
                        <label class="fw-semibold">Set Min. Volt</label>
                        <input id="minVolt"
                               type="number"
                               step="0.001"
                               class="form-control text-center"
                               value="0.000" />
                    </div>

                    <!-- Max Volt -->
                    <div class="col-lg-3">
                        <label class="fw-semibold">Set Max. Volt</label>
                        <input id="maxVolt"
                               type="number"
                               step="0.001"
                               class="form-control text-center"
                               value="10.000" />
                    </div>

                    <!-- Min Value -->
                    <div class="col-lg-3">
                        <label class="fw-semibold">Set Min. Value (kN)</label>
                        <input id="minValue"
                               type="number"
                               step="0.001"
                               class="form-control text-center"
                               value="0.000" />
                    </div>

                    <!-- Max Value -->
                    <div class="col-lg-3">
                        <label class="fw-semibold">Set Max. Value (kN)</label>
                        <input id="maxValue"
                               type="number"
                               step="0.001"
                               class="form-control text-center"
                               value="100.000" />
                    </div>
                </div>

                <!-- Result -->
                <div class="row mt-3">

                    <div class="col-lg-3">
                        <label class="fw-semibold">Factor</label>
                        <input id="factor"
                               type="number"
                               step="0.0001"
                               class="form-control text-center"
                               readonly />
                    </div>

                    <div class="col-lg-3">
                        <label class="fw-semibold">Offset</label>
                        <input id="offset"
                               type="number"
                               step="0.0001"
                               class="form-control text-center"
                               value="0.000" />
                    </div>

                </div>
            </div>
        </div>


        <!--Servo Calibration-->
        <div class="tab-pane pt-3 fade" id="servoCali" role="tabpanel" aria-labelledby="home-tab" tabindex="0">
            <div class="servo-container">

