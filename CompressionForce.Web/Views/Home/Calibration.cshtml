<script>
let voltageTimer = null;
let selectedLoadCellKey = null;

// =======================
// DOM SHORTCUTS
// =======================
const minVoltEl = document.getElementById("minVolt");
const maxVoltEl = document.getElementById("maxVolt");
const minValEl  = document.getElementById("minValue");
const maxValEl  = document.getElementById("maxValue");

const factorEl  = document.getElementById("factor");
const offsetEl  = document.getElementById("offset");

const voltageEl = document.getElementById("sensorVoltage");
const knEl      = document.getElementById("calibratedValue");

// =======================
// PAGE LOAD
// =======================
document.addEventListener("DOMContentLoaded", () => {

    fetch("/Calibration/GetLoadCells")
        .then(r => r.json())
        .then(data => {

            const dropdown = document.getElementById("loadcellDropdown");
            dropdown.innerHTML = "";

            data.forEach(lc => {
                const li = document.createElement("li");
                li.innerHTML = `
                    <a class="dropdown-item"
                       href="javascript:void(0)"
                       onclick="selectLoadCell('${lc.key}', '${lc.name}')">
                        ${lc.name}
                    </a>`;
                dropdown.appendChild(li);
            });

            // 🔁 Restore last selected loadcell
            const savedKey  = localStorage.getItem("selectedLoadCellKey");
            const savedName = localStorage.getItem("selectedLoadCellName");

            if (savedKey && savedName) {
                selectLoadCell(savedKey, savedName);
            }
        });
});

// =======================
// LOAD CELL SELECT
// =======================
function selectLoadCell(key, name) {

    document.getElementById("selectedItem").value = name;
    selectedLoadCellKey = key;

    // 💾 Save selection
    localStorage.setItem("selectedLoadCellKey", key);
    localStorage.setItem("selectedLoadCellName", name);

    restoreCalibration(key);

    if (voltageTimer)
        clearInterval(voltageTimer);

    voltageTimer = setInterval(readLiveVoltage, 1000);
}

// =======================
// RESTORE CALIBRATION
// =======================
function restoreCalibration(key) {

    const saved = localStorage.getItem(`calibration_${key}`);
    if (!saved) return;

    const c = JSON.parse(saved);

    minVoltEl.value = c.minVolt;
    maxVoltEl.value = c.maxVolt;
    minValEl.value  = c.minValue;
    maxValEl.value  = c.maxValue;
    factorEl.value  = c.factor;
    offsetEl.value  = c.offset;
}

// =======================
// LIVE PLC VOLTAGE
// =======================
function readLiveVoltage() {

    if (!selectedLoadCellKey) return;

    fetch(`/Calibration/GetLiveVoltage?loadCellKey=${selectedLoadCellKey}`)
        .then(r => r.json())
        .then(d => {

            const voltage = d.voltage;
            voltageEl.value = voltage.toFixed(3);

            autoCalculateKn(voltage);
        })
        .catch(console.error);
}

// =======================
// AUTO kN CALCULATION
// =======================
function autoCalculateKn(voltage) {

    const factor = parseFloat(factorEl.value);
    const offset = parseFloat(offsetEl.value);

    if (isNaN(factor) || isNaN(offset)) {
        knEl.value = "0.000";
        return;
    }

    const kn = (voltage * factor) + offset;
    knEl.value = kn.toFixed(3);
}

// =======================
// MANUAL CALIBRATION
// =======================
function calculateCalibration() {

    if (!selectedLoadCellKey) {
        alert("Please select a loadcell");
        return;
    }

    const minVolt = parseFloat(minVoltEl.value);
    const maxVolt = parseFloat(maxVoltEl.value);
    const minVal  = parseFloat(minValEl.value);
    const maxVal  = parseFloat(maxValEl.value);

    if (maxVolt === minVolt) {
        alert("Min Volt and Max Volt cannot be same");
        return;
    }

    // 🔢 CALCULATION
    const factor = (maxVal - minVal) / (maxVolt - minVolt);
    const offset = minVal - (minVolt * factor);

    factorEl.value = factor.toFixed(4);
    offsetEl.value = offset.toFixed(4);

    // 💾 Save locally (refresh persistence)
    localStorage.setItem(`calibration_${selectedLoadCellKey}`, JSON.stringify({
        minVolt,
        maxVolt,
        minValue: minVal,
        maxValue: maxVal,
        factor: factor.toFixed(4),
        offset: offset.toFixed(4)
    }));

    // 💾 Save to server
    fetch("/Calibration/SaveCalibration", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
            loadCellName: selectedLoadCellKey,
            minVolt,
            maxVolt,
            minValue: minVal,
            maxValue: maxVal,
            factor,
            offset
        })
    })
    .then(() => alert("Calibration saved successfully"));
}
</script>


                <script>
                    /* =========================================================
                       SERVO CALIBRATION – SINGLE SOURCE OF TRUTH
                       ========================================================= */

                    /* -----------------------------
                       SAVE SERVO CALIBRATION (SET)
                    ----------------------------- */
                    function saveServoCalibration(btn) {

                        const card = btn.closest(".card");
                        const titleEl = card.querySelector(".card-title");

                        const servoCode = titleEl.dataset.servo;
                        const servoName = titleEl.innerText.trim();

                        const jogSpeed = Number(card.querySelector(".jog-speed")?.value) || 0;
                        const setPos   = Number(card.querySelector(".set-pos")?.value) || 0;
                        const setSpeed = Number(card.querySelector(".set-speed")?.value) || 0;

                        const payload = {
                            servoCode,
                            servoName,
                            jogSpeed,
                            torqueLimit: 0,      // PLC-driven only
                            setPosition: setPos,
                            setSpeed
                        };

                        fetch("/ServoCalibration/SaveServoCalibration", {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify(payload)
                        })
                        .then(r => {
                            if (!r.ok) throw new Error();
                            return r.json();
                        })
                        .then(r => alert(r.message))
                        .catch(() => alert("Servo calibration failed"));
                    }

                    /* -----------------------------
                       RESET SERVO (LOCAL UI RESET)
                    ----------------------------- */
                    function resetServoCalibration(btn) {

                        const card = btn.closest(".card");

                        card.querySelector(".jog-speed").value = 0;
                        card.querySelector(".set-pos").value   = 0;
                        card.querySelector(".set-speed").value = 0;

                        alert("Servo values reset (local only)");
                    }

                    /* -----------------------------
                       VALUE INCREMENT / DECREMENT
                    ----------------------------- */
                    function changeValue(el, step) {

                        const input = el.closest(".counter-comp")?.querySelector("input");
                        if (!input) return;

                        let value = Number(input.value) || 0;
                        value = Math.max(0, value + step);

                        input.value = value.toFixed(2);
                    }

                    /* -----------------------------
                       SERVO ACTIONS (RUN / STOP / JOG)
                    ----------------------------- */
                    function servoAction(btn, action, pressed) {

                        const card = btn.closest(".card");
                        const servoCode = card.querySelector(".card-title").dataset.servo;

                        // UI feedback
                        if (pressed) btn.classList.add("servo-btn-active");
                        else btn.classList.remove("servo-btn-active");

                        fetch(`/Servo/${action}?servoCode=${servoCode}`, {
                            method: "POST"
                        })
                        .catch(() => alert("PLC communication failed"));
                    }

                    /* -----------------------------
                       TORQUE POLLING (PLC → UI)
                    ----------------------------- */
                    function startTorquePolling(card) {

                        if (card._torqueTimer) return;

                        const servoCode = card.querySelector(".card-title")?.dataset.servo;
                        if (!servoCode) return;

                        card._torqueTimer = setInterval(() => {

                            fetch(`/ServoCalibration/GetLiveTorque?servoCode=${servoCode}`)
                                .then(r => r.json())
                                .then(v => {
                                    const input = card.querySelector(".act-torque");
                                    if (input) input.value = (Number(v) || 0).toFixed(2);
                                })
                                .catch(() => {});

                        }, 1000);
                    }
                                        function servoCommand(btn, action) {

                        const card = btn.closest(".card");
                        const servoCode = card.querySelector(".card-title").dataset.servo;

                        fetch(`/Servo/${action}?servoCode=${servoCode}`, {
                            method: "POST"
                        })
                        .then(() => {
                            // OPTIONAL visual feedback (short flash)
                            btn.classList.add("servo-btn-flash");
                            setTimeout(() => btn.classList.remove("servo-btn-flash"), 200);
                        })
                        .catch(() => alert("PLC communication failed"));
                    }


                    /* -----------------------------
                       READY / ALARM POLLING (PLC → UI)
                    ----------------------------- */
                    function startStatusPolling(card) {

                        if (card._statusTimer) return;

                        const servoCode = card.querySelector(".card-title")?.dataset.servo;
                        if (!servoCode) return;

                        card._statusTimer = setInterval(() => {

                            fetch(`/ServoCalibration/GetServoStatus?servoCode=${servoCode}`)
                                .then(r => r.json())
                                .then(s => {
                                    card.querySelector(".ready-indicator").checked = !!s.ready;
                                    card.querySelector(".alarm-indicator").checked = !!s.alarm;
                                })
                                .catch(() => {});

                        }, 1000);
                    }

                    /* -----------------------------
                       INIT – START ALL POLLING
                    ----------------------------- */
                    document.addEventListener("DOMContentLoaded", () => {

                        document.querySelectorAll(".servo-container .card").forEach(card => {
                            startTorquePolling(card);
                            startStatusPolling(card);
                        });

                    });
                </script>



                