               <script>
document.addEventListener("DOMContentLoaded", function () {

    fetch('@Url.Action("GetLoadCells", "Calibration")')
        .then(response => response.json())
        .then(data => {

            console.log("Loadcells:", data); // DEBUG

            const dropdown = document.getElementById("loadcellDropdown");
            dropdown.innerHTML = "";

            if (data.length === 0) {
                dropdown.innerHTML =
                    `<li><span class="dropdown-item text-muted">No loadcells found</span></li>`;
                return;
            }

            data.forEach(lc => {
                const li = document.createElement("li");
                li.innerHTML = `
                    <a class="dropdown-item"
                       href="#"
                       onclick="selectLoadCell('${lc.loadCellCode}', '${lc.loadCellName}')">
                        ${lc.loadCellName}
                    </a>`;
                dropdown.appendChild(li);
            });
        })
        .catch(err => console.error("Loadcell API error:", err));
});

function selectLoadCell(code, name) {
    document.getElementById("selectedItem").value = name;
    document.getElementById("selectedItem").dataset.code = code;
}
</script>
                

                <script>
                    function calculateCalibration() {

                        const loadCellCode = document.getElementById("selectedItem").dataset.code;

                        if (!loadCellCode) {
                            alert("Please select Sensor Name");
                            return;
                        }

                        const minVolt = Number(document.getElementById("minVolt").value);
                        const maxVolt = Number(document.getElementById("maxVolt").value);
                        const minVal  = Number(document.getElementById("minValue").value);
                        const maxVal  = Number(document.getElementById("maxValue").value);
                        const voltage = Number(document.getElementById("sensorVoltage").value);

                        if (maxVolt === minVolt) {
                            alert("Min Volt and Max Volt cannot be same");
                            return;
                        }

                        const factor = (maxVal - minVal) / (maxVolt - minVolt);
                        const offset = minVal - (minVolt * factor);
                        const force  = (voltage * factor) + offset;

                        document.getElementById("factor").value = factor.toFixed(4);
                        document.getElementById("offset").value = offset.toFixed(4);
                        document.getElementById("calibratedValue").value = force.toFixed(3);

                        // 🔹 SAVE TO DATABASE
                        fetch('@Url.Action("SaveCalibration", "Calibration")', {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json"
                            },
                            body: JSON.stringify({
                                loadCellCode: loadCellCode,
                                minVolt: minVolt,
                                maxVolt: maxVolt,
                                minValue: minVal,
                                maxValue: maxVal,
                                factor: factor,
                                offset: offset
                            })
                        })
                        .then(res => res.json())
                        .then(data => {
                            alert("Calibration saved successfully");
                        })
                        .catch(err => {
                            console.error(err);
                            alert("Error saving calibration");
                        });
                    }
                </script>
                <script>
                    function saveServoCalibration(servoCode, servoName) {

                        const data = {
                            servoCode: servoCode,
                            servoName: servoName,
                            jogSpeed: Number(document.getElementById(`${servoCode}-jogSpeed`).value),
                            setPosition: Number(document.getElementById(`${servoCode}-setPos`).value),
                            setSpeed: Number(document.getElementById(`${servoCode}-setSpeed`).value),
                            torqueLimit: Number(document.getElementById(`${servoCode}-torque`).value)
                        };

                        fetch('/ServoCalibration/SaveServoCalibration', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(data)
                        })
                        .then(res => res.json())
                        .then(r => alert(r.message))
                        .catch(err => {
                            console.error(err);
                            alert("Error saving servo calibration");
                        });
                    }
                </script>
                <script>
                    function loadLastServoCalibration(servoCode) {
                        fetch(`/ServoCalibration/GetLastServoCalibration?servoCode=${servoCode}`)
                            .then(res => res.json())
                            .then(d => {
                                if (!d) return;

                                document.getElementById(`${servoCode}-jogSpeed`).value = d.jogSpeed;
                                document.getElementById(`${servoCode}-setPos`).value = d.setPosition;
                                document.getElementById(`${servoCode}-setSpeed`).value = d.setSpeed;
                                document.getElementById(`${servoCode}-torque`).value = d.torqueLimit;
                            });
                    }
                </script>
                <script>
                    function saveServoCalibration(btn) {

                        const card = btn.closest(".card-body");
                        const titleEl = card.closest(".card").querySelector(".card-title");

                        const servoCode = titleEl.dataset.servo;
                        const servoName = titleEl.innerText;

                        const jogSpeed   = Number(card.querySelector(".jog-speed").value);
                        const torque     = Number(card.querySelector(".act-torque").value);
                        const setValue   = Number(card.querySelector(".set-value").value);
                        const setPos     = Number(card.querySelector(".set-pos").value);
                        const setSpeed   = Number(card.querySelector(".set-speed").value);

                        const payload = {
                            servoCode: servoCode,
                            servoName: servoName,
                            jogSpeed: jogSpeed,
                            torqueLimit: torque,
                            setPosition: setPos,
                            setSpeed: setSpeed
                        };

                        fetch("/ServoCalibration/SaveServoCalibration", {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify(payload)
                        })
                        .then(res => res.json())
                        .then(r => alert(r.message))
                        .catch(err => {
                            console.error(err);
                            alert("Servo calibration save failed");
                        });
                    }
                </script>
                <<script>
                     function resetServoCalibration(btn) {

                         const card = btn.closest(".card-body");

                         // Set ALL values to ZERO
                         card.querySelector(".jog-speed").value  = 0;
                         card.querySelector(".act-torque").value = 0;
                         card.querySelector(".set-value").value  = 0;
                         card.querySelector(".set-pos").value    = 0;
                         card.querySelector(".set-speed").value  = 0;

                         // Uncheck Ready / Alarm if present
                         const radios = card.querySelectorAll(".servo-radio");
                         radios.forEach(r => r.checked = false);

                         alert("All servo values reset to zero");
                     }
</script>
                <script>
                    function changeValue(el, step) {

                        // Find nearest input inside the same counter component
                        const input = el.closest(".counter-comp").querySelector("input");

                        if (!input) return;

                        let value = parseFloat(input.value) || 0;

                        // Step logic (can be customized)
                        value += step;

                        // Prevent negative values (industrial safety)
                        if (value < 0) value = 0;

                        input.value = value.toFixed(2);
                    }
                </script>
