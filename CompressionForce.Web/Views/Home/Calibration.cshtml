                <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.0/dist/browser/signalr.min.js"></script>



                


                <script>
                    /* ===============================
                       GLOBAL STATE
                    ================================ */
                    let voltageTimer = null;

                    /* ===============================
                       START / STOP POLLING
                    ================================ */
                    function startVoltagePolling() {
                        stopVoltagePolling(); // safety

                        voltageTimer = setInterval(() => {
                            const code = document.getElementById("selectedItem")?.dataset.code;
                            if (!code) return;

                            fetch(`/Calibration/GetSensorVoltage?loadCellCode=${code}`)
                                .then(r => {
                                    if (!r.ok) throw new Error("PLC tag not found");
                                    return r.json();
                                })
                                                    .then(d => {
                                            document.getElementById("sensorVoltage").value =
                                                Number(d.voltage).toFixed(3);

                                            updateCalibratedValueLive(); // 🔥 AUTO UPDATE FORCE
                                        })

                                .catch(() => {
                                    document.getElementById("sensorVoltage").value = "0.000";
                                });
                        }, 500); // 500 ms UI refresh
                    }

                    function stopVoltagePolling() {
                        if (voltageTimer) {
                            clearInterval(voltageTimer);
                            voltageTimer = null;
                        }
                    }
                                        function updateCalibratedValueLive() {

                                            const voltage = Number(document.getElementById("sensorVoltage").value);
                                            const minVolt = Number(document.getElementById("minVolt").value);
                                            const maxVolt = Number(document.getElementById("maxVolt").value);
                                            const minVal  = Number(document.getElementById("minValue").value);
                                            const maxVal  = Number(document.getElementById("maxValue").value);

                                            if (maxVolt === minVolt) return;
                                            if (isNaN(voltage)) return;

                                            const factor = (maxVal - minVal) / (maxVolt - minVolt);
                                            const offset = minVal - (minVolt * factor);
                                            const force  = (voltage * factor) + offset;

                                            document.getElementById("calibratedValue").value = force.toFixed(3);
                                        }


                    /* ===============================
                       LOADCELL SELECTION
                    ================================ */
                                        function selectLoadCell(code, name) {

                                            stopVoltagePolling();

                                            const input = document.getElementById("selectedItem");
                                            input.value = name;
                                            input.dataset.code = code;

                                            // 🔥 LOAD LAST CALIBRATION
                                            loadLastCalibration(code);

                                            // 🔥 START LIVE VOLTAGE
                                            startVoltagePolling();
                                        }


                    /* ===============================
                       PAGE LOAD → LOAD DROPDOWN
                    ================================ */
                    document.addEventListener("DOMContentLoaded", function () {

                        fetch('@Url.Action("GetLoadCells", "Calibration")')
                            .then(response => {
                                if (!response.ok)
                                    throw new Error("HTTP " + response.status);
                                return response.json();
                            })
                            .then(data => {
                                const dropdown = document.getElementById("loadcellDropdown");
                                dropdown.innerHTML = "";

                                if (!Array.isArray(data) || data.length === 0) {
                                    dropdown.innerHTML =
                                        `<li><span class="dropdown-item text-muted">No loadcells found</span></li>`;
                                    return;
                                }

                                data.forEach(lc => {
                                    const li = document.createElement("li");
                                    li.innerHTML = `
                                        <a class="dropdown-item"
                                           href="#"
                                           onclick="selectLoadCell('${lc.loadCellCode}', '${lc.loadCellName}')">
                                            ${lc.loadCellName}
                                        </a>`;
                                    dropdown.appendChild(li);
                                });
                            })
                            .catch(err => {
                                console.error("Loadcell API error:", err);
                                alert("Failed to load loadcells. Check server logs.");
                            });
                    });

                    /* ===============================
                       CALIBRATION CALCULATION
                    ================================ */
                    function calculateCalibration() {

                        const loadCellCode = document.getElementById("selectedItem")?.dataset.code;
                        if (!loadCellCode) {
                            alert("Please select Sensor Name");
                            return;
                        }

                        const minVolt = Number(document.getElementById("minVolt").value);
                        const maxVolt = Number(document.getElementById("maxVolt").value);
                        const minVal  = Number(document.getElementById("minValue").value);
                        const maxVal  = Number(document.getElementById("maxValue").value);
                        const voltage = Number(document.getElementById("sensorVoltage").value);

                        if (maxVolt === minVolt) {
                            alert("Min Volt and Max Volt cannot be same");
                            return;
                        }

                        const factor = (maxVal - minVal) / (maxVolt - minVolt);
                        const offset = minVal - (minVolt * factor);
                        const force  = (voltage * factor) + offset;

                        document.getElementById("factor").value = factor.toFixed(4);
                        document.getElementById("offset").value = offset.toFixed(4);
                        document.getElementById("calibratedValue").value = force.toFixed(3);

                        fetch('@Url.Action("SaveCalibration", "Calibration")', {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({
                                loadCellCode,
                                minVolt,
                                maxVolt,
                                minValue: minVal,
                                maxValue: maxVal,
                                factor,
                                offset
                            })
                        })
                        .then(res => res.json())
                        .then(() => alert("Calibration saved successfully"))
                        .catch(err => {
                            console.error(err);
                            alert("Error saving calibration");
                        });
                    }

                    /* ===============================
                       TAB VISIBILITY SAFETY (OPTIONAL)
                    ================================ */
                    document.addEventListener("visibilitychange", () => {
                        if (document.hidden) {
                            stopVoltagePolling();
                        }
                    });
                </script>



                <script>
                    function loadLastCalibration(loadCellCode) {

                        fetch(`/Calibration/GetLastCalibration?loadCellCode=${loadCellCode}`)
                            .then(r => {
                                if (!r.ok) return null; // no previous calibration
                                return r.json();
                            })
                            .then(d => {
                                if (!d) return;

                                // Populate calibration fields
                                document.getElementById("minVolt").value  = d.minVolt;
                                document.getElementById("maxVolt").value  = d.maxVolt;
                                document.getElementById("minValue").value = d.minValue;
                                document.getElementById("maxValue").value = d.maxValue;

                                document.getElementById("factor").value = Number(d.factor).toFixed(4);
                                document.getElementById("offset").value = Number(d.offset).toFixed(4);
                            })
                            .catch(err => console.error("Load calibration failed", err));
                    }
                </script>
                <script>
                    function updateCalibratedValueLive() {

                        const voltage = Number(document.getElementById("sensorVoltage").value);
                        const factor  = Number(document.getElementById("factor").value);
                        const offset  = Number(document.getElementById("offset").value);

                        if (isNaN(voltage) || isNaN(factor) || isNaN(offset))
                            return;

                        const force = (voltage * factor) + offset;

                        document.getElementById("calibratedValue").value =
                            force.toFixed(3);
                    }
                </script>
                <script>
                    /* ==========================================
                       SIGNALR : SERVO LIVE STATUS (FINAL – CLEAN)
                    ========================================== */

                    let servoHubConnection = new signalR.HubConnectionBuilder()
                        .withUrl("/servoHub")
                        .withAutomaticReconnect()
                        .build();

                    servoHubConnection.on(
                        "ServoStatusUpdated",
                        (servoCode, ready, alarm, torque) => {

                            console.log("SignalR:", servoCode, ready, alarm, torque);

                            document.querySelectorAll(".servo-card").forEach(card => {

                                const title = card.querySelector(".card-title");
                                if (!title) return;
                                if (title.dataset.servo !== servoCode) return;

                                /* ✅ ACTUAL TORQUE */
                                const torqueInput = card.querySelector(".act-torque");
                                if (torqueInput) {
                                    torqueInput.value = torque;
                                }

                                /* ✅ READY / ALARM */
                                const readyRadio = card.querySelector(".ready-radio");
                                const alarmRadio = card.querySelector(".alarm-radio");

                                if (readyRadio) readyRadio.checked = ready;
                                if (alarmRadio) alarmRadio.checked = alarm;
                            });
                        }
                    );

                    servoHubConnection.start()
                        .then(() => console.log("✅ Servo SignalR connected"))
                        .catch(err => console.error("❌ Servo SignalR failed", err));
                </script>
                <script>
                    /* ==========================================
                       SAVE + APPLY SERVO (PLC ➜ DB)
                    ========================================== */
                    function saveServoCalibration(btn) {

                        const card = btn.closest(".servo-card");
                        if (!card) return alert("Servo card not found");

                        const titleEl = card.querySelector(".card-title");
                        if (!titleEl || !titleEl.dataset.servo)
                            return alert("Servo mapping missing");

                        const servoCode = titleEl.dataset.servo;
                        const servoName = titleEl.innerText.trim();

                        const jogSpeed = Number(card.querySelector(".jog-speed")?.value ?? 0);
                        const setPos   = Number(card.querySelector(".set-pos")?.value ?? 0);
                        const setSpeed = Number(card.querySelector(".set-speed")?.value ?? 0);

                        fetch("/ServoCalibration/ApplySet", {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({
                                servoCode,
                                setPosition: setPos,
                                setSpeed,
                                jogSpeed
                            })
                        })
                        .then(r => {
                            if (!r.ok) throw new Error("PLC write failed");
                        })
                        .then(() => fetch("/ServoCalibration/SaveServoCalibration", {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({
                                servoCode,
                                servoName,
                                setPosition: setPos,
                                setSpeed,
                                jogSpeed
                            })
                        }))
                        .then(r => {
                            if (!r.ok) throw new Error("DB save failed");
                            alert("✅ Servo applied & saved");
                        })
                        .catch(err => {
                            console.error(err);
                            alert("❌ Servo apply/save failed");
                        });
                    }
                </script>
                <script>
                    /* ==========================================
                       SERVO COMMAND HELPERS
                    ========================================== */

                    function getServoCode(btn) {
                        const card = btn.closest(".servo-card");
                        return card?.querySelector(".card-title")?.dataset?.servo ?? null;
                    }

                    function sendServoCommand(url, servoCode) {
                        if (!servoCode) return alert("Servo mapping error");

                        fetch(`${url}?servoCode=${encodeURIComponent(servoCode)}`, {
                            method: "POST"
                        })
                        .then(r => {
                            if (!r.ok) throw new Error("PLC write failed");
                        })
                        .catch(err => {
                            console.error(err);
                            alert("PLC communication error");
                        });
                    }

                    function jogUp(btn)    { sendServoCommand("/ServoCalibration/JogUp",   getServoCode(btn)); }
                    function jogDown(btn)  { sendServoCommand("/ServoCalibration/JogDown", getServoCode(btn)); }
                    function runServo(btn) { sendServoCommand("/ServoCalibration/Run",     getServoCode(btn)); }
                    function stopServo(btn){ sendServoCommand("/ServoCalibration/Stop",    getServoCode(btn)); }
                </script>
                <script>
                    /* ==========================================
                       RESET SERVO UI
                    ========================================== */
                    function resetServoCalibration(btn) {

                        const card = btn.closest(".servo-card");
                        if (!card) return;

                        card.querySelector(".jog-speed").value = 0;
                        card.querySelector(".set-pos").value   = 0;
                        card.querySelector(".set-speed").value = 0;
                        card.querySelector(".set-value").value = 0;

                        card.querySelectorAll(".servo-radio")
                            .forEach(r => r.checked = false);

                        alert("Servo values reset");
                    }
                </script>
