# Copy to .env and fill in. Never commit .env.

# Where the app is running (dotnet run --project CompressionForce.Web --launch-profile https)
BASE_URL=https://localhost:7111

# An ACTIVE account that has already changed its first-login password
# (the seeded default admin is forced to change its password on first login,
#  so log in once by hand first). Use an Admin-group account to cover every page.
E2E_USER=admin
E2E_PASSWORD=change-me
